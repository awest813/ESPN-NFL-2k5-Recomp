+#if defined(CLOCK_MONOTONIC_RAW) && !defined(SDL_PLATFORM_EMSCRIPTEN)
 #define SDL_MONOTONIC_CLOCK CLOCK_MONOTONIC_RAW
 #else
 #define SDL_MONOTONIC_CLOCK CLOCK_MONOTONIC
