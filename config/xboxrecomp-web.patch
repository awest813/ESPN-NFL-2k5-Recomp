+def _flag_predecessors(blocks, start, indirect_targets):
+    """Ignore dead predecessors of reachable blocks, including table bytes.
+
+    Keep decoded blocks available for emission. Only flag inheritance uses
+    reachability. A reachable unresolved indirect jump makes the analysis
+    conservative again; a recovered switch contributes all its local edges.
+    """
+    by_start = {bb.start: bb for bb in blocks}
+    preds = {addr: set() for addr in by_start}
+    succ = {addr: set() for addr in by_start}
+    unknown = set()
+
+    def edge(source, target):
+        if target in by_start:
+            succ[source].add(target)
+            preds[target].add(source)
+
+    for bb in blocks:
+        last = bb.instructions[-1] if bb.instructions else None
+        if last is None:
+            continue
+        edge(bb.start, last.jump_target)
+        if last.mnemonic == 'jmp' and last.jump_target is None:
+            targets = indirect_targets.get(last.address)
+            if not targets:
+                unknown.add(bb.start)
+            else:
+                for target in targets:
+                    edge(bb.start, target)
+        leaves = last.is_ret or last.mnemonic in ('jmp', 'int3', 'ud2', 'hlt')
+        if not leaves:
+            edge(bb.start, last.end_address)
+
+    reachable = set()
+    pending = [start] if start in by_start else []
+    while pending:
+        addr = pending.pop()
+        if addr in reachable:
+            continue
+        if addr in unknown:
+            return preds
+        reachable.add(addr)
+        pending.extend(succ[addr] - reachable)
+    for addr in reachable:
+        preds[addr].intersection_update(reachable)
+    return preds


