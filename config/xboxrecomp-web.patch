diff --git a/src/kernel/sdlgpu/webgpu/sdl_gpu_webgpu.c b/src/kernel/sdlgpu/webgpu/sdl_gpu_webgpu.c
new file mode 100644
index 0000000..8e624ca
--- /dev/null
+++ b/src/kernel/sdlgpu/webgpu/sdl_gpu_webgpu.c
@@ -0,0 +1,1273 @@
+/* The SDL GPU renderer on WebGPU: the SDL_GPU subset it uses, on Dawn's
+ * webgpu.h. Design and threading: sdl_gpu_webgpu.h. */
+#ifdef __EMSCRIPTEN__
+#define SDL_GPU_WEBGPU_IMPLEMENTATION
+#include "sdl_gpu_webgpu.h"
+
+#include <emscripten/em_js.h>
+#include <emscripten/emscripten.h>
+#include <emscripten/html5.h>
+#include <emscripten/proxying.h>
+#include <emscripten/threading.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <webgpu/webgpu.h>
+
+/* OFFSCREENCANVAS_SUPPORT (the presentation canvas) needs Emscripten's GL
+ * object even though nothing here uses WebGL. */
+EM_JS_DEPS(sdl_gpu_webgpu, "$GL");
+
+#define WG_VS_UNIFORM_BYTES 4096u   /* binding size of vertex uniforms (group 1) */
+#define WG_FS_UNIFORM_BYTES 1024u   /* binding size of fragment uniforms (group 3) */
+#define WG_UNIFORM_ALIGN    256u    /* minUniformBufferOffsetAlignment */
+#define WG_MAX_SAMPLERS     4u      /* texture i at binding i, its sampler at 4 + i */
+
+/* ── Objects ──────────────────────────────────────────────────────────────
+ * Each SDL handle is one of these, owned by the caller; the WebGPU handles in
+ * it are only touched on the server thread. */
+struct SDL_GPUDevice { int unused; };
+struct SDL_GPUTexture {
+    WGPUTexture tex;
+    WGPUTextureView view;         /* all levels: sampling */
+    WGPUTextureView *level_views; /* one per level: render targets, mip generation */
+    WGPUTextureFormat format;
+    uint32_t w, h, levels;
+    int swapchain;                /* the canvas's current texture, resolved at replay */
+};
+struct SDL_GPUBuffer { WGPUBuffer buf; uint32_t size; };
+struct SDL_GPUTransferBuffer { uint8_t *mem; uint32_t size; };
+struct SDL_GPUSampler { WGPUSampler s; };
+struct SDL_GPUShader { WGPUShaderModule mod; SDL_GPUShaderStage stage; };
+struct SDL_GPUGraphicsPipeline { WGPURenderPipeline pipe; };
+struct SDL_GPUFence { int unused; };
+
+/* Recorded commands, replayed on the server at submit. */
+typedef enum {
+    OP_UPLOAD_BUFFER, OP_UPLOAD_TEXTURE, OP_DOWNLOAD_TEXTURE, OP_COPY_TEXTURE,
+    OP_MIPMAPS, OP_BLIT, OP_BEGIN_PASS, OP_END_PASS, OP_VIEWPORT, OP_SCISSOR,
+    OP_BLEND_CONSTANT, OP_STENCIL_REF, OP_PIPELINE, OP_VERTEX_BUFFER,
+    OP_INDEX_BUFFER, OP_SAMPLERS, OP_UNIFORM, OP_DRAW, OP_DRAW_INDEXED,
+} OpKind;
+
+typedef struct {
+    OpKind kind;
+    union {
+        struct { SDL_GPUTransferBuffer *src; uint32_t src_off; SDL_GPUBuffer *dst; uint32_t dst_off, size; } ub;
+        struct { SDL_GPUTransferBuffer *src; uint32_t src_off, row_px, rows; SDL_GPUTexture *dst;
+                 uint32_t level, x, y, w, h; } ut;
+        struct { SDL_GPUTexture *src; uint32_t level, x, y, w, h; SDL_GPUTransferBuffer *dst;
+                 uint32_t dst_off, row_px; } dt;
+        struct { SDL_GPUTexture *src, *dst; uint32_t sl, sx, sy, dl, dx, dy, w, h; } ct;
+        struct { SDL_GPUTexture *tex; } mip;
+        struct { SDL_GPUTexture *src, *dst; uint32_t dx, dy, dw, dh; int linear, clear; SDL_FColor clear_color; } blit;
+        struct { SDL_GPUColorTargetInfo color; int has_color; SDL_GPUDepthStencilTargetInfo depth; int has_depth; } pass;
+        SDL_GPUViewport viewport;
+        SDL_Rect scissor;
+        SDL_FColor blend;
+        uint8_t stencil_ref;
+        SDL_GPUGraphicsPipeline *pipeline;
+        struct { SDL_GPUBuffer *buf; uint32_t off; } vb;
+        struct { SDL_GPUTexture *tex[WG_MAX_SAMPLERS]; SDL_GPUSampler *smp[WG_MAX_SAMPLERS]; uint32_t first, n; } samplers;
+        struct { int fragment; uint32_t off; } uniform;
+        struct { uint32_t count, instances, first, first_instance; int32_t vertex_offset; } draw;
+    };
+} Op;
+
+struct SDL_GPUCommandBuffer {
+    Op *ops; uint32_t n, cap;
+    uint8_t *uniforms; uint32_t ubytes, ucap;   /* pushed uniform data, 256-aligned */
+    int has_download;
+};
+
+static WGPUInstance s_inst;
+static WGPUAdapter s_adapter;
+static WGPUDevice s_dev;
+static WGPUQueue s_queue;
+static WGPUSurface s_surface;
+static WGPUTextureFormat s_surface_format;
+static uint32_t s_surface_w, s_surface_h;
+static int s_has_d32s8, s_has_depth_clip;
+static pthread_t s_server;
+static atomic_int s_available;
+static struct SDL_GPUDevice s_device_obj;
+static struct SDL_GPUFence s_fence_obj;
+static char s_canvas_selector[64];
+
+/* Shared binding layout of every pipeline (SDL's set convention). */
+static WGPUBindGroupLayout s_bgl[4];
+static WGPUPipelineLayout s_layout;
+static WGPUTexture s_dummy_tex;
+static WGPUTextureView s_dummy_view;
+static WGPUSampler s_dummy_sampler, s_linear_sampler, s_nearest_sampler;
+static WGPUShaderModule s_blit_module;
+
+/* ── Proxying ─────────────────────────────────────────────────────────── */
+static em_proxying_queue *q(void) { return emscripten_proxy_get_system_queue(); }
+
+static void run_sync(void (*fn)(void *), void *arg)
+{
+    if (pthread_equal(pthread_self(), s_server)) fn(arg);
+    else emscripten_proxy_sync(q(), s_server, fn, arg);
+}
+static void run_sync_ctx(void (*fn)(em_proxying_ctx *, void *), void *arg)
+{
+    emscripten_proxy_sync_with_ctx(q(), s_server, fn, arg);
+}
+
+static WGPUStringView sv(const char *s) { WGPUStringView v = { s, WGPU_STRLEN }; return v; }
+
+static void report(const char *what, WGPUStringView msg)
+{
+    static int told;
+    if (told++ < 20)
+        fprintf(stderr, "  [WebGPU] %s: %.*s\n", what, (int)msg.length, msg.data ? msg.data : "");
+}
+
+/* ── Server thread and device ────────────────────────────────────────── */
+static void *server_main(void *arg)
+{
+    (void)arg;
+    emscripten_exit_with_live_runtime();   /* serve proxied calls from the event loop */
+    return NULL;
+}
+
+static void on_error(WGPUDevice const *d, WGPUErrorType type, WGPUStringView msg, void *u1, void *u2)
+{
+    (void)d; (void)u1; (void)u2;
+    char what[32];
+    snprintf(what, sizeof what, "device error %d", (int)type);
+    report(what, msg);
+}
+
+static void on_lost(WGPUDevice const *d, WGPUDeviceLostReason r, WGPUStringView msg, void *u1, void *u2)
+{
+    (void)d; (void)u1; (void)u2;
+    if (r != WGPUDeviceLostReason_Destroyed) report("device lost", msg);
+}
+
+static WGPUBindGroupLayout make_bgl(const WGPUBindGroupLayoutEntry *e, size_t n)
+{
+    WGPUBindGroupLayoutDescriptor d = { .entryCount = n, .entries = e };
+    return wgpuDeviceCreateBindGroupLayout(s_dev, &d);
+}
+
+/* Fullscreen triangle sampling binding 0/1 of group 0: blits and mipmaps. */
+static const char k_blit_wgsl[] =
+    "struct V { @builtin(position) pos: vec4f, @location(0) uv: vec2f }\n"
+    "@vertex fn vs(@builtin(vertex_index) i: u32) -> V {\n"
+    "  let uv = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n"
+    "  return V(vec4f(uv * vec2f(2.0, -2.0) + vec2f(-1.0, 1.0), 0.0, 1.0), uv);\n"
+    "}\n"
+    "@group(0) @binding(0) var t: texture_2d<f32>;\n"
+    "@group(0) @binding(1) var s: sampler;\n"
+    "@fragment fn fs(v: V) -> @location(0) vec4f { return textureSampleLevel(t, s, v.uv, 0.0); }\n";
+
+static void create_fixed_objects(void)
+{
+    WGPUBindGroupLayoutEntry vs_u = { .binding = 0, .visibility = WGPUShaderStage_Vertex,
+        .buffer = { .type = WGPUBufferBindingType_Uniform, .hasDynamicOffset = 1 } };
+    WGPUBindGroupLayoutEntry fs_u = { .binding = 0, .visibility = WGPUShaderStage_Fragment,
+        .buffer = { .type = WGPUBufferBindingType_Uniform, .hasDynamicOffset = 1 } };
+    WGPUBindGroupLayoutEntry tex[2 * WG_MAX_SAMPLERS];
+    for (uint32_t i = 0; i < WG_MAX_SAMPLERS; i++) {
+        tex[i] = (WGPUBindGroupLayoutEntry){ .binding = i, .visibility = WGPUShaderStage_Fragment,
+            .texture = { .sampleType = WGPUTextureSampleType_Float, .viewDimension = WGPUTextureViewDimension_2D } };
+        tex[WG_MAX_SAMPLERS + i] = (WGPUBindGroupLayoutEntry){ .binding = WG_MAX_SAMPLERS + i,
+            .visibility = WGPUShaderStage_Fragment, .sampler = { .type = WGPUSamplerBindingType_Filtering } };
+    }
+    s_bgl[0] = make_bgl(NULL, 0);
+    s_bgl[1] = make_bgl(&vs_u, 1);
+    s_bgl[2] = make_bgl(tex, 2 * WG_MAX_SAMPLERS);
+    s_bgl[3] = make_bgl(&fs_u, 1);
+    WGPUPipelineLayoutDescriptor pl = { .bindGroupLayoutCount = 4, .bindGroupLayouts = s_bgl };
+    s_layout = wgpuDeviceCreatePipelineLayout(s_dev, &pl);
+
+    WGPUTextureDescriptor td = { .usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst,
+        .dimension = WGPUTextureDimension_2D, .size = { 1, 1, 1 }, .format = WGPUTextureFormat_RGBA8Unorm,
+        .mipLevelCount = 1, .sampleCount = 1 };
+    s_dummy_tex = wgpuDeviceCreateTexture(s_dev, &td);
+    s_dummy_view = wgpuTextureCreateView(s_dummy_tex, NULL);
+    WGPUSamplerDescriptor sd = { .addressModeU = WGPUAddressMode_ClampToEdge, .addressModeV = WGPUAddressMode_ClampToEdge,
+        .addressModeW = WGPUAddressMode_ClampToEdge, .magFilter = WGPUFilterMode_Nearest,
+        .minFilter = WGPUFilterMode_Nearest, .mipmapFilter = WGPUMipmapFilterMode_Nearest,
+        .lodMinClamp = 0, .lodMaxClamp = 32, .maxAnisotropy = 1 };
+    s_dummy_sampler = s_nearest_sampler = wgpuDeviceCreateSampler(s_dev, &sd);
+    sd.magFilter = sd.minFilter = WGPUFilterMode_Linear;
+    s_linear_sampler = wgpuDeviceCreateSampler(s_dev, &sd);
+
+    WGPUShaderSourceWGSL src = { .chain = { .sType = WGPUSType_ShaderSourceWGSL }, .code = sv(k_blit_wgsl) };
+    WGPUShaderModuleDescriptor md = { .nextInChain = &src.chain };
+    s_blit_module = wgpuDeviceCreateShaderModule(s_dev, &md);
+}
+
+static em_proxying_ctx *s_init_ctx;
+
+static void on_device(WGPURequestDeviceStatus st, WGPUDevice d, WGPUStringView msg, void *u1, void *u2)
+{
+    (void)u1; (void)u2;
+    if (st != WGPURequestDeviceStatus_Success) {
+        report("no device", msg);
+        emscripten_proxy_finish(s_init_ctx);
+        return;
+    }
+    s_dev = d;
+    s_queue = wgpuDeviceGetQueue(d);
+    create_fixed_objects();
+
+    WGPUEmscriptenSurfaceSourceCanvasHTMLSelector sel = {
+        .chain = { .sType = WGPUSType_EmscriptenSurfaceSourceCanvasHTMLSelector },
+        .selector = sv(s_canvas_selector) };
+    WGPUSurfaceDescriptor sdesc = { .nextInChain = &sel.chain };
+    s_surface = wgpuInstanceCreateSurface(s_inst, &sdesc);
+    if (s_surface) {
+        WGPUSurfaceCapabilities caps = {0};
+        wgpuSurfaceGetCapabilities(s_surface, s_adapter, &caps);
+        s_surface_format = caps.formatCount ? caps.formats[0] : WGPUTextureFormat_BGRA8Unorm;
+    }
+    atomic_store(&s_available, 1);
+    emscripten_proxy_finish(s_init_ctx);
+}
+
+static void on_adapter(WGPURequestAdapterStatus st, WGPUAdapter a, WGPUStringView msg, void *u1, void *u2)
+{
+    (void)u1; (void)u2;
+    if (st != WGPURequestAdapterStatus_Success || !a) {
+        report("no adapter", msg);
+        emscripten_proxy_finish(s_init_ctx);
+        return;
+    }
+    s_adapter = a;
+    WGPUFeatureName want[2];
+    size_t n = 0;
+    if ((s_has_d32s8 = wgpuAdapterHasFeature(a, WGPUFeatureName_Depth32FloatStencil8)))
+        want[n++] = WGPUFeatureName_Depth32FloatStencil8;
+    if ((s_has_depth_clip = wgpuAdapterHasFeature(a, WGPUFeatureName_DepthClipControl)))
+        want[n++] = WGPUFeatureName_DepthClipControl;
+    WGPUDeviceDescriptor dd = {
+        .requiredFeatureCount = n, .requiredFeatures = want,
+        .deviceLostCallbackInfo = { .mode = WGPUCallbackMode_AllowSpontaneous, .callback = on_lost },
+        .uncapturedErrorCallbackInfo = { .callback = on_error },
+    };
+    WGPURequestDeviceCallbackInfo ci = { .mode = WGPUCallbackMode_AllowSpontaneous, .callback = on_device };
+    wgpuAdapterRequestDevice(a, &dd, ci);
+}
+
+static void do_init(em_proxying_ctx *ctx, void *arg)
+{
+    (void)arg;
+    s_init_ctx = ctx;
+    if (!EM_ASM_INT({ return !!(typeof navigator !== 'undefined' && navigator.gpu); })) {
+        fprintf(stderr, "  [WebGPU] not available in this browser\n");
+        emscripten_proxy_finish(ctx);
+        return;
+    }
+    s_inst = wgpuCreateInstance(NULL);
+    WGPURequestAdapterOptions opt = { .powerPreference = WGPUPowerPreference_HighPerformance };
+    WGPURequestAdapterCallbackInfo ci = { .mode = WGPUCallbackMode_AllowSpontaneous, .callback = on_adapter };
+    wgpuInstanceRequestAdapter(s_inst, &opt, ci);
+}
+
+int wg_server_start(const char *canvas_id)
+{
+    pthread_attr_t at;
+    if (atomic_load(&s_available))
+        return 1;
+    snprintf(s_canvas_selector, sizeof s_canvas_selector, "#%s", canvas_id);
+    pthread_attr_init(&at);
+    /* The bare id: how a thread keys a canvas it holds (GL.offscreenCanvases). */
+    emscripten_pthread_attr_settransferredcanvases(&at, canvas_id);
+    if (pthread_create(&s_server, &at, server_main, NULL) != 0) {
+        fprintf(stderr, "  [WebGPU] cannot start the GPU thread (is #%s on the page?)\n", canvas_id);
+        return 0;
+    }
+    run_sync_ctx(do_init, NULL);
+    if (atomic_load(&s_available))
+        fprintf(stderr, "  [WebGPU] device ready (depth32float-stencil8 %s, surface format %d)\n",
+                s_has_d32s8 ? "yes" : "no", (int)s_surface_format);
+    return atomic_load(&s_available);
+}
+
+int wg_available(void) { return atomic_load(&s_available); }
+
+/* ── Enum translation ─────────────────────────────────────────────────── */
+static WGPUTextureFormat tex_format(SDL_GPUTextureFormat f)
+{
+    switch (f) {
+    case SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM: return WGPUTextureFormat_BGRA8Unorm;
+    case SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM: return WGPUTextureFormat_RGBA8Unorm;
+    case SDL_GPU_TEXTUREFORMAT_D32_FLOAT_S8_UINT: return WGPUTextureFormat_Depth32FloatStencil8;
+    case SDL_GPU_TEXTUREFORMAT_D24_UNORM_S8_UINT: return WGPUTextureFormat_Depth24PlusStencil8;
+    case SDL_GPU_TEXTUREFORMAT_D32_FLOAT: return WGPUTextureFormat_Depth32Float;
+    case SDL_GPU_TEXTUREFORMAT_D16_UNORM: return WGPUTextureFormat_Depth16Unorm;
+    default: return WGPUTextureFormat_Undefined;
+    }
+}
+static int is_depth(WGPUTextureFormat f)
+{
+    return f == WGPUTextureFormat_Depth32FloatStencil8 || f == WGPUTextureFormat_Depth24PlusStencil8 ||
+           f == WGPUTextureFormat_Depth32Float || f == WGPUTextureFormat_Depth16Unorm;
+}
+static int has_stencil(WGPUTextureFormat f)
+{
+    return f == WGPUTextureFormat_Depth32FloatStencil8 || f == WGPUTextureFormat_Depth24PlusStencil8;
+}
+static WGPUBlendFactor blend_factor(SDL_GPUBlendFactor f)
+{
+    switch (f) {
+    case SDL_GPU_BLENDFACTOR_ZERO: return WGPUBlendFactor_Zero;
+    case SDL_GPU_BLENDFACTOR_ONE: return WGPUBlendFactor_One;
+    case SDL_GPU_BLENDFACTOR_SRC_COLOR: return WGPUBlendFactor_Src;
+    case SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_COLOR: return WGPUBlendFactor_OneMinusSrc;
+    case SDL_GPU_BLENDFACTOR_DST_COLOR: return WGPUBlendFactor_Dst;
+    case SDL_GPU_BLENDFACTOR_ONE_MINUS_DST_COLOR: return WGPUBlendFactor_OneMinusDst;
+    case SDL_GPU_BLENDFACTOR_SRC_ALPHA: return WGPUBlendFactor_SrcAlpha;
+    case SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA: return WGPUBlendFactor_OneMinusSrcAlpha;
+    case SDL_GPU_BLENDFACTOR_DST_ALPHA: return WGPUBlendFactor_DstAlpha;
+    case SDL_GPU_BLENDFACTOR_ONE_MINUS_DST_ALPHA: return WGPUBlendFactor_OneMinusDstAlpha;
+    case SDL_GPU_BLENDFACTOR_CONSTANT_COLOR: return WGPUBlendFactor_Constant;
+    case SDL_GPU_BLENDFACTOR_ONE_MINUS_CONSTANT_COLOR: return WGPUBlendFactor_OneMinusConstant;
+    case SDL_GPU_BLENDFACTOR_SRC_ALPHA_SATURATE: return WGPUBlendFactor_SrcAlphaSaturated;
+    default: return WGPUBlendFactor_One;
+    }
+}
+static WGPUBlendOperation blend_op(SDL_GPUBlendOp o)
+{
+    switch (o) {
+    case SDL_GPU_BLENDOP_SUBTRACT: return WGPUBlendOperation_Subtract;
+    case SDL_GPU_BLENDOP_REVERSE_SUBTRACT: return WGPUBlendOperation_ReverseSubtract;
+    case SDL_GPU_BLENDOP_MIN: return WGPUBlendOperation_Min;
+    case SDL_GPU_BLENDOP_MAX: return WGPUBlendOperation_Max;
+    default: return WGPUBlendOperation_Add;
+    }
+}
+static WGPUCompareFunction compare(SDL_GPUCompareOp c)
+{
+    switch (c) {
+    case SDL_GPU_COMPAREOP_NEVER: return WGPUCompareFunction_Never;
+    case SDL_GPU_COMPAREOP_LESS: return WGPUCompareFunction_Less;
+    case SDL_GPU_COMPAREOP_EQUAL: return WGPUCompareFunction_Equal;
+    case SDL_GPU_COMPAREOP_LESS_OR_EQUAL: return WGPUCompareFunction_LessEqual;
+    case SDL_GPU_COMPAREOP_GREATER: return WGPUCompareFunction_Greater;
+    case SDL_GPU_COMPAREOP_NOT_EQUAL: return WGPUCompareFunction_NotEqual;
+    case SDL_GPU_COMPAREOP_GREATER_OR_EQUAL: return WGPUCompareFunction_GreaterEqual;
+    default: return WGPUCompareFunction_Always;
+    }
+}
+static WGPUStencilOperation stencil_op(SDL_GPUStencilOp o)
+{
+    switch (o) {
+    case SDL_GPU_STENCILOP_ZERO: return WGPUStencilOperation_Zero;
+    case SDL_GPU_STENCILOP_REPLACE: return WGPUStencilOperation_Replace;
+    case SDL_GPU_STENCILOP_INCREMENT_AND_CLAMP: return WGPUStencilOperation_IncrementClamp;
+    case SDL_GPU_STENCILOP_DECREMENT_AND_CLAMP: return WGPUStencilOperation_DecrementClamp;
+    case SDL_GPU_STENCILOP_INVERT: return WGPUStencilOperation_Invert;
+    case SDL_GPU_STENCILOP_INCREMENT_AND_WRAP: return WGPUStencilOperation_IncrementWrap;
+    case SDL_GPU_STENCILOP_DECREMENT_AND_WRAP: return WGPUStencilOperation_DecrementWrap;
+    default: return WGPUStencilOperation_Keep;
+    }
+}
+static WGPUAddressMode address(SDL_GPUSamplerAddressMode m)
+{
+    switch (m) {
+    case SDL_GPU_SAMPLERADDRESSMODE_REPEAT: return WGPUAddressMode_Repeat;
+    case SDL_GPU_SAMPLERADDRESSMODE_MIRRORED_REPEAT: return WGPUAddressMode_MirrorRepeat;
+    default: return WGPUAddressMode_ClampToEdge;
+    }
+}
+static WGPUVertexFormat vertex_format(SDL_GPUVertexElementFormat f)
+{
+    switch (f) {
+    case SDL_GPU_VERTEXELEMENTFORMAT_FLOAT: return WGPUVertexFormat_Float32;
+    case SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2: return WGPUVertexFormat_Float32x2;
+    case SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3: return WGPUVertexFormat_Float32x3;
+    case SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4: return WGPUVertexFormat_Float32x4;
+    case SDL_GPU_VERTEXELEMENTFORMAT_UBYTE4_NORM: return WGPUVertexFormat_Unorm8x4;
+    default: return WGPUVertexFormat_Float32x4;
+    }
+}
+static WGPULoadOp load_op(SDL_GPULoadOp o) { return o == SDL_GPU_LOADOP_LOAD ? WGPULoadOp_Load : WGPULoadOp_Clear; }
+static WGPUStoreOp store_op(SDL_GPUStoreOp o) { return o == SDL_GPU_STOREOP_STORE ? WGPUStoreOp_Store : WGPUStoreOp_Discard; }
+
+/* ── Device ───────────────────────────────────────────────────────────── */
+SDL_GPUDevice *WG_CreateGPUDevice(SDL_GPUShaderFormat formats, bool debug, const char *name)
+{
+    (void)debug; (void)name;
+    if (!atomic_load(&s_available)) { SDL_SetError("WebGPU is not available"); return NULL; }
+    if (!(formats & SDL_GPU_SHADERFORMAT_WGSL)) { SDL_SetError("WebGPU takes WGSL shaders"); return NULL; }
+    return &s_device_obj;
+}
+void WG_DestroyGPUDevice(SDL_GPUDevice *d) { (void)d; }
+const char *WG_GetGPUDeviceDriver(SDL_GPUDevice *d) { (void)d; return "webgpu"; }
+bool WG_GPUTextureSupportsFormat(SDL_GPUDevice *d, SDL_GPUTextureFormat f, SDL_GPUTextureType t, SDL_GPUTextureUsageFlags u)
+{
+    (void)d; (void)t; (void)u;
+    WGPUTextureFormat w = tex_format(f);
+    if (w == WGPUTextureFormat_Depth32FloatStencil8) return s_has_d32s8;
+    return w != WGPUTextureFormat_Undefined;
+}
+
+/* ── Textures ─────────────────────────────────────────────────────────── */
+typedef struct { const SDL_GPUTextureCreateInfo *info; SDL_GPUTexture *out; } TexArgs;
+
+static void do_create_texture(void *p)
+{
+    TexArgs *a = (TexArgs *)p;
+    const SDL_GPUTextureCreateInfo *i = a->info;
+    SDL_GPUTexture *t = (SDL_GPUTexture *)calloc(1, sizeof *t);
+    WGPUTextureUsage usage = 0;
+    t->format = tex_format(i->format);
+    t->w = i->width; t->h = i->height; t->levels = i->num_levels ? i->num_levels : 1;
+    if (i->usage & SDL_GPU_TEXTUREUSAGE_SAMPLER) usage |= WGPUTextureUsage_TextureBinding;
+    if (i->usage & (SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET))
+        usage |= WGPUTextureUsage_RenderAttachment;
+    if (!is_depth(t->format))
+        usage |= WGPUTextureUsage_CopySrc | WGPUTextureUsage_CopyDst;  /* uploads, downloads, copies */
+    if (t->levels > 1)
+        usage |= WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding;  /* mip generation */
+    WGPUTextureDescriptor d = { .usage = usage, .dimension = WGPUTextureDimension_2D,
+        .size = { t->w, t->h, 1 }, .format = t->format, .mipLevelCount = t->levels, .sampleCount = 1 };
+    t->tex = wgpuDeviceCreateTexture(s_dev, &d);
+    if (!t->tex || t->format == WGPUTextureFormat_Undefined) { free(t); return; }
+    if (usage & WGPUTextureUsage_TextureBinding)
+        t->view = wgpuTextureCreateView(t->tex, NULL);
+    t->level_views = (WGPUTextureView *)calloc(t->levels, sizeof *t->level_views);
+    for (uint32_t l = 0; l < t->levels; l++) {
+        WGPUTextureViewDescriptor vd = { .format = t->format, .dimension = WGPUTextureViewDimension_2D,
+            .baseMipLevel = l, .mipLevelCount = 1, .baseArrayLayer = 0, .arrayLayerCount = 1,
+            .aspect = WGPUTextureAspect_All };
+        t->level_views[l] = wgpuTextureCreateView(t->tex, &vd);
+    }
+    a->out = t;
+}
+
+SDL_GPUTexture *WG_CreateGPUTexture(SDL_GPUDevice *d, const SDL_GPUTextureCreateInfo *i)
+{
+    (void)d;
+    TexArgs a = { i, NULL };
+    if (tex_format(i->format) == WGPUTextureFormat_Undefined) { SDL_SetError("texture format not supported on WebGPU"); return NULL; }
+    run_sync(do_create_texture, &a);
+    if (!a.out) SDL_SetError("WebGPU texture creation failed");
+    return a.out;
+}
+
+static void do_release_texture(void *p)
+{
+    SDL_GPUTexture *t = (SDL_GPUTexture *)p;
+    for (uint32_t l = 0; l < t->levels; l++) if (t->level_views[l]) wgpuTextureViewRelease(t->level_views[l]);
+    free(t->level_views);
+    if (t->view) wgpuTextureViewRelease(t->view);
+    if (t->tex) wgpuTextureRelease(t->tex);
+    free(t);
+}
+void WG_ReleaseGPUTexture(SDL_GPUDevice *d, SDL_GPUTexture *t)
+{
+    (void)d;
+    if (t && !t->swapchain) emscripten_proxy_async(q(), s_server, do_release_texture, t);
+}
+
+/* ── Buffers ──────────────────────────────────────────────────────────── */
+typedef struct { const SDL_GPUBufferCreateInfo *info; SDL_GPUBuffer *out; } BufArgs;
+static void do_create_buffer(void *p)
+{
+    BufArgs *a = (BufArgs *)p;
+    WGPUBufferUsage u = WGPUBufferUsage_CopyDst;
+    if (a->info->usage & SDL_GPU_BUFFERUSAGE_VERTEX) u |= WGPUBufferUsage_Vertex;
+    if (a->info->usage & SDL_GPU_BUFFERUSAGE_INDEX) u |= WGPUBufferUsage_Index;
+    SDL_GPUBuffer *b = (SDL_GPUBuffer *)calloc(1, sizeof *b);
+    b->size = (a->info->size + 3u) & ~3u;
+    WGPUBufferDescriptor d = { .usage = u, .size = b->size };
+    b->buf = wgpuDeviceCreateBuffer(s_dev, &d);
+    if (!b->buf) { free(b); return; }
+    a->out = b;
+}
+SDL_GPUBuffer *WG_CreateGPUBuffer(SDL_GPUDevice *d, const SDL_GPUBufferCreateInfo *i)
+{
+    (void)d;
+    BufArgs a = { i, NULL };
+    run_sync(do_create_buffer, &a);
+    return a.out;
+}
+static void do_release_buffer(void *p) { SDL_GPUBuffer *b = (SDL_GPUBuffer *)p; wgpuBufferRelease(b->buf); free(b); }
+void WG_ReleaseGPUBuffer(SDL_GPUDevice *d, SDL_GPUBuffer *b)
+{
+    (void)d;
+    if (b) emscripten_proxy_async(q(), s_server, do_release_buffer, b);
+}
+
+/* Transfer buffers are plain memory: the server copies out of (or into) them
+ * during the synchronous submit, so they need no WebGPU object. */
+SDL_GPUTransferBuffer *WG_CreateGPUTransferBuffer(SDL_GPUDevice *d, const SDL_GPUTransferBufferCreateInfo *i)
+{
+    (void)d;
+    SDL_GPUTransferBuffer *t = (SDL_GPUTransferBuffer *)calloc(1, sizeof *t);
+    if (!t) return NULL;
+    t->size = i->size;
+    t->mem = (uint8_t *)malloc(i->size ? i->size : 1);
+    if (!t->mem) { free(t); return NULL; }
+    return t;
+}
+void WG_ReleaseGPUTransferBuffer(SDL_GPUDevice *d, SDL_GPUTransferBuffer *t) { (void)d; if (t) { free(t->mem); free(t); } }
+void *WG_MapGPUTransferBuffer(SDL_GPUDevice *d, SDL_GPUTransferBuffer *t, bool cycle) { (void)d; (void)cycle; return t ? t->mem : NULL; }
+void WG_UnmapGPUTransferBuffer(SDL_GPUDevice *d, SDL_GPUTransferBuffer *t) { (void)d; (void)t; }
+
+/* ── Samplers and shaders ─────────────────────────────────────────────── */
+typedef struct { const SDL_GPUSamplerCreateInfo *info; SDL_GPUSampler *out; } SmpArgs;
+static void do_create_sampler(void *p)
+{
+    SmpArgs *a = (SmpArgs *)p;
+    const SDL_GPUSamplerCreateInfo *i = a->info;
+    int lin_min = i->min_filter == SDL_GPU_FILTER_LINEAR, lin_mag = i->mag_filter == SDL_GPU_FILTER_LINEAR;
+    int lin_mip = i->mipmap_mode == SDL_GPU_SAMPLERMIPMAPMODE_LINEAR;
+    WGPUSamplerDescriptor d = {
+        .addressModeU = address(i->address_mode_u), .addressModeV = address(i->address_mode_v),
+        .addressModeW = address(i->address_mode_w),
+        .magFilter = lin_mag ? WGPUFilterMode_Linear : WGPUFilterMode_Nearest,
+        .minFilter = lin_min ? WGPUFilterMode_Linear : WGPUFilterMode_Nearest,
+        .mipmapFilter = lin_mip ? WGPUMipmapFilterMode_Linear : WGPUMipmapFilterMode_Nearest,
+        .lodMinClamp = i->min_lod, .lodMaxClamp = i->max_lod > 32.0f ? 32.0f : i->max_lod,
+        /* WebGPU allows anisotropy only with every filter linear. */
+        .maxAnisotropy = (i->enable_anisotropy && lin_min && lin_mag && lin_mip)
+                         ? (uint16_t)(i->max_anisotropy < 1 ? 1 : i->max_anisotropy > 16 ? 16 : i->max_anisotropy) : 1,
+    };
+    SDL_GPUSampler *s = (SDL_GPUSampler *)calloc(1, sizeof *s);
+    s->s = wgpuDeviceCreateSampler(s_dev, &d);
+    if (!s->s) { free(s); return; }
+    a->out = s;
+}
+SDL_GPUSampler *WG_CreateGPUSampler(SDL_GPUDevice *d, const SDL_GPUSamplerCreateInfo *i)
+{
+    (void)d;
+    SmpArgs a = { i, NULL };
+    run_sync(do_create_sampler, &a);
+    return a.out;
+}
+
+typedef struct { const SDL_GPUShaderCreateInfo *info; SDL_GPUShader *out; } ShArgs;
+static void do_create_shader(void *p)
+{
+    ShArgs *a = (ShArgs *)p;
+    /* WGSL source, NUL-terminated or not: copy it to terminate it. */
+    char *code = (char *)malloc(a->info->code_size + 1);
+    memcpy(code, a->info->code, a->info->code_size);
+    code[a->info->code_size] = 0;
+    WGPUShaderSourceWGSL src = { .chain = { .sType = WGPUSType_ShaderSourceWGSL }, .code = sv(code) };
+    WGPUShaderModuleDescriptor md = { .nextInChain = &src.chain };
+    WGPUShaderModule m = wgpuDeviceCreateShaderModule(s_dev, &md);
+    free(code);
+    if (!m) return;
+    SDL_GPUShader *s = (SDL_GPUShader *)calloc(1, sizeof *s);
+    s->mod = m;
+    s->stage = a->info->stage;
+    a->out = s;
+}
+SDL_GPUShader *WG_CreateGPUShader(SDL_GPUDevice *d, const SDL_GPUShaderCreateInfo *i)
+{
+    (void)d;
+    if (i->format != SDL_GPU_SHADERFORMAT_WGSL) { SDL_SetError("WebGPU takes WGSL shaders"); return NULL; }
+    ShArgs a = { i, NULL };
+    run_sync(do_create_shader, &a);
+    return a.out;
+}
+
+/* ── Pipelines ────────────────────────────────────────────────────────── */
+typedef struct { const SDL_GPUGraphicsPipelineCreateInfo *info; SDL_GPUGraphicsPipeline *out; } PipeArgs;
+static void do_create_pipeline(void *p)
+{
+    PipeArgs *a = (PipeArgs *)p;
+    const SDL_GPUGraphicsPipelineCreateInfo *i = a->info;
+    WGPUVertexAttribute attrs[16];
+    WGPUVertexBufferLayout vbl[4];
+    uint32_t nb = i->vertex_input_state.num_vertex_buffers > 4 ? 4 : i->vertex_input_state.num_vertex_buffers;
+    uint32_t na = i->vertex_input_state.num_vertex_attributes > 16 ? 16 : i->vertex_input_state.num_vertex_attributes;
+    uint32_t b, k;
+
+    for (b = 0; b < nb; b++) {
+        const SDL_GPUVertexBufferDescription *d = &i->vertex_input_state.vertex_buffer_descriptions[b];
+        uint32_t first = 0, count = 0;
+        /* Attributes are grouped per buffer slot: gather this slot's. */
+        for (k = 0; k < na; k++) {
+            const SDL_GPUVertexAttribute *va = &i->vertex_input_state.vertex_attributes[k];
+            if (va->buffer_slot != d->slot) continue;
+            if (!count) first = k;
+            attrs[k] = (WGPUVertexAttribute){ .format = vertex_format(va->format), .offset = va->offset,
+                                              .shaderLocation = va->location };
+            count++;
+        }
+        vbl[b] = (WGPUVertexBufferLayout){ .stepMode = WGPUVertexStepMode_Vertex, .arrayStride = d->pitch,
+                                           .attributeCount = count, .attributes = &attrs[first] };
+    }
+
+    const SDL_GPUColorTargetDescription *ct = i->target_info.num_color_targets ? &i->target_info.color_target_descriptions[0] : NULL;
+    WGPUBlendState blend;
+    WGPUColorTargetState color = {0};
+    WGPUFragmentState frag = {0};
+    if (ct) {
+        const SDL_GPUColorTargetBlendState *bs = &ct->blend_state;
+        blend = (WGPUBlendState){
+            .color = { .operation = blend_op(bs->color_blend_op), .srcFactor = blend_factor(bs->src_color_blendfactor),
+                       .dstFactor = blend_factor(bs->dst_color_blendfactor) },
+            .alpha = { .operation = blend_op(bs->alpha_blend_op), .srcFactor = blend_factor(bs->src_alpha_blendfactor),
+                       .dstFactor = blend_factor(bs->dst_alpha_blendfactor) },
+        };
+        color.format = tex_format(ct->format);
+        color.blend = bs->enable_blend ? &blend : NULL;
+        color.writeMask = bs->enable_color_write_mask ? (WGPUColorWriteMask)(bs->color_write_mask & 15u)
+                                                      : WGPUColorWriteMask_All;
+        frag = (WGPUFragmentState){ .module = i->fragment_shader->mod, .entryPoint = sv("main"),
+                                    .targetCount = 1, .targets = &color };
+    }
+
+    const SDL_GPUDepthStencilState *ds = &i->depth_stencil_state;
+    WGPUDepthStencilState depth = {0};
+    if (i->target_info.has_depth_stencil_target) {
+        WGPUTextureFormat df = tex_format(i->target_info.depth_stencil_format);
+        WGPUStencilFaceState front = {
+            .compare = ds->enable_stencil_test ? compare(ds->front_stencil_state.compare_op) : WGPUCompareFunction_Always,
+            .failOp = stencil_op(ds->front_stencil_state.fail_op),
+            .depthFailOp = stencil_op(ds->front_stencil_state.depth_fail_op),
+            .passOp = stencil_op(ds->front_stencil_state.pass_op) };
+        WGPUStencilFaceState back = {
+            .compare = ds->enable_stencil_test ? compare(ds->back_stencil_state.compare_op) : WGPUCompareFunction_Always,
+            .failOp = stencil_op(ds->back_stencil_state.fail_op),
+            .depthFailOp = stencil_op(ds->back_stencil_state.depth_fail_op),
+            .passOp = stencil_op(ds->back_stencil_state.pass_op) };
+        if (!ds->enable_stencil_test) {
+            front.failOp = front.depthFailOp = front.passOp = WGPUStencilOperation_Keep;
+            back = front;
+        }
+        depth = (WGPUDepthStencilState){
+            .format = df,
+            .depthWriteEnabled = ds->enable_depth_write ? WGPUOptionalBool_True : WGPUOptionalBool_False,
+            .depthCompare = ds->enable_depth_test ? compare(ds->compare_op) : WGPUCompareFunction_Always,
+            .stencilFront = front, .stencilBack = back,
+            .stencilReadMask = ds->enable_stencil_test ? ds->compare_mask : 0xFF,
+            .stencilWriteMask = ds->enable_stencil_test ? ds->write_mask : 0,
+        };
+    }
+
+    const SDL_GPURasterizerState *rs = &i->rasterizer_state;
+    WGPURenderPipelineDescriptor d = {
+        .layout = s_layout,
+        .vertex = { .module = i->vertex_shader->mod, .entryPoint = sv("main"), .bufferCount = nb, .buffers = vbl },
+        .primitive = {
+            .topology = WGPUPrimitiveTopology_TriangleList,
+            .frontFace = rs->front_face == SDL_GPU_FRONTFACE_CLOCKWISE ? WGPUFrontFace_CW : WGPUFrontFace_CCW,
+            .cullMode = rs->cull_mode == SDL_GPU_CULLMODE_FRONT ? WGPUCullMode_Front
+                      : rs->cull_mode == SDL_GPU_CULLMODE_BACK ? WGPUCullMode_Back : WGPUCullMode_None,
+            .unclippedDepth = (!rs->enable_depth_clip && s_has_depth_clip) ? 1 : 0,
+        },
+        .depthStencil = i->target_info.has_depth_stencil_target ? &depth : NULL,
+        .multisample = { .count = 1, .mask = 0xFFFFFFFFu },
+        .fragment = ct ? &frag : NULL,
+    };
+    WGPURenderPipeline pipe = wgpuDeviceCreateRenderPipeline(s_dev, &d);
+    if (!pipe) return;
+    a->out = (SDL_GPUGraphicsPipeline *)calloc(1, sizeof *a->out);
+    a->out->pipe = pipe;
+}
+SDL_GPUGraphicsPipeline *WG_CreateGPUGraphicsPipeline(SDL_GPUDevice *d, const SDL_GPUGraphicsPipelineCreateInfo *i)
+{
+    (void)d;
+    PipeArgs a = { i, NULL };
+    if (!i->vertex_shader || !i->fragment_shader) { SDL_SetError("pipeline without shaders"); return NULL; }
+    run_sync(do_create_pipeline, &a);
+    if (!a.out) SDL_SetError("WebGPU pipeline creation failed");
+    return a.out;
+}
+
+/* Internal: one fullscreen-triangle pipeline per target format, for blits
+ * and mipmaps (server thread). */
+static WGPURenderPipeline blit_pipeline(WGPUTextureFormat f)
+{
+    static struct { WGPUTextureFormat f; WGPURenderPipeline p; } cache[4];
+    static int n;
+    for (int i = 0; i < n; i++) if (cache[i].f == f) return cache[i].p;
+    WGPUBindGroupLayoutEntry e[2] = {
+        { .binding = 0, .visibility = WGPUShaderStage_Fragment,
+          .texture = { .sampleType = WGPUTextureSampleType_Float, .viewDimension = WGPUTextureViewDimension_2D } },
+        { .binding = 1, .visibility = WGPUShaderStage_Fragment, .sampler = { .type = WGPUSamplerBindingType_Filtering } },
+    };
+    static WGPUBindGroupLayout bgl;
+    static WGPUPipelineLayout pl;
+    if (!bgl) {
+        bgl = make_bgl(e, 2);
+        WGPUPipelineLayoutDescriptor pd = { .bindGroupLayoutCount = 1, .bindGroupLayouts = &bgl };
+        pl = wgpuDeviceCreatePipelineLayout(s_dev, &pd);
+    }
+    WGPUColorTargetState ct = { .format = f, .writeMask = WGPUColorWriteMask_All };
+    WGPUFragmentState fs = { .module = s_blit_module, .entryPoint = sv("fs"), .targetCount = 1, .targets = &ct };
+    WGPURenderPipelineDescriptor d = {
+        .layout = pl, .vertex = { .module = s_blit_module, .entryPoint = sv("vs") },
+        .primitive = { .topology = WGPUPrimitiveTopology_TriangleList, .cullMode = WGPUCullMode_None },
+        .multisample = { .count = 1, .mask = 0xFFFFFFFFu }, .fragment = &fs,
+    };
+    WGPURenderPipeline p = wgpuDeviceCreateRenderPipeline(s_dev, &d);
+    if (n < 4) { cache[n].f = f; cache[n].p = p; n++; }
+    return p;
+}
+
+/* ── Command buffers ──────────────────────────────────────────────────── */
+SDL_GPUCommandBuffer *WG_AcquireGPUCommandBuffer(SDL_GPUDevice *d)
+{
+    (void)d;
+    return (SDL_GPUCommandBuffer *)calloc(1, sizeof(SDL_GPUCommandBuffer));
+}
+
+static Op *push(SDL_GPUCommandBuffer *c, OpKind k)
+{
+    if (c->n == c->cap) {
+        uint32_t cap = c->cap ? c->cap * 2 : 64;
+        Op *o = (Op *)realloc(c->ops, cap * sizeof *o);
+        if (!o) return NULL;
+        c->ops = o;
+        c->cap = cap;
+    }
+    Op *o = &c->ops[c->n++];
+    memset(o, 0, sizeof *o);
+    o->kind = k;
+    return o;
+}
+
+static void cmd_free(SDL_GPUCommandBuffer *c) { free(c->ops); free(c->uniforms); free(c); }
+
+bool WG_CancelGPUCommandBuffer(SDL_GPUCommandBuffer *c) { if (c) cmd_free(c); return true; }
+
+/* Passes are views of their command buffer. */
+SDL_GPUCopyPass *WG_BeginGPUCopyPass(SDL_GPUCommandBuffer *c) { return (SDL_GPUCopyPass *)c; }
+void WG_EndGPUCopyPass(SDL_GPUCopyPass *p) { (void)p; }
+#define CMD(pass) ((SDL_GPUCommandBuffer *)(pass))
+
+void WG_UploadToGPUBuffer(SDL_GPUCopyPass *p, const SDL_GPUTransferBufferLocation *s, const SDL_GPUBufferRegion *d, bool cycle)
+{
+    (void)cycle;
+    Op *o = push(CMD(p), OP_UPLOAD_BUFFER);
+    if (o) o->ub = (typeof(o->ub)){ s->transfer_buffer, s->offset, d->buffer, d->offset, d->size };
+}
+void WG_UploadToGPUTexture(SDL_GPUCopyPass *p, const SDL_GPUTextureTransferInfo *s, const SDL_GPUTextureRegion *d, bool cycle)
+{
+    (void)cycle;
+    Op *o = push(CMD(p), OP_UPLOAD_TEXTURE);
+    if (o) o->ut = (typeof(o->ut)){ s->transfer_buffer, s->offset, s->pixels_per_row ? s->pixels_per_row : d->w,
+                                   s->rows_per_layer ? s->rows_per_layer : d->h, d->texture, d->mip_level,
+                                   d->x, d->y, d->w, d->h };
+}
+void WG_DownloadFromGPUTexture(SDL_GPUCopyPass *p, const SDL_GPUTextureRegion *s, const SDL_GPUTextureTransferInfo *d)
+{
+    Op *o = push(CMD(p), OP_DOWNLOAD_TEXTURE);
+    if (o) o->dt = (typeof(o->dt)){ s->texture, s->mip_level, s->x, s->y, s->w, s->h, d->transfer_buffer, d->offset,
+                                   d->pixels_per_row ? d->pixels_per_row : s->w };
+    CMD(p)->has_download = 1;
+}
+void WG_CopyGPUTextureToTexture(SDL_GPUCopyPass *p, const SDL_GPUTextureLocation *s, const SDL_GPUTextureLocation *d,
+                                Uint32 w, Uint32 h, Uint32 depth, bool cycle)
+{
+    (void)depth; (void)cycle;
+    Op *o = push(CMD(p), OP_COPY_TEXTURE);
+    if (o) o->ct = (typeof(o->ct)){ s->texture, d->texture, s->mip_level, s->x, s->y, d->mip_level, d->x, d->y, w, h };
+}
+void WG_GenerateMipmapsForGPUTexture(SDL_GPUCommandBuffer *c, SDL_GPUTexture *t)
+{
+    Op *o = push(c, OP_MIPMAPS);
+    if (o) o->mip.tex = t;
+}
+void WG_BlitGPUTexture(SDL_GPUCommandBuffer *c, const SDL_GPUBlitInfo *i)
+{
+    Op *o = push(c, OP_BLIT);
+    if (o) o->blit = (typeof(o->blit)){ i->source.texture, i->destination.texture, i->destination.x, i->destination.y,
+                                       i->destination.w, i->destination.h, i->filter == SDL_GPU_FILTER_LINEAR,
+                                       i->load_op == SDL_GPU_LOADOP_CLEAR, i->clear_color };
+}
+
+SDL_GPURenderPass *WG_BeginGPURenderPass(SDL_GPUCommandBuffer *c, const SDL_GPUColorTargetInfo *ct, Uint32 n,
+                                         const SDL_GPUDepthStencilTargetInfo *ds)
+{
+    Op *o = push(c, OP_BEGIN_PASS);
+    if (o) {
+        if (n) { o->pass.color = ct[0]; o->pass.has_color = 1; }
+        if (ds) { o->pass.depth = *ds; o->pass.has_depth = 1; }
+    }
+    return (SDL_GPURenderPass *)c;
+}
+void WG_EndGPURenderPass(SDL_GPURenderPass *p) { push(CMD(p), OP_END_PASS); }
+void WG_SetGPUViewport(SDL_GPURenderPass *p, const SDL_GPUViewport *v) { Op *o = push(CMD(p), OP_VIEWPORT); if (o) o->viewport = *v; }
+void WG_SetGPUScissor(SDL_GPURenderPass *p, const SDL_Rect *r) { Op *o = push(CMD(p), OP_SCISSOR); if (o) o->scissor = *r; }
+void WG_SetGPUBlendConstants(SDL_GPURenderPass *p, SDL_FColor c) { Op *o = push(CMD(p), OP_BLEND_CONSTANT); if (o) o->blend = c; }
+void WG_SetGPUStencilReference(SDL_GPURenderPass *p, Uint8 r) { Op *o = push(CMD(p), OP_STENCIL_REF); if (o) o->stencil_ref = r; }
+void WG_BindGPUGraphicsPipeline(SDL_GPURenderPass *p, SDL_GPUGraphicsPipeline *g) { Op *o = push(CMD(p), OP_PIPELINE); if (o) o->pipeline = g; }
+void WG_BindGPUVertexBuffers(SDL_GPURenderPass *p, Uint32 first, const SDL_GPUBufferBinding *b, Uint32 n)
+{
+    (void)first;
+    if (n) { Op *o = push(CMD(p), OP_VERTEX_BUFFER); if (o) o->vb = (typeof(o->vb)){ b[0].buffer, b[0].offset }; }
+}
+void WG_BindGPUIndexBuffer(SDL_GPURenderPass *p, const SDL_GPUBufferBinding *b, SDL_GPUIndexElementSize s)
+{
+    (void)s;   /* the renderer only uses 32-bit indices */
+    Op *o = push(CMD(p), OP_INDEX_BUFFER);
+    if (o) o->vb = (typeof(o->vb)){ b->buffer, b->offset };
+}
+void WG_BindGPUFragmentSamplers(SDL_GPURenderPass *p, Uint32 first, const SDL_GPUTextureSamplerBinding *b, Uint32 n)
+{
+    Op *o = push(CMD(p), OP_SAMPLERS);
+    if (!o) return;
+    o->samplers.first = first;
+    o->samplers.n = n > WG_MAX_SAMPLERS ? WG_MAX_SAMPLERS : n;
+    for (uint32_t i = 0; i < o->samplers.n; i++) { o->samplers.tex[i] = b[i].texture; o->samplers.smp[i] = b[i].sampler; }
+}
+static void push_uniform(SDL_GPUCommandBuffer *c, int fragment, const void *data, Uint32 len)
+{
+    uint32_t off = (c->ubytes + WG_UNIFORM_ALIGN - 1) & ~(WG_UNIFORM_ALIGN - 1);
+    uint32_t cap_needed = off + len + 4;   /* + the 4-byte rounding of the final write */
+    if (cap_needed > c->ucap) {
+        uint32_t cap = c->ucap ? c->ucap : 4096;
+        while (cap < cap_needed) cap *= 2;
+        uint8_t *u = (uint8_t *)realloc(c->uniforms, cap);
+        if (!u) return;
+        c->uniforms = u;
+        c->ucap = cap;
+    }
+    memset(c->uniforms + c->ubytes, 0, off - c->ubytes);
+    memcpy(c->uniforms + off, data, len);
+    c->ubytes = off + len;
+    Op *o = push(c, OP_UNIFORM);
+    if (o) o->uniform = (typeof(o->uniform)){ fragment, off };
+}
+void WG_PushGPUVertexUniformData(SDL_GPUCommandBuffer *c, Uint32 slot, const void *d, Uint32 len) { (void)slot; push_uniform(c, 0, d, len); }
+void WG_PushGPUFragmentUniformData(SDL_GPUCommandBuffer *c, Uint32 slot, const void *d, Uint32 len) { (void)slot; push_uniform(c, 1, d, len); }
+void WG_DrawGPUPrimitives(SDL_GPURenderPass *p, Uint32 n, Uint32 inst, Uint32 first_v, Uint32 first_i)
+{
+    Op *o = push(CMD(p), OP_DRAW);
+    if (o) o->draw = (typeof(o->draw)){ n, inst, first_v, first_i, 0 };
+}
+void WG_DrawGPUIndexedPrimitives(SDL_GPURenderPass *p, Uint32 n, Uint32 inst, Uint32 first_idx, Sint32 voff, Uint32 first_i)
+{
+    Op *o = push(CMD(p), OP_DRAW_INDEXED);
+    if (o) o->draw = (typeof(o->draw)){ n, inst, first_idx, first_i, voff };
+}
+
+/* ── Replay (server thread) ───────────────────────────────────────────── */
+typedef struct {
+    WGPUBuffer buf;
+    uint8_t *dst;              /* transfer buffer memory */
+    uint32_t row_bytes, padded, rows, dst_stride;
+} Readback;
+
+typedef struct {
+    SDL_GPUCommandBuffer *c;
+    WGPUCommandEncoder enc;
+    int encoded;               /* GPU commands in `enc` not yet submitted */
+    WGPUTexture swap_tex;      /* the canvas's current texture, once resolved */
+    WGPUTextureView swap_view;
+    Readback *rb; uint32_t nrb, caprb;
+    WGPUBuffer ubuf;           /* this submission's uniforms */
+    WGPUBindGroup vs_group, fs_group, empty_group;
+    em_proxying_ctx *ctx;
+    atomic_int pending;
+} Replay;
+
+static WGPUTextureView view_of(Replay *r, SDL_GPUTexture *t, uint32_t level, int sampling)
+{
+    if (t->swapchain) {
+        if (!r->swap_tex) {
+            WGPUSurfaceTexture st = {0};
+            wgpuSurfaceGetCurrentTexture(s_surface, &st);
+            r->swap_tex = st.texture;
+            r->swap_view = st.texture ? wgpuTextureCreateView(st.texture, NULL) : NULL;
+        }
+        return r->swap_view;
+    }
+    return sampling ? t->view : t->level_views[level < t->levels ? level : 0];
+}
+
+static void flush_encoder(Replay *r)
+{
+    if (!r->encoded) return;
+    WGPUCommandBuffer cb = wgpuCommandEncoderFinish(r->enc, NULL);
+    wgpuQueueSubmit(s_queue, 1, &cb);
+    wgpuCommandBufferRelease(cb);
+    wgpuCommandEncoderRelease(r->enc);
+    r->enc = wgpuDeviceCreateCommandEncoder(s_dev, NULL);
+    r->encoded = 0;
+}
+
+static void fullscreen_pass(Replay *r, WGPUTextureView src, WGPUSampler smp, WGPUTextureView dst,
+                            WGPUTextureFormat fmt, int clear, SDL_FColor cc, const float *viewport)
+{
+    WGPURenderPassColorAttachment ca = { .view = dst, .depthSlice = WGPU_DEPTH_SLICE_UNDEFINED,
+        .loadOp = clear ? WGPULoadOp_Clear : WGPULoadOp_Load, .storeOp = WGPUStoreOp_Store,
+        .clearValue = { cc.r, cc.g, cc.b, cc.a } };
+    WGPURenderPassDescriptor rp = { .colorAttachmentCount = 1, .colorAttachments = &ca };
+    WGPURenderPipeline pipe = blit_pipeline(fmt);
+    WGPUBindGroupEntry be[2] = { { .binding = 0, .textureView = src }, { .binding = 1, .sampler = smp } };
+    WGPUBindGroupDescriptor bd = { .layout = wgpuRenderPipelineGetBindGroupLayout(pipe, 0), .entryCount = 2, .entries = be };
+    WGPUBindGroup bg = wgpuDeviceCreateBindGroup(s_dev, &bd);
+    WGPURenderPassEncoder pe = wgpuCommandEncoderBeginRenderPass(r->enc, &rp);
+    wgpuRenderPassEncoderSetPipeline(pe, pipe);
+    wgpuRenderPassEncoderSetBindGroup(pe, 0, bg, 0, NULL);
+    if (viewport && viewport[2] > 0 && viewport[3] > 0)
+        wgpuRenderPassEncoderSetViewport(pe, viewport[0], viewport[1], viewport[2], viewport[3], 0, 1);
+    wgpuRenderPassEncoderDraw(pe, 3, 1, 0, 0);
+    wgpuRenderPassEncoderEnd(pe);
+    wgpuRenderPassEncoderRelease(pe);
+    wgpuBindGroupRelease(bg);
+    wgpuBindGroupLayoutRelease(bd.layout);
+    r->encoded = 1;
+}
+
+static void replay_pass(Replay *r, uint32_t *ip)
+{
+    SDL_GPUCommandBuffer *c = r->c;
+    const Op *begin = &c->ops[*ip];
+    WGPURenderPassColorAttachment ca = {0};
+    WGPURenderPassDepthStencilAttachment da = {0};
+    WGPURenderPassDescriptor rp = {0};
+    uint32_t tw = 0, th = 0;
+
+    if (begin->pass.has_color) {
+        const SDL_GPUColorTargetInfo *t = &begin->pass.color;
+        ca = (WGPURenderPassColorAttachment){ .view = view_of(r, t->texture, t->mip_level, 0),
+            .depthSlice = WGPU_DEPTH_SLICE_UNDEFINED, .loadOp = load_op(t->load_op), .storeOp = store_op(t->store_op),
+            .clearValue = { t->clear_color.r, t->clear_color.g, t->clear_color.b, t->clear_color.a } };
+        rp.colorAttachmentCount = 1;
+        rp.colorAttachments = &ca;
+        tw = t->texture->swapchain ? s_surface_w : t->texture->w;
+        th = t->texture->swapchain ? s_surface_h : t->texture->h;
+    }
+    if (begin->pass.has_depth) {
+        const SDL_GPUDepthStencilTargetInfo *t = &begin->pass.depth;
+        da = (WGPURenderPassDepthStencilAttachment){ .view = t->texture->level_views[0],
+            .depthLoadOp = load_op(t->load_op), .depthStoreOp = store_op(t->store_op), .depthClearValue = t->clear_depth };
+        if (has_stencil(t->texture->format)) {
+            da.stencilLoadOp = load_op(t->stencil_load_op);
+            da.stencilStoreOp = store_op(t->stencil_store_op);
+            da.stencilClearValue = t->clear_stencil;
+        }
+        rp.depthStencilAttachment = &da;
+        if (!tw) { tw = t->texture->w; th = t->texture->h; }
+    }
+
+    WGPURenderPassEncoder pe = wgpuCommandEncoderBeginRenderPass(r->enc, &rp);
+    r->encoded = 1;
+    SDL_GPUTexture *tex[WG_MAX_SAMPLERS] = {0};
+    SDL_GPUSampler *smp[WG_MAX_SAMPLERS] = {0};
+    uint32_t vs_off = 0, fs_off = 0;
+    int samplers_dirty = 1;
+    WGPUBindGroup tex_group = NULL;
+
+    for ((*ip)++; *ip < c->n && c->ops[*ip].kind != OP_END_PASS; (*ip)++) {
+        const Op *o = &c->ops[*ip];
+        switch (o->kind) {
+        case OP_VIEWPORT:
+            wgpuRenderPassEncoderSetViewport(pe, o->viewport.x, o->viewport.y, o->viewport.w, o->viewport.h,
+                                             o->viewport.min_depth, o->viewport.max_depth);
+            break;
+        case OP_SCISSOR: {
+            /* WebGPU rejects rectangles outside the target: clamp. */
+            int x0 = o->scissor.x < 0 ? 0 : o->scissor.x, y0 = o->scissor.y < 0 ? 0 : o->scissor.y;
+            int x1 = o->scissor.x + o->scissor.w, y1 = o->scissor.y + o->scissor.h;
+            if (x1 > (int)tw) x1 = (int)tw;
+            if (y1 > (int)th) y1 = (int)th;
+            if (x0 > x1) x0 = x1;
+            if (y0 > y1) y0 = y1;
+            wgpuRenderPassEncoderSetScissorRect(pe, (uint32_t)x0, (uint32_t)y0, (uint32_t)(x1 - x0), (uint32_t)(y1 - y0));
+            break;
+        }
+        case OP_BLEND_CONSTANT: {
+            WGPUColor col = { o->blend.r, o->blend.g, o->blend.b, o->blend.a };
+            wgpuRenderPassEncoderSetBlendConstant(pe, &col);
+            break;
+        }
+        case OP_STENCIL_REF: wgpuRenderPassEncoderSetStencilReference(pe, o->stencil_ref); break;
+        case OP_PIPELINE: wgpuRenderPassEncoderSetPipeline(pe, o->pipeline->pipe); break;
+        case OP_VERTEX_BUFFER: wgpuRenderPassEncoderSetVertexBuffer(pe, 0, o->vb.buf->buf, o->vb.off, WGPU_WHOLE_SIZE); break;
+        case OP_INDEX_BUFFER:
+            wgpuRenderPassEncoderSetIndexBuffer(pe, o->vb.buf->buf, WGPUIndexFormat_Uint32, o->vb.off, WGPU_WHOLE_SIZE);
+            break;
+        case OP_SAMPLERS:
+            for (uint32_t i = 0; i < o->samplers.n && o->samplers.first + i < WG_MAX_SAMPLERS; i++) {
+                tex[o->samplers.first + i] = o->samplers.tex[i];
+                smp[o->samplers.first + i] = o->samplers.smp[i];
+            }
+            samplers_dirty = 1;
+            break;
+        case OP_UNIFORM:
+            if (o->uniform.fragment) fs_off = o->uniform.off; else vs_off = o->uniform.off;
+            break;
+        case OP_DRAW:
+        case OP_DRAW_INDEXED:
+            if (samplers_dirty) {
+                WGPUBindGroupEntry e[2 * WG_MAX_SAMPLERS];
+                for (uint32_t i = 0; i < WG_MAX_SAMPLERS; i++) {
+                    e[i] = (WGPUBindGroupEntry){ .binding = i,
+                        .textureView = tex[i] && tex[i]->view ? tex[i]->view : s_dummy_view };
+                    e[WG_MAX_SAMPLERS + i] = (WGPUBindGroupEntry){ .binding = WG_MAX_SAMPLERS + i,
+                        .sampler = smp[i] ? smp[i]->s : s_dummy_sampler };
+                }
+                WGPUBindGroupDescriptor bd = { .layout = s_bgl[2], .entryCount = 2 * WG_MAX_SAMPLERS, .entries = e };
+                if (tex_group) wgpuBindGroupRelease(tex_group);
+                tex_group = wgpuDeviceCreateBindGroup(s_dev, &bd);
+                samplers_dirty = 0;
+            }
+            wgpuRenderPassEncoderSetBindGroup(pe, 0, r->empty_group, 0, NULL);
+            wgpuRenderPassEncoderSetBindGroup(pe, 1, r->vs_group, 1, &vs_off);
+            wgpuRenderPassEncoderSetBindGroup(pe, 2, tex_group, 0, NULL);
+            wgpuRenderPassEncoderSetBindGroup(pe, 3, r->fs_group, 1, &fs_off);
+            if (o->kind == OP_DRAW)
+                wgpuRenderPassEncoderDraw(pe, o->draw.count, o->draw.instances, o->draw.first, o->draw.first_instance);
+            else
+                wgpuRenderPassEncoderDrawIndexed(pe, o->draw.count, o->draw.instances, o->draw.first,
+                                                 o->draw.vertex_offset, o->draw.first_instance);
+            break;
+        default:
+            break;
+        }
+    }
+    wgpuRenderPassEncoderEnd(pe);
+    wgpuRenderPassEncoderRelease(pe);
+    if (tex_group) wgpuBindGroupRelease(tex_group);
+}
+
+static void on_readback(WGPUMapAsyncStatus st, WGPUStringView msg, void *u1, void *u2)
+{
+    Replay *r = (Replay *)u1;
+    Readback *b = (Readback *)u2;
+    if (st == WGPUMapAsyncStatus_Success) {
+        const uint8_t *src = (const uint8_t *)wgpuBufferGetConstMappedRange(b->buf, 0, (size_t)b->padded * b->rows);
+        for (uint32_t y = 0; src && y < b->rows; y++)
+            memcpy(b->dst + (size_t)y * b->dst_stride, src + (size_t)y * b->padded, b->row_bytes);
+        wgpuBufferUnmap(b->buf);
+    } else {
+        report("download", msg);
+    }
+    wgpuBufferRelease(b->buf);
+    if (atomic_fetch_sub(&r->pending, 1) == 1)
+        emscripten_proxy_finish(r->ctx);
+}
+
+static void replay(Replay *r)
+{
+    SDL_GPUCommandBuffer *c = r->c;
+    r->enc = wgpuDeviceCreateCommandEncoder(s_dev, NULL);
+
+    /* Uniforms of the whole submission in one buffer; each draw binds its
+     * own offsets. Room past the end for a full binding at the last offset. */
+    {
+        uint32_t size = c->ubytes + WG_VS_UNIFORM_BYTES;
+        size = (size + 3u) & ~3u;
+        WGPUBufferDescriptor bd = { .usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst, .size = size };
+        r->ubuf = wgpuDeviceCreateBuffer(s_dev, &bd);
+        if (c->ubytes)
+            wgpuQueueWriteBuffer(s_queue, r->ubuf, 0, c->uniforms, (c->ubytes + 3u) & ~3u);
+        WGPUBindGroupEntry ve = { .binding = 0, .buffer = r->ubuf, .offset = 0, .size = WG_VS_UNIFORM_BYTES };
+        WGPUBindGroupEntry fe = { .binding = 0, .buffer = r->ubuf, .offset = 0, .size = WG_FS_UNIFORM_BYTES };
+        WGPUBindGroupDescriptor vd = { .layout = s_bgl[1], .entryCount = 1, .entries = &ve };
+        WGPUBindGroupDescriptor fd = { .layout = s_bgl[3], .entryCount = 1, .entries = &fe };
+        WGPUBindGroupDescriptor ed = { .layout = s_bgl[0], .entryCount = 0 };
+        r->vs_group = wgpuDeviceCreateBindGroup(s_dev, &vd);
+        r->fs_group = wgpuDeviceCreateBindGroup(s_dev, &fd);
+        r->empty_group = wgpuDeviceCreateBindGroup(s_dev, &ed);
+    }
+
+    for (uint32_t i = 0; i < c->n; i++) {
+        const Op *o = &c->ops[i];
+        switch (o->kind) {
+        case OP_UPLOAD_BUFFER:
+            /* Queue writes run ahead of the encoder: submit what is encoded
+             * first so the order SDL promises holds. */
+            flush_encoder(r);
+            wgpuQueueWriteBuffer(s_queue, o->ub.dst->buf, o->ub.dst_off, o->ub.src->mem + o->ub.src_off,
+                                 (o->ub.size + 3u) & ~3u);
+            break;
+        case OP_UPLOAD_TEXTURE: {
+            flush_encoder(r);
+            WGPUTexelCopyTextureInfo dst = { .texture = o->ut.dst->tex, .mipLevel = o->ut.level,
+                                             .origin = { o->ut.x, o->ut.y, 0 }, .aspect = WGPUTextureAspect_All };
+            WGPUTexelCopyBufferLayout layout = { .offset = 0, .bytesPerRow = o->ut.row_px * 4, .rowsPerImage = o->ut.rows };
+            WGPUExtent3D ext = { o->ut.w, o->ut.h, 1 };
+            wgpuQueueWriteTexture(s_queue, &dst, o->ut.src->mem + o->ut.src_off,
+                                  (size_t)o->ut.row_px * 4 * o->ut.h, &layout, &ext);
+            break;
+        }
+        case OP_DOWNLOAD_TEXTURE: {
+            if (r->nrb == r->caprb) {
+                r->caprb = r->caprb ? r->caprb * 2 : 4;
+                r->rb = (Readback *)realloc(r->rb, r->caprb * sizeof *r->rb);
+            }
+            Readback *b = &r->rb[r->nrb++];
+            b->row_bytes = o->dt.w * 4;
+            b->padded = (b->row_bytes + 255u) & ~255u;     /* copyTextureToBuffer's row alignment */
+            b->rows = o->dt.h;
+            b->dst = o->dt.dst->mem + o->dt.dst_off;
+            b->dst_stride = o->dt.row_px * 4;
+            WGPUBufferDescriptor bd = { .usage = WGPUBufferUsage_MapRead | WGPUBufferUsage_CopyDst,
+                                        .size = (uint64_t)b->padded * b->rows };
+            b->buf = wgpuDeviceCreateBuffer(s_dev, &bd);
+            WGPUTexelCopyTextureInfo src = { .texture = o->dt.src->tex, .mipLevel = o->dt.level,
+                                             .origin = { o->dt.x, o->dt.y, 0 }, .aspect = WGPUTextureAspect_All };
+            WGPUTexelCopyBufferInfo dst = { .layout = { .bytesPerRow = b->padded, .rowsPerImage = b->rows }, .buffer = b->buf };
+            WGPUExtent3D ext = { o->dt.w, o->dt.h, 1 };
+            wgpuCommandEncoderCopyTextureToBuffer(r->enc, &src, &dst, &ext);
+            r->encoded = 1;
+            break;
+        }
+        case OP_COPY_TEXTURE: {
+            WGPUTexelCopyTextureInfo src = { .texture = o->ct.src->tex, .mipLevel = o->ct.sl,
+                                             .origin = { o->ct.sx, o->ct.sy, 0 }, .aspect = WGPUTextureAspect_All };
+            WGPUTexelCopyTextureInfo dst = { .texture = o->ct.dst->tex, .mipLevel = o->ct.dl,
+                                             .origin = { o->ct.dx, o->ct.dy, 0 }, .aspect = WGPUTextureAspect_All };
+            WGPUExtent3D ext = { o->ct.w, o->ct.h, 1 };
+            wgpuCommandEncoderCopyTextureToTexture(r->enc, &src, &dst, &ext);
+            r->encoded = 1;
+            break;
+        }
+        case OP_MIPMAPS: {
+            SDL_GPUTexture *t = o->mip.tex;
+            for (uint32_t l = 1; l < t->levels; l++)
+                fullscreen_pass(r, t->level_views[l - 1], s_linear_sampler, t->level_views[l], t->format, 1,
+                                (SDL_FColor){0, 0, 0, 0}, NULL);
+            break;
+        }
+        case OP_BLIT: {
+            SDL_GPUTexture *d = o->blit.dst;
+            WGPUTextureView dv = view_of(r, d, 0, 0);
+            WGPUTextureFormat df = d->swapchain ? s_surface_format : d->format;
+            float vp[4] = { (float)o->blit.dx, (float)o->blit.dy, (float)o->blit.dw, (float)o->blit.dh };
+            if (dv && o->blit.src->view)
+                fullscreen_pass(r, o->blit.src->view, o->blit.linear ? s_linear_sampler : s_nearest_sampler, dv, df,
+                                o->blit.clear, o->blit.clear_color, vp);
+            break;
+        }
+        case OP_BEGIN_PASS:
+            replay_pass(r, &i);
+            break;
+        default:
+            break;   /* render-pass state outside a pass: nothing to do */
+        }
+    }
+
+    WGPUCommandBuffer cb = wgpuCommandEncoderFinish(r->enc, NULL);
+    wgpuQueueSubmit(s_queue, 1, &cb);
+    wgpuCommandBufferRelease(cb);
+    wgpuCommandEncoderRelease(r->enc);
+    wgpuBindGroupRelease(r->vs_group);
+    wgpuBindGroupRelease(r->fs_group);
+    wgpuBindGroupRelease(r->empty_group);
+    wgpuBufferRelease(r->ubuf);
+    if (r->swap_view) wgpuTextureViewRelease(r->swap_view);
+    if (r->swap_tex) wgpuTextureRelease(r->swap_tex);
+}
+
+static void do_submit(void *p) { replay((Replay *)p); }
+
+static void do_submit_download(em_proxying_ctx *ctx, void *p)
+{
+    Replay *r = (Replay *)p;
+    r->ctx = ctx;
+    replay(r);
+    atomic_store(&r->pending, (int)r->nrb);
+    if (!r->nrb) { emscripten_proxy_finish(ctx); return; }
+    for (uint32_t i = 0; i < r->nrb; i++) {
+        WGPUBufferMapCallbackInfo ci = { .mode = WGPUCallbackMode_AllowSpontaneous, .callback = on_readback,
+                                         .userdata1 = r, .userdata2 = &r->rb[i] };
+        wgpuBufferMapAsync(r->rb[i].buf, WGPUMapMode_Read, 0, (size_t)r->rb[i].padded * r->rb[i].rows, ci);
+    }
+}
+
+bool WG_SubmitGPUCommandBuffer(SDL_GPUCommandBuffer *c)
+{
+    Replay r = { .c = c };
+    if (c->has_download) run_sync_ctx(do_submit_download, &r);   /* returns with the data in place */
+    else run_sync(do_submit, &r);
+    free(r.rb);
+    cmd_free(c);
+    return true;
+}
+
+/* Submits are complete when they return (downloads included), so a fence
+ * is already signalled. */
+SDL_GPUFence *WG_SubmitGPUCommandBufferAndAcquireFence(SDL_GPUCommandBuffer *c)
+{
+    WG_SubmitGPUCommandBuffer(c);
+    return &s_fence_obj;
+}
+bool WG_WaitForGPUFences(SDL_GPUDevice *d, bool all, SDL_GPUFence *const *f, Uint32 n) { (void)d; (void)all; (void)f; (void)n; return true; }
+void WG_ReleaseGPUFence(SDL_GPUDevice *d, SDL_GPUFence *f) { (void)d; (void)f; }
+
+/* ── Presenting ───────────────────────────────────────────────────────── */
+typedef struct { uint32_t w, h; } SizeArgs;
+static void do_configure(void *p)
+{
+    SizeArgs *a = (SizeArgs *)p;
+    if (!s_surface) return;
+    emscripten_set_canvas_element_size(s_canvas_selector, (int)a->w, (int)a->h);
+    WGPUSurfaceConfiguration cfg = { .device = s_dev, .format = s_surface_format,
+        .usage = WGPUTextureUsage_RenderAttachment, .width = a->w, .height = a->h,
+        .alphaMode = WGPUCompositeAlphaMode_Opaque, .presentMode = WGPUPresentMode_Fifo };
+    wgpuSurfaceConfigure(s_surface, &cfg);
+    s_surface_w = a->w;
+    s_surface_h = a->h;
+}
+
+static void window_pixels(SDL_Window *w, uint32_t *pw, uint32_t *ph)
+{
+    int x = 0, y = 0;
+    if (w) SDL_GetWindowSizeInPixels(w, &x, &y);
+    *pw = x > 0 ? (uint32_t)x : 640;
+    *ph = y > 0 ? (uint32_t)y : 480;
+}
+
+bool WG_ClaimWindowForGPUDevice(SDL_GPUDevice *d, SDL_Window *w)
+{
+    (void)d;
+    SizeArgs a;
+    if (!s_surface) { SDL_SetError("no WebGPU canvas"); return false; }
+    window_pixels(w, &a.w, &a.h);
+    run_sync(do_configure, &a);
+    /* Show the GPU canvas over SDL's (which keeps the input focus). */
+    MAIN_THREAD_EM_ASM({
+        var c = document.querySelector(UTF8ToString($0));
+        if (c) c.hidden = false;
+        if (Module['onGpuPresent']) Module['onGpuPresent'](true);
+    }, s_canvas_selector);
+    return true;
+}
+void WG_ReleaseWindowFromGPUDevice(SDL_GPUDevice *d, SDL_Window *w)
+{
+    (void)d; (void)w;
+    MAIN_THREAD_EM_ASM({
+        var c = document.querySelector(UTF8ToString($0));
+        if (c) c.hidden = true;
+        if (Module['onGpuPresent']) Module['onGpuPresent'](false);
+    }, s_canvas_selector);
+}
+
+/* Wait for the next animation frame on the server: the presenter's pacing.
+ * The callback finishes the proxied call through an exported C function. */
+EMSCRIPTEN_KEEPALIVE void wg_frame_done(em_proxying_ctx *ctx) { emscripten_proxy_finish(ctx); }
+EM_JS(void, wg_frame_wait_js, (em_proxying_ctx *ctx), {
+    var done = () => _wg_frame_done(ctx);
+    if (typeof requestAnimationFrame === 'function') requestAnimationFrame(done);
+    else setTimeout(done, 16);
+});
+static void do_frame_wait(em_proxying_ctx *ctx, void *p) { (void)p; wg_frame_wait_js(ctx); }
+
+bool WG_WaitAndAcquireGPUSwapchainTexture(SDL_GPUCommandBuffer *c, SDL_Window *w, SDL_GPUTexture **t, Uint32 *tw, Uint32 *th)
+{
+    static struct SDL_GPUTexture swap = { .swapchain = 1, .levels = 1 };
+    SizeArgs a;
+    (void)c;
+    window_pixels(w, &a.w, &a.h);
+    if (a.w != s_surface_w || a.h != s_surface_h)
+        run_sync(do_configure, &a);
+    run_sync_ctx(do_frame_wait, NULL);
+    swap.w = s_surface_w;
+    swap.h = s_surface_h;
+    swap.format = s_surface_format;
+    *t = &swap;
+    if (tw) *tw = s_surface_w;
+    if (th) *th = s_surface_h;
+    return true;
+}
+#endif /* __EMSCRIPTEN__ */
