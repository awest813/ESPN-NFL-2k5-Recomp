+/* Browser fence handoff. Old completed-kick snapshots must not overwrite a
+ * newer semaphore release from the render thread. Fence numbers wrap at 32
+ * bits, with less than half the sequence space outstanding at once. */
+static void web_fence_publish(volatile uint32_t *fence, uint32_t value)
+{
+    if ((uintptr_t)fence & 3u) { *fence = value; return; }
+    uint32_t previous = __atomic_load_n(fence, __ATOMIC_RELAXED);
+    while ((int32_t)(value - previous) > 0) {
+        if (__atomic_compare_exchange_n(fence, &previous, value, 0,
+                                        __ATOMIC_RELEASE, __ATOMIC_RELAXED)) {
+            emscripten_futex_wake((void *)fence, INT_MAX);
+            return;
+        }
+    }
+}
