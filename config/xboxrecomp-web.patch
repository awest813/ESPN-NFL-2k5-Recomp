+/* OFFSCREENCANVAS_SUPPORT (the presentation canvas) needs Emscripten's GL
+ * object even though nothing here uses WebGL. */
+EM_JS_DEPS(sdl_gpu_webgpu, "$GL");
+
+#define WG_VS_UNIFORM_BYTES 4096u   /* binding size of vertex uniforms (group 1) */
+#define WG_FS_UNIFORM_BYTES 1024u   /* binding size of fragment uniforms (group 3) */
+#define WG_UNIFORM_ALIGN    256u    /* minUniformBufferOffsetAlignment */
+#define WG_MAX_SAMPLERS     8u      /* 2D stages 0..3, cube stages 4..7; samplers at 8 + i */
+
+/* ── Objects ──────────────────────────────────────────────────────────────
+ * Each SDL handle is one of these, owned by the caller; the WebGPU handles in
+ * it are only touched on the server thread. */
+struct SDL_GPUDevice { int unused; };
+struct SDL_GPUTexture {
+    WGPUTexture tex;
+    WGPUTextureView view;         /* all levels: sampling */
+    WGPUTextureView *level_views; /* one per level: render targets, mip generation */
+    WGPUTextureFormat format;
+    uint32_t w, h, levels, layers;
+    int swapchain;                /* the canvas's current texture, resolved at replay */
+};
+struct SDL_GPUBuffer { WGPUBuffer buf; uint32_t size; };
+struct SDL_GPUTransferBuffer { uint8_t *mem; uint32_t size; };
+struct SDL_GPUSampler { WGPUSampler s; };
+struct SDL_GPUShader { WGPUShaderModule mod; SDL_GPUShaderStage stage; };
+struct SDL_GPUGraphicsPipeline { WGPURenderPipeline pipe; };
+struct SDL_GPUFence { atomic_int state; atomic_uint refs; };
+
+/* Recorded commands, replayed on the server at submit. */
+typedef enum {
+    OP_UPLOAD_BUFFER, OP_UPLOAD_TEXTURE, OP_DOWNLOAD_TEXTURE, OP_COPY_TEXTURE,
+    OP_MIPMAPS, OP_BLIT, OP_BEGIN_PASS, OP_END_PASS, OP_VIEWPORT, OP_SCISSOR,
+    OP_BLEND_CONSTANT, OP_STENCIL_REF, OP_PIPELINE, OP_VERTEX_BUFFER,
+    OP_INDEX_BUFFER, OP_SAMPLERS, OP_UNIFORM, OP_DRAW, OP_DRAW_INDEXED,
+} OpKind;
+
+typedef struct {
+    OpKind kind;
+    union {
+        struct { SDL_GPUTransferBuffer *src; uint32_t src_off; SDL_GPUBuffer *dst; uint32_t dst_off, size; } ub;
+        struct { SDL_GPUTransferBuffer *src; uint32_t src_off, row_px, rows; SDL_GPUTexture *dst;
+                 uint32_t level, x, y, w, h, layer; } ut;
+        struct { SDL_GPUTexture *src; uint32_t level, x, y, w, h, layer; SDL_GPUTransferBuffer *dst;
+                 uint32_t dst_off, row_px; } dt;
+        struct { SDL_GPUTexture *src, *dst; uint32_t sl, sx, sy, dl, dx, dy, w, h, src_layer, dst_layer; } ct;
+        struct { SDL_GPUTexture *tex; } mip;
+        struct { SDL_GPUBlitRegion src, dst; int linear, clear; SDL_FColor clear_color; } blit;
+        struct { SDL_GPUColorTargetInfo color; int has_color; SDL_GPUDepthStencilTargetInfo depth; int has_depth; } pass;
+        SDL_GPUViewport viewport;
+        SDL_Rect scissor;
+        SDL_FColor blend;
+        uint8_t stencil_ref;
