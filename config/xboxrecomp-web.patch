+    WGPUTextureDescriptor td = { .usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst,
+        .dimension = WGPUTextureDimension_2D, .size = { 1, 1, 1 }, .format = WGPUTextureFormat_RGBA8Unorm,
+        .mipLevelCount = 1, .sampleCount = 1 };
+    s_dummy_tex = wgpuDeviceCreateTexture(s_dev, &td);
+    s_dummy_view = wgpuTextureCreateView(s_dummy_tex, NULL);
+    td.size.depthOrArrayLayers = 6;
+    s_dummy_cube = wgpuDeviceCreateTexture(s_dev, &td);
+    WGPUTextureViewDescriptor cube_view = { .format = WGPUTextureFormat_RGBA8Unorm,
+        .dimension = WGPUTextureViewDimension_Cube, .mipLevelCount = 1, .arrayLayerCount = 6,
+        .aspect = WGPUTextureAspect_All };
+    s_dummy_cube_view = wgpuTextureCreateView(s_dummy_cube, &cube_view);
+    WGPUSamplerDescriptor sd = { .addressModeU = WGPUAddressMode_ClampToEdge, .addressModeV = WGPUAddressMode_ClampToEdge,
+        .addressModeW = WGPUAddressMode_ClampToEdge, .magFilter = WGPUFilterMode_Nearest,
+        .minFilter = WGPUFilterMode_Nearest, .mipmapFilter = WGPUMipmapFilterMode_Nearest,
