+/* The fixture has glslangValidator for static shaders, but need not have
+ * glslang's optional C library. Compile this real translated program with
+ * the available CLI, then exercise the ordinary SPIRV -> READY cache path. */
+static uint32_t *compile_test_vertex_source(const char *source,size_t *word_count) {
+    char path[]="/tmp/nfl2k5-line-vp-XXXXXX",binary[128];
+    int fd=mkstemp(path);if(fd<0)return 0;
+    FILE *file=fdopen(fd,"wb");
+    if(!source || !file){if(file)fclose(file);else close(fd);unlink(path);return 0;}
+    fputs(source,file);fclose(file);snprintf(binary,sizeof binary,"%s.spv",path);
+    pid_t child=fork();
+    if(child==0){execl(TEST_GLSLANG,TEST_GLSLANG,"-V","--target-env","vulkan1.0","-S","vert","-o",binary,path,(char *)NULL);_exit(127);}
+    int status=0;if(child<0 || waitpid(child,&status,0)!=child || !WIFEXITED(status) || WEXITSTATUS(status)) {unlink(path);unlink(binary);return 0;}
+    file=fopen(binary,"rb");if(!file){unlink(path);return 0;}
+    fseek(file,0,SEEK_END);long size=ftell(file);rewind(file);
+    uint32_t *words=size>0 && size%4==0?malloc((size_t)size):NULL;
+    int ok=words && fread(words,1,(size_t)size,file)==(size_t)size;fclose(file);unlink(path);unlink(binary);
+    if(!ok){free(words);return 0;}
+    *word_count=(size_t)size/4;return words;
+}
+
+static int prepare_test_vertex_program(void) {
+    char *source=sg_vp_translate(s_vp.start,NULL);size_t word_count=0;
+    uint32_t *words=source?compile_test_vertex_source(source,&word_count):NULL;
+    free(source);if(!words)return 0;
+    uint32_t length=0,key=sg_vp_hash(s_vp.start,&length);
+    for(unsigned probe=0;probe<SG_VP_CACHE;probe++) {
+        SgVpProg *p=&s_sg_vp[(key+probe)&(SG_VP_CACHE-1)];
+        if(SDL_GetAtomicInt(&p->state)!=SG_VP_EMPTY)continue;
+        p->key=key;p->start=s_vp.start;p->length=length;
+        memcpy(p->program,s_vp.prog+s_vp.start,length*sizeof p->program[0]);p->inmask=vp_input_mask(s_vp.start);
+        p->spirv=words;p->words=word_count;SDL_SetAtomicInt(&p->state,SG_VP_SPIRV);return 1;
+    }
+    free(words);return 0;
+}
