+    WGPUShaderSourceWGSL src = { .chain = { .sType = WGPUSType_ShaderSourceWGSL }, .code = sv(k_blit_wgsl) };
+    WGPUShaderModuleDescriptor md = { .nextInChain = &src.chain };
