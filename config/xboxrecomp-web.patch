+target_include_directories(test_wasm_fixed PRIVATE ../../src/platform)
+target_compile_options(test_wasm_fixed PRIVATE -pthread)
+target_link_options(test_wasm_fixed PRIVATE -pthread -Wl,--wrap=sbrk -sGLOBAL_BASE=135266304
+    -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=256MB -sMAXIMUM_MEMORY=4GB -sENVIRONMENT=node,worker -sEXIT_RUNTIME=1)
