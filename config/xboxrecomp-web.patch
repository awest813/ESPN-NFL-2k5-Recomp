+void dsp56k_write_memory(dsp_core_t* dsp, int space, uint32_t address, uint32_t value);
+
+/* Interrupt relative functions */
+void dsp56k_add_interrupt(dsp_core_t* dsp, uint16_t inter);
+
+#endif	/* DSP_CPU_H */
