+/* ── Command buffers ──────────────────────────────────────────────────── */
+SDL_GPUCommandBuffer *WG_AcquireGPUCommandBuffer(SDL_GPUDevice *d)
+{
+    (void)d;
+    return (SDL_GPUCommandBuffer *)calloc(1, sizeof(SDL_GPUCommandBuffer));
+}
+
+static void cmd_fail(SDL_GPUCommandBuffer *c, const char *message)
+{
+    if (c) c->failed = 1;
+    SDL_SetError("WebGPU command recording: %s", message);
+}
+
+static Op *push(SDL_GPUCommandBuffer *c, OpKind k)
+{
+    if (!c || c->failed) return NULL;
+    if (c->n == c->cap) {
+        if (c->cap > UINT32_MAX / 2) { cmd_fail(c, "too many commands"); return NULL; }
+        uint32_t cap = c->cap ? c->cap * 2 : 64;
+        if ((size_t)cap > SIZE_MAX / sizeof(Op)) { cmd_fail(c, "command storage overflow"); return NULL; }
+        Op *o = (Op *)realloc(c->ops, cap * sizeof *o);
+        if (!o) { cmd_fail(c, "out of memory"); return NULL; }
+        c->ops = o;
+        c->cap = cap;
+    }
+    Op *o = &c->ops[c->n++];
+    memset(o, 0, sizeof *o);
+    o->kind = k;
+    return o;
+}
+
+/* SDL release relinquishes the application reference. Recorded commands
+ * keep wrappers and upload/readback storage alive through replay, including
+ * cancellation, rejected submissions, and asynchronous readbacks. */
+static void texture_ref(WgTextureStorage *t, int release)
+{
+    if (!t || t->swapchain) return;
+    if (release) texture_storage_drop(t);
+    else atomic_fetch_add(&t->refs, 1);
+}
+static void buffer_ref(WgBufferStorage *b, int release)
+{
+    if (!b) return;
+    if (release) buffer_storage_drop(b);
+    else atomic_fetch_add(&b->refs, 1);
+}
+static void transfer_ref(WgTransferStorage *b, int release)
+{
+    if (!b) return;
+    if (release) transfer_storage_drop(b);
+    else atomic_fetch_add(&b->refs, 1);
+}
+static void do_release_shader(void *p) {
+    SDL_GPUShader *s=p;wgpuShaderModuleRelease(s->mod);free(s);
+}
+void WG_ReleaseGPUShader(SDL_GPUDevice *d,SDL_GPUShader *s) {
+    (void)d;if(s)emscripten_proxy_async(q(),s_server,do_release_shader,s);
+}
+static void do_release_pipeline(void *p) {
+    SDL_GPUGraphicsPipeline *g=p;wgpuRenderPipelineRelease(g->pipe);free(g);
+}
+static void pipeline_drop(SDL_GPUGraphicsPipeline *g) {
+    if(g && atomic_fetch_sub(&g->refs,1)==1)
+        emscripten_proxy_async(q(),s_server,do_release_pipeline,g);
+}
+void WG_ReleaseGPUGraphicsPipeline(SDL_GPUDevice *d,SDL_GPUGraphicsPipeline *g) { (void)d;pipeline_drop(g); }
+
+static void op_resources(const Op *o, int release)
+{
+    switch (o->kind) {
+    case OP_PIPELINE:
+        if(o->pipeline){if(release)pipeline_drop(o->pipeline);else atomic_fetch_add(&o->pipeline->refs,1);}
+        break;
+    case OP_UPLOAD_BUFFER: transfer_ref(o->ub.src, release); buffer_ref(o->ub.dst, release); break;
+    case OP_UPLOAD_TEXTURE: transfer_ref(o->ut.src, release); texture_ref(o->ut.dst, release); break;
+    case OP_DOWNLOAD_TEXTURE: texture_ref(o->dt.src, release); transfer_ref(o->dt.dst, release); break;
+    case OP_COPY_TEXTURE: texture_ref(o->ct.src, release); texture_ref(o->ct.dst, release); break;
+    case OP_MIPMAPS: texture_ref(o->mip.tex, release); break;
+    case OP_BLIT: texture_ref(o->blit.source, release); texture_ref(o->blit.destination, release); break;
+    case OP_BEGIN_PASS:
+        if (o->pass.has_color) texture_ref(o->pass.color_storage, release);
+        if (o->pass.has_depth) texture_ref(o->pass.depth_storage, release);
+        break;
+    case OP_VERTEX_BUFFER: case OP_INDEX_BUFFER: buffer_ref(o->vb.buf, release); break;
+    case OP_SAMPLERS:
+        for (uint32_t i = 0; i < o->samplers.n; i++) {
+            texture_ref(o->samplers.tex[i], release);
+            SDL_GPUSampler *s=o->samplers.smp[i];
+            if(s) {if(release)sampler_drop(s);else atomic_fetch_add(&s->refs,1);}
+        }
+        break;
+    default: break;
+    }
+}
+static void cmd_free(SDL_GPUCommandBuffer *c)
+{
+    for (uint32_t i = 0; i < c->n; i++) op_resources(&c->ops[i], 1);
+    free(c->ops); free(c->uniforms); free(c);
+}
+
+bool WG_CancelGPUCommandBuffer(SDL_GPUCommandBuffer *c) { if (c) cmd_free(c); return true; }
+
+/* Passes are views of their command buffer. */
+SDL_GPUCopyPass *WG_BeginGPUCopyPass(SDL_GPUCommandBuffer *c) { return (SDL_GPUCopyPass *)c; }
+void WG_EndGPUCopyPass(SDL_GPUCopyPass *p) { (void)p; }
+#define CMD(pass) ((SDL_GPUCommandBuffer *)(pass))
+
+void WG_UploadToGPUBuffer(SDL_GPUCopyPass *p, const SDL_GPUTransferBufferLocation *s, const SDL_GPUBufferRegion *d, bool cycle)
+{
+    if (!s || !d || !s->transfer_buffer || !d->buffer ||
+        (uint64_t)s->offset + d->size > s->transfer_buffer->size ||
+        (uint64_t)d->offset + d->size > d->buffer->storage->size ||
+        ((s->offset | d->offset | d->size) & 3u)) {
+        cmd_fail(CMD(p), "invalid buffer upload range or alignment"); return;
+    }
+    Op *o = push(CMD(p), OP_UPLOAD_BUFFER);
+    if (o) {
+        WgBufferStorage *dst = buffer_for_write(d->buffer, cycle);
+        if (!dst) { cmd_fail(CMD(p), "buffer cycling failed"); return; }
+        o->ub = (typeof(o->ub)){ s->transfer_buffer->storage, s->offset, dst, d->offset, d->size };
+        op_resources(o, 0);
+    }
+}
+static int texture_region_valid(SDL_GPUTexture *t, uint32_t level, uint32_t x, uint32_t y,
+                                uint32_t w, uint32_t h, uint32_t layer, uint32_t depth)
+{
+    WgTextureStorage *storage = texture_current(t);
+    if (!storage || storage->swapchain || level >= storage->levels || level >= 32 || layer >= storage->layers ||
+        depth != 1 || !w || !h || is_depth(storage->format)) return 0;
+    uint32_t tw = storage->w >> level, th = storage->h >> level;
+    if (!tw) tw = 1;
+    if (!th) th = 1;
+    return (uint64_t)x + w <= tw && (uint64_t)y + h <= th;
+}
+
+static int transfer_region_valid(SDL_GPUTransferBuffer *buffer, uint32_t offset,
+                                 uint32_t row_px, uint32_t w, uint32_t h)
+{
+    if (!buffer || !w || !h || row_px < w || offset > buffer->size) return 0;
+    uint64_t available = buffer->size - offset, row_bytes = (uint64_t)w * 4;
+    if (row_bytes > available) return 0;
+    return h == 1 || (uint64_t)(h - 1) <= (available - row_bytes) / ((uint64_t)row_px * 4);
+}
+
+void WG_UploadToGPUTexture(SDL_GPUCopyPass *p, const SDL_GPUTextureTransferInfo *s, const SDL_GPUTextureRegion *d, bool cycle)
+{
+    if (!s || !d || !texture_region_valid(d->texture, d->mip_level, d->x, d->y, d->w, d->h, d->layer, d->d) ||
+        !transfer_region_valid(s->transfer_buffer, s->offset, s->pixels_per_row ? s->pixels_per_row : d->w, d->w, d->h)) {
+        cmd_fail(CMD(p), "invalid texture upload region or transfer range"); return;
+    }
+    Op *o = push(CMD(p), OP_UPLOAD_TEXTURE);
+    if (o) {
+        WgTextureStorage *dst = texture_for_write(d->texture, cycle);
+        if (!dst) { cmd_fail(CMD(p), "texture cycling failed"); return; }
+        o->ut = (typeof(o->ut)){ s->transfer_buffer->storage, s->offset, s->pixels_per_row ? s->pixels_per_row : d->w,
+            s->rows_per_layer ? s->rows_per_layer : d->h, dst, d->mip_level, d->x, d->y, d->w, d->h, d->layer };
+        op_resources(o, 0);
+    }
+}
+void WG_DownloadFromGPUTexture(SDL_GPUCopyPass *p, const SDL_GPUTextureRegion *s, const SDL_GPUTextureTransferInfo *d)
+{
+    if (!s || !d || !texture_region_valid(s->texture, s->mip_level, s->x, s->y, s->w, s->h, s->layer, s->d) ||
+        !transfer_region_valid(d->transfer_buffer, d->offset, d->pixels_per_row ? d->pixels_per_row : s->w, s->w, s->h)) {
+        cmd_fail(CMD(p), "invalid texture download region or transfer range"); return;
+    }
+    Op *o = push(CMD(p), OP_DOWNLOAD_TEXTURE);
+    if (o) {
+        o->dt = (typeof(o->dt)){ texture_current(s->texture), s->mip_level, s->x, s->y, s->w, s->h, s->layer, d->transfer_buffer->storage, d->offset,
+                                   d->pixels_per_row ? d->pixels_per_row : s->w };
+        op_resources(o, 0);
+        CMD(p)->has_download = 1;
+    }
+}
+void WG_CopyGPUTextureToTexture(SDL_GPUCopyPass *p, const SDL_GPUTextureLocation *s, const SDL_GPUTextureLocation *d,
+                                Uint32 w, Uint32 h, Uint32 depth, bool cycle)
+{
+    if (!s || !d || !texture_region_valid(s->texture, s->mip_level, s->x, s->y, w, h, s->layer, depth) ||
+        !texture_region_valid(d->texture, d->mip_level, d->x, d->y, w, h, d->layer, depth) ||
+        texture_current(s->texture)->format != texture_current(d->texture)->format) {
+        cmd_fail(CMD(p), "invalid texture copy region or format"); return;
+    }
+    Op *o = push(CMD(p), OP_COPY_TEXTURE);
+    if (o) {
+        WgTextureStorage *src = texture_current(s->texture);
+        texture_ref(src, 0); /* also protects a self-copy while the destination rotates */
+        WgTextureStorage *dst = texture_for_write(d->texture, cycle);
+        if (!dst) { texture_ref(src, 1); cmd_fail(CMD(p), "copy destination cycling failed"); return; }
+        o->ct = (typeof(o->ct)){ src, dst, s->mip_level, s->x, s->y, d->mip_level, d->x, d->y, w, h, s->layer, d->layer };
+        texture_ref(dst, 0);
+    }
+}
+void WG_GenerateMipmapsForGPUTexture(SDL_GPUCommandBuffer *c, SDL_GPUTexture *t)
+{
+    Op *o = push(c, OP_MIPMAPS);
+    if (o) { o->mip.tex = texture_current(t); op_resources(o, 0); }
+}
+void WG_BlitGPUTexture(SDL_GPUCommandBuffer *c, const SDL_GPUBlitInfo *i)
+{
+    Op *o = push(c, OP_BLIT);
+    if (!o) return;
+    WgTextureStorage *src = texture_current(i->source.texture);
+    texture_ref(src, 0);
+    WgTextureStorage *dst = texture_for_write(i->destination.texture, i->cycle);
+    if (!src || !dst) { texture_ref(src, 1); cmd_fail(c, "invalid blit resource or cycling failure"); return; }
+    o->blit = (typeof(o->blit)){ i->source, i->destination, src, dst, i->filter == SDL_GPU_FILTER_LINEAR,
+        i->load_op == SDL_GPU_LOADOP_CLEAR, i->clear_color };
+    o->blit.src.texture = o->blit.dst.texture = NULL; /* replay uses captured storage */
+    texture_ref(dst, 0);
+}
+
+SDL_GPURenderPass *WG_BeginGPURenderPass(SDL_GPUCommandBuffer *c, const SDL_GPUColorTargetInfo *ct, Uint32 n,
+                                         const SDL_GPUDepthStencilTargetInfo *ds)
+{
+    Op *o = push(c, OP_BEGIN_PASS);
+    if (!o) return NULL;
+    if (n) {
+        WgTextureStorage *color = texture_for_write(ct[0].texture, ct[0].cycle && ct[0].load_op != SDL_GPU_LOADOP_LOAD);
+        if (!color) { cmd_fail(c, "color target cycling failed"); return NULL; }
+        texture_ref(color, 0);
+        o->pass.color = ct[0]; o->pass.color.texture = NULL;
+        o->pass.has_color = 1; o->pass.color_storage = color;
+    }
+    if (ds) {
+        bool cycle = ds->cycle && ds->load_op != SDL_GPU_LOADOP_LOAD && ds->stencil_load_op != SDL_GPU_LOADOP_LOAD;
+        WgTextureStorage *depth = texture_for_write(ds->texture, cycle);
+        if (!depth) { cmd_fail(c, "depth target cycling failed"); return NULL; }
+        texture_ref(depth, 0);
+        o->pass.depth = *ds; o->pass.depth.texture = NULL;
+        o->pass.has_depth = 1; o->pass.depth_storage = depth;
+    }
+    return (SDL_GPURenderPass *)c;
+}
+void WG_EndGPURenderPass(SDL_GPURenderPass *p) { push(CMD(p), OP_END_PASS); }
+void WG_SetGPUViewport(SDL_GPURenderPass *p, const SDL_GPUViewport *v) { Op *o = push(CMD(p), OP_VIEWPORT); if (o) o->viewport = *v; }
+void WG_SetGPUScissor(SDL_GPURenderPass *p, const SDL_Rect *r) { Op *o = push(CMD(p), OP_SCISSOR); if (o) o->scissor = *r; }
+void WG_SetGPUBlendConstants(SDL_GPURenderPass *p, SDL_FColor c) { Op *o = push(CMD(p), OP_BLEND_CONSTANT); if (o) o->blend = c; }
+void WG_SetGPUStencilReference(SDL_GPURenderPass *p, Uint8 r) { Op *o = push(CMD(p), OP_STENCIL_REF); if (o) o->stencil_ref = r; }
+void WG_BindGPUGraphicsPipeline(SDL_GPURenderPass *p, SDL_GPUGraphicsPipeline *g) {
+    Op *o=push(CMD(p),OP_PIPELINE);if(o){o->pipeline=g;op_resources(o,0);}
+}
+void WG_BindGPUVertexBuffers(SDL_GPURenderPass *p, Uint32 first, const SDL_GPUBufferBinding *b, Uint32 n)
+{
+    if (first > 8 || n > 8 - first || (n && !b)) {
+        cmd_fail(CMD(p), "invalid vertex buffer binding slots");return;
+    }
+    for (Uint32 i = 0; i < n; i++)
+        if (!b[i].buffer || !b[i].buffer->storage || b[i].offset % 4 || b[i].offset > b[i].buffer->storage->size) {
+            cmd_fail(CMD(p), "invalid vertex buffer binding or offset");return;
+        }
+    for (Uint32 i = 0; i < n; i++) {
+        Op *o = push(CMD(p), OP_VERTEX_BUFFER);
+        if (!o) return;
+        o->vb = (typeof(o->vb)){ b[i].buffer->storage, b[i].offset, first + i };
+        op_resources(o, 0);
