+
+/* Snapshot the surface before a draw samples it. A separate texture also
+ * handles sampling the current target without a framebuffer feedback loop.
+ * Flush before replacing the snapshot, so earlier queued readers finish. */
+static SDL_GPUTexture *sg_surface_sample_copy(SgSurface *s) {
+    sg_queue_flush();
+    if (!s->sample_copy) {
+        uint32_t levels = 1, big = s->w > s->h ? s->w : s->h;
+        while (big > 1) { big >>= 1; levels++; }
+        SDL_GPUTextureCreateInfo info = {
+            .type = SDL_GPU_TEXTURETYPE_2D, .format = SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM,
+            .usage = SDL_GPU_TEXTUREUSAGE_SAMPLER | SDL_GPU_TEXTUREUSAGE_COLOR_TARGET,
+            .width = s->w, .height = s->h, .layer_count_or_depth = 1, .num_levels = levels,
+        };
+        s->sample_copy = SDL_CreateGPUTexture(s_sg.dev, &info);
+        if (!s->sample_copy) return NULL;
+    }
+    SDL_GPUCommandBuffer *cmd = SDL_AcquireGPUCommandBuffer(s_sg.dev);
+    if (!cmd) return NULL;
+    SDL_GPUCopyPass *pass = SDL_BeginGPUCopyPass(cmd);
+    SDL_GPUTextureLocation from = { .texture = s->color }, to = { .texture = s->sample_copy };
+    SDL_CopyGPUTextureToTexture(pass, &from, &to, s->w, s->h, 1, false);
+    SDL_EndGPUCopyPass(pass);
+    SDL_GenerateMipmapsForGPUTexture(cmd, s->sample_copy);
+    if (!SDL_SubmitGPUCommandBuffer(cmd)) return NULL;
+    s_sg_stats.texture_gpu_copies++;
+    return s->sample_copy;
 }

