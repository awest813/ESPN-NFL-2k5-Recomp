diff --git a/src/kernel/nv2a_line.h b/src/kernel/nv2a_line.h
new file mode 100644
index 0000000..a4ef228
--- /dev/null
+++ b/src/kernel/nv2a_line.h
@@ -0,0 +1,68 @@
+#ifndef NFL2K5_NV2A_LINE_H
+#define NFL2K5_NV2A_LINE_H
+#include <math.h>
+#include <stdint.h>
+
+enum {NV_LINE_BATCH=12};
+typedef struct {float value[8][4];} NvLineEndpoint;
+typedef struct {float x,y,index;} NvLineVertex;
+
+/* Xbox captures use an angle-dependent strip: the cross-product bound is
+ * width*(max(|dx|,|dy|)+min(|dx|,|dy|)/2)/2. Extrude normal
+ * to the segment by that bound. This is capture-derived, not a claim that
+ * every endpoint, smoothing and wide-line rule has been established. */
+static inline int line_quad_width(const float a[2],const float b[2],float width,float xy[4][2]) {
+    if(!(width>0) || !isfinite(width))return 0;
+    float dx=b[0]-a[0],dy=b[1]-a[1];
+    if(!isfinite(dx) || !isfinite(dy) || (dx==0 && dy==0) ||
+       fabsf(a[0])>1e6f || fabsf(a[1])>1e6f || fabsf(b[0])>1e6f || fabsf(b[1])>1e6f)return 0;
+    const float *points[4]={a,b,b,a};
+    int axis=fabsf(dx)>=fabsf(dy)?1:0;
+    float squared=dx*dx+dy*dy;
+    if(!isfinite(squared) || squared==0)return 0;
+    float extent=fmaxf(fabsf(dx),fabsf(dy))+0.5f*fminf(fabsf(dx),fabsf(dy));
+    float scale=extent/squared;
+    float normal[2]={-dy*scale,dx*scale};
+    if(normal[axis]<0) {normal[0]=-normal[0];normal[1]=-normal[1];}
+    for(unsigned k=0;k<4;k++) {
+        float side=(k<2?-0.5f:0.5f)*width;
+        xy[k][0]=points[k][0]+side*normal[0];xy[k][1]=points[k][1]+side*normal[1];
+        /* Preserve the previous tie bias for purely axial lines. The
+         * oblique reference strips need no additional translation. */
+        if(dx==0 || dy==0)xy[k][axis]+=1.0f/512.0f;
+    }
+    return 1;
+}
+
+/* Candidate coverage only. Fragment shaders apply the original analytic
+ * strip/cap tests and reconstruct all attributes from unpadded endpoints. */
+static inline int line_cover_quad_width(const float a[2],const float b[2],float width,float xy[4][2]) {
+    if(!line_quad_width(a,b,width,xy))return 0;
+    float dx=b[0]-a[0],dy=b[1]-a[1],length=hypotf(dx,dy);
+    float tangent[2]={dx/length,dy/length},normal[2]={-dy/length,dx/length};
+    int axis=fabsf(dx)>=fabsf(dy)?1:0;
+    if(normal[axis]<0){normal[0]=-normal[0];normal[1]=-normal[1];}
+    const unsigned endpoint[4]={0,1,1,0};
+    for(unsigned k=0;k<4;k++)for(unsigned c=0;c<2;c++)
+        xy[k][c]+=(endpoint[k]?1.0f:-1.0f)*tangent[c]+(k<2?-1.0f:1.0f)*normal[c];
+    return 1;
+}
+static inline int line_quad(const float a[2],const float b[2],float xy[4][2]) {return line_quad_width(a,b,1,xy);}
+static inline int line_cover_quad(const float a[2],const float b[2],float xy[4][2]) {return line_cover_quad_width(a,b,1,xy);}
+
+/* Invalid method data does not wrap into the nine-bit fixed-point state. */
+static inline void nv_line_width_write(uint32_t *state,uint32_t value) {if(value<0x200u)*state=value;}
+
+static inline int line_sample(const float a[2],const float b[2],float width,float x,float y,float *t) {
+    float dx=b[0]-a[0],dy=b[1]-a[1],px=x-a[0],py=y-a[1],squared=dx*dx+dy*dy;
+    if(!(width>0) || !isfinite(width) || !(squared>0) || !isfinite(squared))return 0;
+    if(dx==0)px-=1.0f/512.0f;
+    if(dy==0)py-=1.0f/512.0f;
+    *t=(px*dx+py*dy)/squared;
+    if(!(*t>0 && *t<1))return 0;
+    float cross=dx*py-dy*px;
+    float bound=width*(fmaxf(fabsf(dx),fabsf(dy))+.5f*fminf(fabsf(dx),fabsf(dy)))*.5f;
+    float major=fabsf(dx)>=fabsf(dy)?dx:dy;
+    return fabsf(cross)<bound || (fabsf(cross)==bound && cross*major<0);
+}
+#endif
