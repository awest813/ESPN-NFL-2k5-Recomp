+<!doctype html><html><head><meta charset="utf-8"><title>sdlgpu web</title>
+<style>canvas{position:absolute;left:0;top:0}</style></head>
+<body style="margin:0;background:#222">
+<!-- #canvas: SDL's window. #gpucanvas: the WebGPU device's presentation
+     canvas, handed to the module's main thread at startup. -->
+<canvas id="canvas" width="640" height="480"></canvas>
+<canvas id="gpucanvas" width="640" height="480" hidden></canvas>
+<script src="sdlgpu_web.js"></script>
+<script>
+  window.L = [];
+  (async () => {
+    const adapter = await navigator.gpu?.requestAdapter({powerPreference: 'high-performance'});
+    if (adapter) console.log('WebGPU adapter:', JSON.stringify({
+      vendor: adapter.info?.vendor, architecture: adapter.info?.architecture,
+      device: adapter.info?.device, description: adapter.info?.description,
+    }));
+    await createTest({ canvas: document.getElementById('canvas'),
+      print: (t) => { L.push(t); console.log(t); }, printErr: (t) => { L.push(t); console.log(t); },
+      onAbort: (reason) => { window.testError = String(reason); L.push('FAILED: ' + reason); }
+    });
+  })().catch((error) => { window.testError = String(error); L.push('FAILED: ' + error); console.error(error); });
+</script>
+</body></html>
diff --git a/tests/sdlgpu_web/test_page.js b/tests/sdlgpu_web/test_page.js
new file mode 100644
index 0000000..4691e41
--- /dev/null
+++ b/tests/sdlgpu_web/test_page.js
@@ -0,0 +1,80 @@
+// Runs test_web.c's build in headless Chromium with WebGPU (SwiftShader):
+//   node test_page.js <build dir>
+// Fails on any "FAIL:" line, on WebGPU validation errors the shim reports,
+// and when the presented canvas does not show the frame the test drew.
+'use strict';
+const { chromium } = require('playwright');
+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+
+const DIR = path.resolve(process.argv[2] || 'build');
+const TYPES = { '.html': 'text/html', '.js': 'text/javascript', '.wasm': 'application/wasm' };
+// Cross-origin isolated, as the threads need.
+const server = http.createServer((req, res) => {
+  if (req.url === '/favicon.ico') { res.writeHead(204); res.end(); return; }
+  const file = path.join(DIR, decodeURIComponent(new URL(req.url, 'http://x').pathname).replace(/^\/$/, '/index.html'));
+  if (!file.startsWith(DIR) || !fs.existsSync(file)) { res.writeHead(404); res.end(); return; }
+  res.writeHead(200, { 'Content-Type': TYPES[path.extname(file)] || 'application/octet-stream',
+    'Cross-Origin-Opener-Policy': 'same-origin', 'Cross-Origin-Embedder-Policy': 'require-corp' });
+  fs.createReadStream(file).pipe(res);
+});
+
+(async () => {
+  const started = Date.now();
+  await new Promise((r) => server.listen(0, '127.0.0.1', r));
+  const url = `http://127.0.0.1:${server.address().port}/`;
+  // WebGPU in headless Chromium: SwiftShader's Vulkan, and ANGLE so that
+  // WebGPU canvases are composited (and can be read back).
+  const browser = await chromium.launch({ channel: 'chromium', args: [
+    '--enable-unsafe-webgpu', '--use-gl=angle', '--use-angle=swiftshader',
+    '--enable-features=Vulkan', '--use-vulkan=swiftshader'] });
+  let failures = 0;
+  let page;
+  try {
+    page = await browser.newPage({viewport:{width:800,height:600}});
+    page.on('console', (m) => console.log(`browser ${m.type()}: ${m.text()}`));
+    page.on('requestfailed', (r) => console.log('request failed:', r.url(), r.failure()?.errorText));
+    page.on('pageerror', (e) => { failures++; console.log('pageerror:', e.message); });
+    await page.goto(url);
+    await page.waitForFunction(() => window.L && L.some((l) => /^PRESENTED|SDLGPU-WEB DONE|^FAILED/.test(l)),
+                               null, { timeout: 120000 });
+    // Queue completion and OffscreenCanvas presentation are asynchronous.
+    // Wait for the observable frame instead of guessing a compositor delay.
+    await page.waitForFunction(() => {
+      const c = document.getElementById('gpucanvas');
+      const k = document.createElement('canvas'); k.width = c.width; k.height = c.height;
+      const g = k.getContext('2d'); g.drawImage(c, 0, 0);
+      window.canvasReadback = { hidden: c.hidden, w: c.width, h: c.height,
+               px: Array.from(g.getImageData(c.width >> 1, c.height >> 1, 1, 1).data) };
+      return L.some(l => /^FAILED/.test(l)) ||
+        (!c.hidden && canvasReadback.px.every((value, i) => value === [0,192,48,255][i]));
+    }, null, {timeout:15000, polling:'raf'}).catch(() => {});
+    const canvas = await page.evaluate(() => window.canvasReadback);
+    await page.waitForFunction(() => L.some((l) => /SDLGPU-WEB DONE/.test(l)), null, { timeout: 60000 }).catch(() => {});
+    const log = await page.evaluate(() => L.slice());
+    for (const l of log) console.log(l);
+    failures += log.filter((l) => /^FAIL/.test(l)).length;
+    const errors = log.filter((l) => /\[WebGPU\] (device error|device lost|no device|no adapter|download|fence)/.test(l));
+    if (errors.length) { failures += errors.length; console.log('FAIL: WebGPU reported errors'); }
+    else console.log('ok: no WebGPU validation errors');
+    const ok = !canvas.hidden && canvas.px.every((value, i) => value === [0,192,48,255][i]);
+    if (!ok) failures++;
+    console.log(`${ok ? 'ok' : 'FAIL'}: presented canvas ${canvas.w}x${canvas.h} visible=${!canvas.hidden} centre ${JSON.stringify(canvas.px)} (0,192,48,255 expected)`);
+    if (!log.some((l) => /SDLGPU-WEB DONE rc=0/.test(l))) failures++;
+  } catch (error) {
+    if (page && !page.isClosed()) {
+      console.log('WebGPU failure state:', await page.evaluate(() => ({
+        isolated: crossOriginIsolated, gpu: !!navigator.gpu,
+        log: window.L || [], error: window.testError || null,
+      })).catch(() => 'page unavailable'));
+    }
+    throw error;
+  } finally {
+    await browser.close();
+    server.close();
+  }
+  console.log(failures ? `${failures} failure(s)` : 'sdlgpu web: all checks passed');
+  console.log(`sdlgpu web: elapsed ${Date.now() - started} ms`);
+  process.exit(failures ? 1 : 0);
+})().catch((e) => { console.error(e); process.exit(1); });
diff --git a/tests/sdlgpu_web/test_web.c b/tests/sdlgpu_web/test_web.c
new file mode 100644
index 0000000..aaaafd4
--- /dev/null
+++ b/tests/sdlgpu_web/test_web.c
@@ -0,0 +1,875 @@
+/* The SDL GPU API on WebGPU (src/kernel/sdlgpu/webgpu/), as the SDL GPU
+ * renderer uses it: its formats (B8G8R8A8 targets with a depth-stencil
+ * attachment, R8G8B8A8 textures with mip chains), its shaders (the generated
+ * WGSL), its vertex layout and its pass structure. Pixels are checked against
+ * what the native renderer produces. Run in headless Chromium by
+ * test_page.js, which also checks the presented canvas and that WebGPU
+ * reported no validation errors.
+ *
+ * (tests/sdlgpu_posix drives the renderer itself, but no longer compiles
+ * against it: the renderer reads executor state that test does not stand in
+ * for. This test covers the layer the web build adds.) */
+#include <math.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "kernel/sdlgpu/webgpu/sdl_gpu_webgpu.h"
+#include "kernel/sdlgpu/webgpu/sg_wgsl.h"
+#include "kernel/sdlgpu/sdlgpu_clip.h"
+
+static int fails;
+#define CHECK(c, ...) do { if (!(c)) { fails++; printf("FAIL: " __VA_ARGS__); printf("\n"); } \
+                           else { printf("ok: " __VA_ARGS__); printf("\n"); } } while (0)
+
+typedef struct { float x, y; float color[4]; float uv[3]; } SgVertex;   /* the renderer's flat 2D vertex */
+
+static SDL_GPUDevice *dev;
+static SDL_GPUTextureFormat depth_fmt;
+static SDL_GPUShader *flat_vs, *flat_fs;
+static SDL_GPUSampler *point_wrap;
+
+#define W 320
+#define H 240
+
+static SDL_GPUTexture *make_tex(SDL_GPUTextureFormat f, SDL_GPUTextureUsageFlags u, uint32_t w, uint32_t h, uint32_t levels)
+{
+    SDL_GPUTextureCreateInfo i = { .type = SDL_GPU_TEXTURETYPE_2D, .format = f, .usage = u, .width = w, .height = h,
+                                   .layer_count_or_depth = 1, .num_levels = levels };
+    return SDL_CreateGPUTexture(dev, &i);
+}
+
+static SDL_GPUShader *shader(const char *wgsl, SDL_GPUShaderStage st, Uint32 samplers)
+{
+    SDL_GPUShaderCreateInfo i = { .code = (const Uint8 *)wgsl, .code_size = strlen(wgsl), .entrypoint = "main",
+                                  .format = SDL_GPU_SHADERFORMAT_WGSL, .stage = st, .num_samplers = samplers,
+                                  .num_uniform_buffers = 1 };
+    return SDL_CreateGPUShader(dev, &i);
+}
+
+/* A flat 2D pipeline as sdlgpu_pipeline.inc.c builds one. */
+static SDL_GPUGraphicsPipeline *flat_pipe(int blend, Uint8 write_mask, int depth_test, SDL_GPUCompareOp cmp)
+{
+    SDL_GPUVertexBufferDescription buf = { .slot = 0, .pitch = sizeof(SgVertex), .input_rate = SDL_GPU_VERTEXINPUTRATE_VERTEX };
+    SDL_GPUVertexAttribute a[3] = {
+        { .location = 0, .format = SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, .offset = offsetof(SgVertex, x) },
+        { .location = 1, .format = SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, .offset = offsetof(SgVertex, color) },
+        { .location = 2, .format = SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, .offset = offsetof(SgVertex, uv) },
+    };
+    SDL_GPUColorTargetDescription ct = { .format = SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM, .blend_state = {
+        .enable_blend = blend, .src_color_blendfactor = SDL_GPU_BLENDFACTOR_SRC_ALPHA,
+        .dst_color_blendfactor = SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA, .color_blend_op = SDL_GPU_BLENDOP_ADD,
+        .src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_SRC_ALPHA, .dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA,
+        .alpha_blend_op = SDL_GPU_BLENDOP_ADD, .color_write_mask = write_mask, .enable_color_write_mask = true } };
+    SDL_GPUGraphicsPipelineCreateInfo i = {
+        .vertex_shader = flat_vs, .fragment_shader = flat_fs,
+        .vertex_input_state = { .vertex_buffer_descriptions = &buf, .num_vertex_buffers = 1,
+                                .vertex_attributes = a, .num_vertex_attributes = 3 },
+        .primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST,
+        .rasterizer_state = { .fill_mode = SDL_GPU_FILLMODE_FILL, .cull_mode = SDL_GPU_CULLMODE_NONE,
+                              .front_face = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE },
+        .depth_stencil_state = { .enable_depth_test = depth_test, .enable_depth_write = depth_test,
+                                 .compare_op = depth_test ? cmp : SDL_GPU_COMPAREOP_ALWAYS },
+        .target_info = { .color_target_descriptions = &ct, .num_color_targets = 1,
+                         .depth_stencil_format = depth_fmt, .has_depth_stencil_target = true },
+    };
+    return SDL_CreateGPUGraphicsPipeline(dev, &i);
+}
+
+typedef struct { uint32_t tex_size[2], tex_wrap[2], alpha_test, alpha_func, alpha_ref, pad; } Shade;
+
+static void quad(SgVertex *v, float x0, float y0, float x1, float y1, float u0, float v0, float u1, float v1,
+                 uint32_t argb, int textured)
+{
+    const float c[4] = { ((argb >> 16) & 0xFF) / 255.0f, ((argb >> 8) & 0xFF) / 255.0f, (argb & 0xFF) / 255.0f,
+                         (argb >> 24) / 255.0f };
+    const float p[6][4] = { {x0, y0, u0, v0}, {x1, y0, u1, v0}, {x1, y1, u1, v1},
+                            {x0, y0, u0, v0}, {x1, y1, u1, v1}, {x0, y1, u0, v1} };
+    for (int i = 0; i < 6; i++) {
+        v[i].x = p[i][0]; v[i].y = p[i][1];
+        memcpy(v[i].color, c, sizeof c);
+        v[i].uv[0] = p[i][2]; v[i].uv[1] = p[i][3]; v[i].uv[2] = textured ? 1.0f : 0.0f;
+    }
+}
+
+/* Upload `bytes` into a texture region through a transfer buffer. */
+static void upload(SDL_GPUTexture *t, const void *bytes, uint32_t w, uint32_t h)
+{
+    SDL_GPUTransferBufferCreateInfo ti = { .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD, .size = w * h * 4 };
+    SDL_GPUTransferBuffer *tb = SDL_CreateGPUTransferBuffer(dev, &ti);
+    memcpy(SDL_MapGPUTransferBuffer(dev, tb, false), bytes, w * h * 4);
+    SDL_UnmapGPUTransferBuffer(dev, tb);
+    SDL_GPUCommandBuffer *c = SDL_AcquireGPUCommandBuffer(dev);
+    SDL_GPUCopyPass *cp = SDL_BeginGPUCopyPass(c);
+    SDL_GPUTextureTransferInfo src = { .transfer_buffer = tb };
+    SDL_GPUTextureRegion dst = { .texture = t, .w = w, .h = h, .d = 1 };
+    SDL_UploadToGPUTexture(cp, &src, &dst, false);
+    SDL_EndGPUCopyPass(cp);
+    SDL_SubmitGPUCommandBuffer(c);
+    SDL_ReleaseGPUTransferBuffer(dev, tb);
+}
+
+/* Download a level of a texture as the renderer's sg_download does. */
+static void download_layer(SDL_GPUTexture *t, uint32_t level, uint32_t layer, uint32_t w, uint32_t h, void *out)
+{
+    SDL_GPUTransferBufferCreateInfo ti = { .usage = SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD, .size = w * h * 4 };
+    SDL_GPUTransferBuffer *tb = SDL_CreateGPUTransferBuffer(dev, &ti);
+    SDL_GPUCommandBuffer *c = SDL_AcquireGPUCommandBuffer(dev);
+    SDL_GPUCopyPass *cp = SDL_BeginGPUCopyPass(c);
+    SDL_GPUTextureRegion from = { .texture = t, .mip_level = level, .layer = layer, .w = w, .h = h, .d = 1 };
+    SDL_GPUTextureTransferInfo to = { .transfer_buffer = tb };
+    SDL_DownloadFromGPUTexture(cp, &from, &to);
+    SDL_EndGPUCopyPass(cp);
+    SDL_GPUFence *f = SDL_SubmitGPUCommandBufferAndAcquireFence(c);
+    if (!f || !SDL_WaitForGPUFences(dev, true, &f, 1)) {
+        fails++; printf("FAIL: readback fence: %s\n", SDL_GetError());
+    }
+    SDL_ReleaseGPUFence(dev, f);
+    memcpy(out, SDL_MapGPUTransferBuffer(dev, tb, false), w * h * 4);
+    SDL_UnmapGPUTransferBuffer(dev, tb);
+    SDL_ReleaseGPUTransferBuffer(dev, tb);
+}
+
+static void download(SDL_GPUTexture *t, uint32_t level, uint32_t w, uint32_t h, void *out)
+{
+    download_layer(t, level, 0, w, h, out);
+}
+
+/* One render pass: optional clears, then one draw of `n` vertices, as
+ * sg_queue_flush records it (vertex upload in a copy pass first). */
+typedef struct {
+    SDL_GPUTexture *color, *depth, *tex;
+    SDL_GPUGraphicsPipeline *pipe;
+    const void *v; uint32_t n;
+    uint32_t vertex_stride;
+    const void *fragment_uniforms;
+    uint32_t fragment_size;
+    const SDL_GPUTextureSamplerBinding *bindings;
+    uint32_t binding_count;
+    Shade shade;
+    int passes;
+    int clear_color; uint32_t clear_argb;
+    int clear_depth; float depth_value;
+    SDL_Rect scissor;
+    const SgWindowClip *window_clip;
+} Draw;
+
+static void draw(const Draw *d)
+{
+    static SDL_GPUBuffer *vb;
+    static SDL_GPUTransferBuffer *tb;
+    uint32_t bytes = d->n * (d->vertex_stride ? d->vertex_stride : (uint32_t)sizeof(SgVertex));
+    if (!vb) {
+        SDL_GPUBufferCreateInfo bi = { .usage = SDL_GPU_BUFFERUSAGE_VERTEX, .size = 64 * 116 };
+        SDL_GPUTransferBufferCreateInfo ti = { .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD, .size = 64 * 116 };
+        vb = SDL_CreateGPUBuffer(dev, &bi);
+        tb = SDL_CreateGPUTransferBuffer(dev, &ti);
+    }
+    memcpy(SDL_MapGPUTransferBuffer(dev, tb, true), d->v, bytes);
+    SDL_UnmapGPUTransferBuffer(dev, tb);
+    SDL_GPUCommandBuffer *c = SDL_AcquireGPUCommandBuffer(dev);
+    SDL_GPUCopyPass *cp = SDL_BeginGPUCopyPass(c);
+    SDL_GPUTransferBufferLocation from = { .transfer_buffer = tb };
+    SDL_GPUBufferRegion to = { .buffer = vb, .size = bytes };
+    SDL_UploadToGPUBuffer(cp, &from, &to, true);
+    SDL_EndGPUCopyPass(cp);
+
+    uint32_t a = d->clear_argb;
+    SDL_GPUColorTargetInfo ct = { .texture = d->color, .store_op = SDL_GPU_STOREOP_STORE,
+        .load_op = d->clear_color ? SDL_GPU_LOADOP_CLEAR : SDL_GPU_LOADOP_LOAD,
+        .clear_color = { ((a >> 16) & 0xFF) / 255.0f, ((a >> 8) & 0xFF) / 255.0f, (a & 0xFF) / 255.0f, (a >> 24) / 255.0f } };
+    SDL_GPUDepthStencilTargetInfo ds = { .texture = d->depth, .clear_depth = d->depth_value,
+        .load_op = d->clear_depth ? SDL_GPU_LOADOP_CLEAR : SDL_GPU_LOADOP_LOAD, .store_op = SDL_GPU_STOREOP_STORE,
+        .stencil_load_op = SDL_GPU_LOADOP_CLEAR, .stencil_store_op = SDL_GPU_STOREOP_STORE };
+    for (int pass = 0; pass < (d->passes ? d->passes : 1); pass++) {
+        SDL_GPURenderPass *p = SDL_BeginGPURenderPass(c, &ct, 1, &ds);
+        SDL_GPUViewport vp = { 0, 0, W, H, 0, 1 };
+        SDL_SetGPUViewport(p, &vp);
+        if (d->n) {
+            float size[4] = { W, H, 1.0f, 0.0f };
+            SDL_GPUBufferBinding b = { .buffer = vb };
+            SDL_GPUTextureSamplerBinding ts = { .texture = d->tex, .sampler = point_wrap };
+            SDL_Rect sc = d->scissor.w ? d->scissor : (SDL_Rect){ 0, 0, W, H };
+            SDL_Rect scissors[SG_CLIP_SCISSORS] = {sc};
+            int count = d->window_clip ? sg_clip_scissors(sc, d->window_clip, scissors) : 1;
+            SDL_BindGPUGraphicsPipeline(p, d->pipe);
+            SDL_SetGPUBlendConstants(p, (SDL_FColor){ 0, 0, 0, 0 });
+            SDL_SetGPUStencilReference(p, 0);
+            SDL_BindGPUVertexBuffers(p, 0, &b, 1);
+            for (int repeat = 0; repeat < (d->passes > 1 ? 2 : 1); repeat++) {
+                SDL_BindGPUFragmentSamplers(p, 0, d->bindings ? d->bindings : &ts, d->bindings ? d->binding_count : 1);
+                SDL_PushGPUVertexUniformData(c, 0, size, sizeof size);
+                SDL_PushGPUFragmentUniformData(c, 0, d->fragment_uniforms ? d->fragment_uniforms : &d->shade,
+                                               d->fragment_uniforms ? d->fragment_size : sizeof d->shade);
+            }
+            for (int i = 0; i < count; i++) {
+                SDL_SetGPUScissor(p, &scissors[i]);
+                SDL_DrawGPUPrimitives(p, d->n, 1, 0, 0);
+            }
+        }
+        SDL_EndGPURenderPass(p);
+    }
+    SDL_SubmitGPUCommandBuffer(c);
+}
+
+static uint32_t px(const uint8_t *img, uint32_t x, uint32_t y)   /* BGRA bytes -> 0xAARRGGBB */
+{
+    const uint8_t *p = img + ((size_t)y * W + x) * 4;
+    return (uint32_t)p[3] << 24 | (uint32_t)p[2] << 16 | (uint32_t)p[1] << 8 | p[0];
+}
+static int near(uint32_t a, uint32_t b, int tol)
+{
+    for (int s = 0; s < 32; s += 8)
+        if (abs((int)((a >> s) & 0xFF) - (int)((b >> s) & 0xFF)) > tol) return 0;
+    return 1;
+}
+
+int main(void)
+{
+    static uint8_t img[W * H * 4];
+    puts("SDLGPU-WEB starting device");
+    if (!wg_server_start("gpucanvas")) { printf("FAILED: no WebGPU device\n"); return 2; }
+
+    dev = SDL_CreateGPUDevice(SDL_GPU_SHADERFORMAT_WGSL, false, NULL);
+    CHECK(dev != NULL, "device (driver %s)", dev ? SDL_GetGPUDeviceDriver(dev) : "none");
+    /* A malformed recording must fail atomically; it must not submit the
+     * valid prefix or manufacture a signalled fence for dropped commands. */
+    {
+        uint32_t value = 1;
+        SDL_GPUCommandBuffer *bad = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_PushGPUFragmentUniformData(bad, 0, &value, 1025);
+        CHECK(!SDL_SubmitGPUCommandBuffer(bad), "oversized uniforms reject the whole recording");
+        bad = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_PushGPUVertexUniformData(bad, 0, NULL, 16);
+        CHECK(SDL_SubmitGPUCommandBufferAndAcquireFence(bad) == NULL,
+              "invalid recording cannot return a successful fence");
+        SDL_GPUBufferCreateInfo bi = {.usage=SDL_GPU_BUFFERUSAGE_VERTEX, .size=16};
+        SDL_GPUTransferBufferCreateInfo ti = {.usage=SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD, .size=16};
+        SDL_GPUBuffer *buffer = SDL_CreateGPUBuffer(dev, &bi);
+        SDL_GPUTransferBuffer *transfer = SDL_CreateGPUTransferBuffer(dev, &ti);
+        SDL_GPUTransferBufferLocation src = {.transfer_buffer=transfer, .offset=12};
+        SDL_GPUBufferRegion dst = {.buffer=buffer, .size=8};
+        bad = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_GPUCopyPass *copy = SDL_BeginGPUCopyPass(bad);
+        SDL_UploadToGPUBuffer(copy, &src, &dst, false);
+        SDL_EndGPUCopyPass(copy);
+        CHECK(!SDL_SubmitGPUCommandBuffer(bad), "out-of-range transfer rejects before host memory is read");
+        SDL_ReleaseGPUBuffer(dev, buffer);
+        SDL_ReleaseGPUTransferBuffer(dev, transfer);
+        SDL_ClearError();
+    }
+    {
+        SDL_GPUFence *fences[2];
+        for (int i = 0; i < 2; i++)
+            fences[i] = SDL_SubmitGPUCommandBufferAndAcquireFence(SDL_AcquireGPUCommandBuffer(dev));
+        CHECK(fences[0] && fences[1] && fences[0] != fences[1], "submissions receive independent completion fences");
+        CHECK(SDL_WaitForGPUFences(dev, false, fences, 2), "wait-any observes real queue completion");
+        CHECK(SDL_WaitForGPUFences(dev, true, fences, 2), "wait-all observes both queue completions");
+        for (int i = 0; i < 2; i++) SDL_ReleaseGPUFence(dev, fences[i]);
+        for (int i = 0; i < 32; i++) {
+            SDL_GPUFence *pending = SDL_SubmitGPUCommandBufferAndAcquireFence(SDL_AcquireGPUCommandBuffer(dev));
+            CHECK(pending != NULL, "early-release fence %d created", i);
+            SDL_ReleaseGPUFence(dev, pending);
+        }
+        SDL_GPUFence *last = SDL_SubmitGPUCommandBufferAndAcquireFence(SDL_AcquireGPUCommandBuffer(dev));
+        CHECK(last && SDL_WaitForGPUFences(dev, true, &last, 1), "queue remains usable after early fence release");
+        SDL_ReleaseGPUFence(dev, last);
+    }
+    CHECK(SDL_CreateGPUDevice(SDL_GPU_SHADERFORMAT_SPIRV, false, NULL) == NULL, "SPIR-V-only device refused");
+    depth_fmt = SDL_GPUTextureSupportsFormat(dev, SDL_GPU_TEXTUREFORMAT_D32_FLOAT_S8_UINT, SDL_GPU_TEXTURETYPE_2D,
+                                             SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET)
+                ? SDL_GPU_TEXTUREFORMAT_D32_FLOAT_S8_UINT : SDL_GPU_TEXTUREFORMAT_D24_UNORM_S8_UINT;
+
+    flat_vs = shader(k_sg_flat2d_vert_wgsl, SDL_GPU_SHADERSTAGE_VERTEX, 0);
+    flat_fs = shader(k_sg_flat2d_frag_wgsl, SDL_GPU_SHADERSTAGE_FRAGMENT, 1);
+    SDL_GPUShader *xvs = shader(k_sg_xf_vert_wgsl, SDL_GPU_SHADERSTAGE_VERTEX, 0);
+    SDL_GPUShader *xfs = shader(k_sg_xf_frag_wgsl, SDL_GPU_SHADERSTAGE_FRAGMENT, 8);
+    CHECK(flat_vs && flat_fs && xvs && xfs, "the renderer's four WGSL shaders load");
+    SDL_GPUSamplerCreateInfo si = { .min_filter = SDL_GPU_FILTER_NEAREST, .mag_filter = SDL_GPU_FILTER_NEAREST,
+        .mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_NEAREST, .address_mode_u = SDL_GPU_SAMPLERADDRESSMODE_REPEAT,
+        .address_mode_v = SDL_GPU_SAMPLERADDRESSMODE_REPEAT, .address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE };
+    point_wrap = SDL_CreateGPUSampler(dev, &si);
+
+    SDL_GPUTexture *color = make_tex(SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM,
+                                     SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER, W, H, 1);
+    SDL_GPUTexture *depth = make_tex(depth_fmt, SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET, W, H, 1);
+    CHECK(color && depth, "surface: B8G8R8A8 colour and depth-stencil (%s)",
+          depth_fmt == SDL_GPU_TEXTUREFORMAT_D32_FLOAT_S8_UINT ? "D32_FLOAT_S8_UINT" : "D24_UNORM_S8_UINT");
+
+    {
+        SDL_GPUTexture *small = make_tex(SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM,
+            SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER, 1, 2, 1);
+        SDL_GPUTransferBufferCreateInfo info = {.usage=SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD, .size=16};
+        SDL_GPUTransferBuffer *transfer = SDL_CreateGPUTransferBuffer(dev, &info);
+        uint32_t *data = SDL_MapGPUTransferBuffer(dev, transfer, false);
+        data[0] = 0xFF010203u; data[3] = 0xFF040506u;
+        SDL_UnmapGPUTransferBuffer(dev, transfer);
+        SDL_GPUTextureTransferInfo src = {.transfer_buffer=transfer, .pixels_per_row=3};
+        SDL_GPUTextureRegion region = {.texture=small, .w=1, .h=2, .d=1};
+        SDL_GPUCommandBuffer *command = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_GPUCopyPass *copy = SDL_BeginGPUCopyPass(command);
