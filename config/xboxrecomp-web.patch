+/* Select the final endpoint slot as well as slot zero; no preceding slot
+ * carries usable geometry. Keep baseline single-line probes independent. */
+static void draw_batched_line_probe(const Draw *source,int xf,int blend,int depth_test,
+    const void *base,const NvLineEndpoint endpoints[2],const float params[4]) {
+    union {
+        struct {uint32_t base[12];NvLineEndpoint endpoints[NV_LINE_BATCH][2];float params[4];} flat;
+        struct {uint32_t base[128];NvLineEndpoint endpoints[NV_LINE_BATCH][2];float params[4];} transformed;
+    } uniform={0};
+    void *data=xf?(void *)&uniform.transformed:(void *)&uniform.flat;
+    memcpy(data,base,xf?512:48);
+    memcpy(xf?uniform.transformed.endpoints[NV_LINE_BATCH-1]:uniform.flat.endpoints[NV_LINE_BATCH-1],endpoints,2*sizeof *endpoints);
+    memcpy(xf?uniform.transformed.params:uniform.flat.params,params,16);
+    NvLineVertex vertices[6];
+    for(unsigned k=0;k<6;k++) {
+        const float *v=(const float *)((const uint8_t *)source->v+k*(source->vertex_stride?source->vertex_stride:sizeof(SgVertex)));
+        vertices[k]=(NvLineVertex){v[0],v[1],NV_LINE_BATCH-1};
+    }
+    SDL_GPUGraphicsPipeline *pipe=line_batch_pipe(xf,blend,depth_test);
+    CHECK(pipe!=NULL,"batched line material pipeline");
+    if(pipe){Draw d=*source;d.pipe=pipe;d.v=vertices;d.vertex_stride=sizeof vertices[0];d.fragment_uniforms=data;
+        d.fragment_size=xf?sizeof uniform.transformed:sizeof uniform.flat;draw(&d);SDL_ReleaseGPUGraphicsPipeline(dev,pipe);}
+}
+static void draw_batched_line_width_references(SDL_GPUTexture *color,SDL_GPUTexture *depth,SDL_GPUTexture *white,
+    SDL_GPUGraphicsPipeline *pipe,const void *shade,int xf) {
+    union {
+        struct {uint32_t base[12];NvLineEndpoint endpoint[NV_LINE_BATCH][2];float params[4];} flat;
+        struct {uint32_t base[128];NvLineEndpoint endpoint[NV_LINE_BATCH][2];float params[4];} transformed;
+    } uniform={0};
+    NvLineEndpoint (*ends)[2]=xf?uniform.transformed.endpoint:uniform.flat.endpoint;
+    float *params=xf?uniform.transformed.params:uniform.flat.params;
+    void *data=xf?(void *)&uniform.transformed:(void *)&uniform.flat;
+    unsigned bytes=xf?sizeof uniform.transformed:sizeof uniform.flat;
+    if(shade)memcpy(data,shade,xf?512:48);
+    params[0]=xf?1:0;
+    uint32_t *pixels=malloc(640*480*4);CHECK(pixels!=NULL,"line width reference readback storage");if(!pixels)return;
+    const unsigned corners[6]={0,1,2,0,2,3};
+    for(unsigned ci=0;ci<sizeof line_width_references/sizeof *line_width_references;ci++) {
+        const LineWidthReference *r=&line_width_references[ci];float width=r->expected_width/8.0f;params[1]=width;
+        NvLineVertex vertices[16*6]={0};
+        Draw d={.color=color,.depth=depth,.tex=white,.pipe=pipe,.v=vertices,.n=0,
+            .vertex_stride=sizeof vertices[0],.fragment_uniforms=data,.fragment_size=bytes,
+            .clear_color=1,.clear_argb=0xFF202224u,.clear_depth=1,.depth_value=1,.viewport_w=640,.viewport_h=480};
+        draw(&d);d.n=0;d.clear_color=d.clear_depth=0;
+        unsigned count=0;
+        for(unsigned edge=0;edge<16;edge++) {
+            float p[2][2],xy[4][2];
+            for(unsigned endpoint=0;endpoint<2;endpoint++) {
+                unsigned k=(edge+endpoint)%16;NvLineEndpoint *e=&ends[count][endpoint];memset(e,0,sizeof *e);
+                p[endpoint][0]=truncf((160+line_reference_xy[k][0])*16)/16;
+                p[endpoint][1]=truncf((48+line_reference_xy[k][1])*16)/16;
+                e->value[0][0]=p[endpoint][0];e->value[0][1]=p[endpoint][1];e->value[0][2]=.25f;e->value[0][3]=1;
+                for(unsigned c=0;c<4;c++)e->value[1][c]=(float)((line_reference_palette[k%8]>>(c*8))&255)/255;
+                e->value[7][0]=1;
+            }
+            if(!line_cover_quad_width(p[0],p[1],width,xy))continue;
+            for(unsigned k=0;k<6;k++)vertices[d.n++]=(NvLineVertex){xy[corners[k]][0],xy[corners[k]][1],(float)count};
+            count++;if(count==NV_LINE_BATCH){draw(&d);d.n=0;count=0;}
+        }
+        if(d.n)draw(&d);
+        download(color,0,640,480,pixels);check_line_width_reference(pixels,r,xf?"3D batched":"2D batched");
+    }
+    free(pixels);
+}
+static void draw_line_width_references(SDL_GPUTexture *color,SDL_GPUTexture *depth,SDL_GPUTexture *white,
+    SDL_GPUGraphicsPipeline *pipe,const void *shade,int xf) {
+    union {
+        struct {uint32_t base[12];NvLineEndpoint endpoint[2];float params[4];} flat;
+        struct {uint32_t base[128];NvLineEndpoint endpoint[2];float params[4];} transformed;
+    } uniform={0};
+    NvLineEndpoint *ends=xf?uniform.transformed.endpoint:uniform.flat.endpoint;
+    float *params=xf?uniform.transformed.params:uniform.flat.params;
+    void *data=xf?(void *)&uniform.transformed:(void *)&uniform.flat;
+    unsigned bytes=xf?sizeof uniform.transformed:sizeof uniform.flat;
