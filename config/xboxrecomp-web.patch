+/* ── Proxying ─────────────────────────────────────────────────────────── */
+static em_proxying_queue *q(void) { return emscripten_proxy_get_system_queue(); }
+
+static void run_sync(void (*fn)(void *), void *arg)
+{
+    if (pthread_equal(pthread_self(), s_server)) fn(arg);
+    else emscripten_proxy_sync(q(), s_server, fn, arg);
+}
+static void run_sync_ctx(void (*fn)(em_proxying_ctx *, void *), void *arg)
+{
+    emscripten_proxy_sync_with_ctx(q(), s_server, fn, arg);
+}
+
+static WGPUStringView sv(const char *s) { WGPUStringView v = { s, WGPU_STRLEN }; return v; }
+
+static void report(const char *what, WGPUStringView msg)
+{
+    static int told;
+    if (told++ < 20)
+        fprintf(stderr, "  [WebGPU] %s: %.*s\n", what, (int)msg.length, msg.data ? msg.data : "");
+}
+
+/* ── Server thread and device ────────────────────────────────────────── */
+static void *server_main(void *arg)
+{
+    (void)arg;
+    emscripten_exit_with_live_runtime();   /* serve proxied calls from the event loop */
+    return NULL;
+}
+
+static void on_error(WGPUDevice const *d, WGPUErrorType type, WGPUStringView msg, void *u1, void *u2)
+{
+    (void)d; (void)u1; (void)u2;
+    char what[32];
+    snprintf(what, sizeof what, "device error %d", (int)type);
+    report(what, msg);
+}
+
+static void on_lost(WGPUDevice const *d, WGPUDeviceLostReason r, WGPUStringView msg, void *u1, void *u2)
+{
+    (void)d; (void)u1; (void)u2;
+    if (r != WGPUDeviceLostReason_Destroyed) report("device lost", msg);
+}
+
+static WGPUBindGroupLayout make_bgl(const WGPUBindGroupLayoutEntry *e, size_t n)
+{
+    WGPUBindGroupLayoutDescriptor d = { .entryCount = n, .entries = e };
+    return wgpuDeviceCreateBindGroupLayout(s_dev, &d);
+}
+
+static WGPUBindGroup material_group(SDL_GPUTexture *const *tex, SDL_GPUSampler *const *smp)
+{
+    uint32_t hash = 2166136261u;
+    for (uint32_t i = 0; i < WG_MAX_SAMPLERS; i++) {
+        hash = (hash ^ (uint32_t)(uintptr_t)tex[i]) * 16777619u;
+        hash = (hash ^ (uint32_t)(uintptr_t)smp[i]) * 16777619u;
+    }
+    hash ^= hash >> 16;
+    WgBindCache *entry = &s_bind_cache[hash & (WG_BIND_CACHE - 1)];
+    if (entry->group && memcmp(entry->textures, tex, sizeof entry->textures) == 0
+        && memcmp(entry->samplers, smp, sizeof entry->samplers) == 0)
+        return entry->group;
+    WGPUBindGroupEntry e[2 * WG_MAX_SAMPLERS];
+    for (uint32_t i = 0; i < WG_MAX_SAMPLERS; i++) {
+        e[i] = (WGPUBindGroupEntry){ .binding = i,
+            .textureView = tex[i] && tex[i]->view ? tex[i]->view : (i >= 4 ? s_dummy_cube_view : s_dummy_view) };
+        e[WG_MAX_SAMPLERS + i] = (WGPUBindGroupEntry){ .binding = WG_MAX_SAMPLERS + i,
+            .sampler = smp[i] ? smp[i]->s : s_dummy_sampler };
+    }
+    WGPUBindGroupDescriptor bd = { .layout = s_bgl[2], .entryCount = 2 * WG_MAX_SAMPLERS, .entries = e };
+    if (entry->group) wgpuBindGroupRelease(entry->group);
+    entry->group = wgpuDeviceCreateBindGroup(s_dev, &bd);
+    memcpy(entry->textures, tex, sizeof entry->textures);
+    memcpy(entry->samplers, smp, sizeof entry->samplers);
+    return entry->group;
+}
