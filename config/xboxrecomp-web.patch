+ * and WasmFS, even though creating a new save through absolute paths works. */
+static BOOL translate_obj_path(PXBOX_OBJECT_ATTRIBUTES attributes,
+                               char *out, DWORD size)
+{
+    const char *name = get_xbox_path(attributes);
+    if (!name || !out || !size) return FALSE;
+    if (attributes->RootDirectory && name[0] != '\\' && name[0] != '/' &&
+        !(name[0] && name[1] == ':')) {
+        const char *base = w32_handle_path(attributes->RootDirectory);
+        struct stat st;
+        int fd = w32_handle_fd(attributes->RootDirectory);
+        char joined[MAX_PATH];
+        if (!base || fd < 0 || fstat(fd, &st) || !S_ISDIR(st.st_mode)) return FALSE;
+        int used = snprintf(joined, sizeof joined, "%s/%s", base, name);
+        if (used < 0 || (size_t)used >= sizeof joined || (DWORD)used >= size) return FALSE;
+        /* The absolute host path takes the normal separator/case resolver. */
+        return xbox_translate_path(joined, out, size);
