+++ b/tests/sdlgpu_web/CMakeLists.txt
@@ -0,0 +1,20 @@
+# Emscripten only: the SDL GPU renderer on WebGPU, in headless Chromium.
+#   emcmake cmake -S . -B build -DSDL3_DIR=<sdl3-wasm>/lib/cmake/SDL3 -DCMAKE_C_FLAGS=-pthread
+#   cmake --build build && node test_page.js build
+cmake_minimum_required(VERSION 3.20)
+project(sdlgpu_web C CXX)
+find_package(SDL3 REQUIRED CONFIG)
+get_filename_component(SRC "${CMAKE_CURRENT_SOURCE_DIR}/../../src" ABSOLUTE)
+add_executable(sdlgpu_web test_web.c "${SRC}/kernel/sdlgpu/webgpu/sdl_gpu_webgpu.c")
+target_include_directories(sdlgpu_web PRIVATE "${SRC}")
+target_compile_definitions(sdlgpu_web PRIVATE SG_HAVE_SHADERS=1)
+target_compile_options(sdlgpu_web PRIVATE --use-port=emdawnwebgpu -Wall -Wno-unused-function)
+target_link_libraries(sdlgpu_web PRIVATE SDL3::SDL3 m)
+target_link_options(sdlgpu_web PRIVATE --use-port=emdawnwebgpu -pthread -sPROXY_TO_PTHREAD -sPTHREAD_POOL_SIZE=8
+    -sOFFSCREENCANVAS_SUPPORT=1 "-sOFFSCREENCANVASES_TO_PTHREAD=#gpucanvas"
+    -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=256MB -sMAXIMUM_MEMORY=2GB
+    -sMODULARIZE=1 -sEXPORT_NAME=createTest -sENVIRONMENT=web,worker -sEXIT_RUNTIME=0)
+set_target_properties(sdlgpu_web PROPERTIES SUFFIX ".js" LINKER_LANGUAGE CXX)
+add_custom_target(sdlgpu_web_page ALL
+  COMMAND "${CMAKE_COMMAND}" -E copy "${CMAKE_CURRENT_SOURCE_DIR}/index.html" "${CMAKE_BINARY_DIR}" VERBATIM)
+add_dependencies(sdlgpu_web sdlgpu_web_page)
