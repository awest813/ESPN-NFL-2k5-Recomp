+                .filter = SDL_GPU_FILTER_NEAREST, .cycle = true};
+            SDL_BlitGPUTexture(change, &info);
+        } else {
+            SDL_GPUColorTargetInfo ct = {.texture = target, .load_op = SDL_GPU_LOADOP_CLEAR,
+                .store_op = SDL_GPU_STOREOP_STORE, .clear_color = {0,0,1,1}, .cycle = true};
+            SDL_GPURenderPass *pass = SDL_BeginGPURenderPass(change, &ct, 1, NULL);
+            SDL_EndGPURenderPass(pass);
+        }
+        SDL_GPUCommandBuffer *fresh = SDL_AcquireGPUCommandBuffer(dev);
+        cp = SDL_BeginGPUCopyPass(fresh); from.texture = target; to.texture = after;
+        SDL_CopyGPUTextureToTexture(cp, &from, &to, 1, 1, 1, false); SDL_EndGPUCopyPass(cp);
+        SDL_ReleaseGPUTexture(dev, target); SDL_ReleaseGPUTexture(dev, blue);
+        CHECK(SDL_SubmitGPUCommandBuffer(change) && SDL_SubmitGPUCommandBuffer(fresh) && SDL_SubmitGPUCommandBuffer(old),
+            "%s cycles a bound destination after public handle release", names[mode]);
+        download(before, 0, 1, 1, &pixel);
+        CHECK(pixel == red_pixel, "%s preserves the old destination contents", names[mode]);
+        download(after, 0, 1, 1, &pixel);
+        CHECK(pixel == blue_pixel, "%s exposes the new destination contents", names[mode]);
+        SDL_ReleaseGPUTexture(dev, before); SDL_ReleaseGPUTexture(dev, after);
+    }
+    {
+        SDL_GPUTexture *z = make_tex(depth_fmt, SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET, W, H, 1);
+        SDL_GPUTexture *before = make_tex(SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM,
+            SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER, W, H, 1);
+        SDL_GPUTexture *after = make_tex(SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM,
+            SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER, W, H, 1);
+        SDL_GPUCommandBuffer *seed = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_GPUDepthStencilTargetInfo ds = {.texture = z, .clear_depth = 1, .load_op = SDL_GPU_LOADOP_CLEAR,
+            .store_op = SDL_GPU_STOREOP_STORE, .stencil_load_op = SDL_GPU_LOADOP_CLEAR,
+            .stencil_store_op = SDL_GPU_STOREOP_STORE};
+        SDL_GPURenderPass *pass = SDL_BeginGPURenderPass(seed, NULL, 0, &ds); SDL_EndGPURenderPass(pass);
+        CHECK(SDL_SubmitGPUCommandBuffer(seed), "seed original depth backing");
+        SgVertex red[6]; quad(red, 0, 0, W, H, 0, 0, 0, 0, 0xFFFF0000u, 0);
+        SDL_GPUGraphicsPipeline *less = flat_pipe(0, 15, 1, SDL_GPU_COMPAREOP_LESS);
+        Draw a = {.color = before, .depth = z, .tex = white, .pipe = less, .v = red, .n = 6,
+            .clear_color = 1, .clear_argb = 0xFF000000u};
+        SDL_GPUCommandBuffer *old = record_draw(&a);
+        SDL_GPUCommandBuffer *change = SDL_AcquireGPUCommandBuffer(dev);
+        ds.clear_depth = 0; ds.cycle = true;
+        pass = SDL_BeginGPURenderPass(change, NULL, 0, &ds); SDL_EndGPURenderPass(pass);
+        CHECK(SDL_SubmitGPUCommandBuffer(change), "cycle a bound depth-stencil destination");
+        a.color = after; draw(&a);
+        SDL_ReleaseGPUTexture(dev, z);
+        CHECK(SDL_SubmitGPUCommandBuffer(old), "old depth attachment survives public handle release");
+        download(before, 0, W, H, img);
+        CHECK(px(img, W/2, H/2) == 0xFFFF0000u, "old depth version accepts the red draw");
+        download(after, 0, W, H, img);
+        CHECK(px(img, W/2, H/2) == 0xFF000000u, "new depth version rejects the red draw");
+        SDL_ReleaseGPUTexture(dev, before); SDL_ReleaseGPUTexture(dev, after);
+    }
+
+    {
+        SgVertex vertices[12]; uint32_t indices[6] = {0,1,2,3,4,5};
+        quad(vertices, 0, 0, W, H, 0, 0, 0, 0, 0xFFFF0000u, 0);
+        quad(vertices + 6, 0, 0, W, H, 0, 0, 0, 0, 0xFF0000FFu, 0);
+        SDL_GPUBufferCreateInfo bi = {.usage = SDL_GPU_BUFFERUSAGE_VERTEX, .size = sizeof vertices};
+        SDL_GPUBuffer *vb = SDL_CreateGPUBuffer(dev, &bi);
+        bi.usage = SDL_GPU_BUFFERUSAGE_INDEX; bi.size = sizeof indices;
+        SDL_GPUBuffer *ib = SDL_CreateGPUBuffer(dev, &bi);
+        SDL_GPUTransferBufferCreateInfo ti = {.usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+            .size = sizeof vertices + sizeof indices};
+        SDL_GPUTransferBuffer *tb = SDL_CreateGPUTransferBuffer(dev, &ti);
+        uint8_t *bytes = SDL_MapGPUTransferBuffer(dev, tb, false);
+        memcpy(bytes, vertices, sizeof vertices); memcpy(bytes + sizeof vertices, indices, sizeof indices);
+        SDL_UnmapGPUTransferBuffer(dev, tb);
+        SDL_GPUCommandBuffer *seed = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_GPUCopyPass *cp = SDL_BeginGPUCopyPass(seed);
+        SDL_GPUTransferBufferLocation from = {.transfer_buffer = tb};
+        SDL_GPUBufferRegion to = {.buffer = vb, .size = sizeof vertices};
+        SDL_UploadToGPUBuffer(cp, &from, &to, false);
+        from.offset = sizeof vertices; to.buffer = ib; to.size = sizeof indices;
+        SDL_UploadToGPUBuffer(cp, &from, &to, false); SDL_EndGPUCopyPass(cp);
+        CHECK(SDL_SubmitGPUCommandBuffer(seed), "seed indexed destination versions");
+        SDL_GPUTexture *before = make_tex(SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM,
+            SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER, W, H, 1);
+        SDL_GPUTexture *after = make_tex(SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM,
+            SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER, W, H, 1);
+        SDL_GPUCommandBuffer *old = record_indexed_binding(before, depth, opaque, vb, ib, white);
+        for (int i=0;i<6;i++) indices[i] += 6;
+        bytes = SDL_MapGPUTransferBuffer(dev, tb, true);
+        memcpy(bytes + sizeof vertices, indices, sizeof indices); SDL_UnmapGPUTransferBuffer(dev, tb);
+        SDL_GPUCommandBuffer *change = SDL_AcquireGPUCommandBuffer(dev); cp = SDL_BeginGPUCopyPass(change);
+        SDL_UploadToGPUBuffer(cp, &from, &to, true); SDL_EndGPUCopyPass(cp);
+        CHECK(SDL_SubmitGPUCommandBuffer(change), "cycle a bound index buffer destination");
+        SDL_GPUCommandBuffer *fresh = record_indexed_binding(after, depth, opaque, vb, ib, white);
+        SDL_ReleaseGPUBuffer(dev, vb); SDL_ReleaseGPUBuffer(dev, ib); SDL_ReleaseGPUTransferBuffer(dev, tb);
+        CHECK(SDL_SubmitGPUCommandBuffer(fresh) && SDL_SubmitGPUCommandBuffer(old), "old and new index bindings survive public handle release");
+        download(before, 0, W, H, img);
+        CHECK(px(img, W/2, H/2) == 0xFFFF0000u, "old index backing selects the red vertices");
+        download(after, 0, W, H, img);
+        CHECK(px(img, W/2, H/2) == 0xFF0000FFu, "new index backing selects the blue vertices");
+        SDL_ReleaseGPUTexture(dev, before); SDL_ReleaseGPUTexture(dev, after);
+    }
+
+    /* 10. Presenting: copy the flipped target to a sampled texture, then
+     * acquire the canvas texture and blit the copy. */
+    {
+        quad(v, W / 4, H / 4, 3 * W / 4, 3 * H / 4, 0, 0, 0, 0, 0xFF00C030u, 0);
+        d = (Draw){ .color = color, .depth = depth, .tex = white, .pipe = opaque, .v = v, .n = 6,
+                    .clear_color = 1, .clear_argb = 0xFF000000u, .clear_depth = 1, .depth_value = 1.0f };
+        draw(&d);
+        SDL_GPUTextureCreateInfo frame_info = {
+            .type = SDL_GPU_TEXTURETYPE_2D, .format = SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM,
+            .usage = SDL_GPU_TEXTUREUSAGE_SAMPLER, .width = W, .height = H,
+            .layer_count_or_depth = 1, .num_levels = 1,
+        };
+        SDL_GPUTexture *frame_texture = SDL_CreateGPUTexture(dev, &frame_info);
+        SDL_GPUCommandBuffer *copy_cmd = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_GPUCopyPass *copy = SDL_BeginGPUCopyPass(copy_cmd);
+        SDL_GPUTextureLocation src = { .texture = color };
+        SDL_GPUTextureLocation dst = { .texture = frame_texture };
+        SDL_CopyGPUTextureToTexture(copy, &src, &dst, W, H, 1, false);
+        SDL_EndGPUCopyPass(copy);
+        SDL_SubmitGPUCommandBuffer(copy_cmd);
+        download(frame_texture, 0, W, H, img);
+        CHECK(px(img, W / 2, H / 2) == 0xFF00C030u, "flipped target copied to sampled texture");
+        CHECK(px(img, 0, 0) == 0xFF000000u, "source has a distinct overscan border");
+        SDL_GPUBlitInfo crop = {
+            .source = { .texture = frame_texture, .x = W / 4, .y = H / 4, .w = W / 2, .h = H / 2 },
+            .destination = { .texture = color, .w = W, .h = H },
+            .load_op = SDL_GPU_LOADOP_CLEAR, .filter = SDL_GPU_FILTER_LINEAR,
+        };
+        SDL_GPUCommandBuffer *crop_cmd = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_BlitGPUTexture(crop_cmd, &crop);
+        SDL_SubmitGPUCommandBuffer(crop_cmd);
+        download(color, 0, W, H, img);
+        CHECK(px(img, 0, 0) == 0xFF00C030u && px(img, W - 1, H - 1) == 0xFF00C030u,
+              "scaled source rectangle excludes the overscan border at both corners");
+        wg_set_present_aspect(16.0f / 9.0f);
+        CHECK(SDL_ClaimWindowForGPUDevice(dev, NULL), "claim the window (the GPU canvas)");
+        for (int frame = 0; frame < 3; frame++) {
+            wg_set_present_aspect(frame == 1 ? 0 : 16.0f / 9.0f);
+            SDL_GPUCommandBuffer *c = SDL_AcquireGPUCommandBuffer(dev);
+            SDL_GPUTexture *swap = NULL;
+            Uint32 sw = 0, sh = 0;
+            SDL_WaitAndAcquireGPUSwapchainTexture(c, NULL, &swap, &sw, &sh);
+            CHECK(sw == 640 && sh == (frame == 1 ? 480 : 360),
+                  "canvas follows live aspect changes (frame %d)", frame);
+            SDL_GPUBlitInfo b = { .source = crop.source,
+                                  .destination = { .texture = swap, .x = 0, .y = 0, .w = sw, .h = sh },
+                                  .load_op = SDL_GPU_LOADOP_CLEAR, .clear_color = { 0, 0, 0, 1 }, .filter = SDL_GPU_FILTER_NEAREST };
+            SDL_BlitGPUTexture(c, &b);
+            SDL_GPUFence *presented = SDL_SubmitGPUCommandBufferAndAcquireFence(c);
+            CHECK(presented && SDL_WaitForGPUFences(dev, true, &presented, 1), "presented frame %d completes on the queue", frame);
+            SDL_ReleaseGPUFence(dev, presented);
+        }
+        printf("PRESENTED 00C030\n");   /* test_page.js reads the canvas now */
+    }
+
+    printf("%s (%d failures)\n", fails ? "FAILED" : "ALL PASS", fails);
+    printf("SDLGPU-WEB DONE rc=%d\n", fails != 0);
+    return fails != 0;
+}
