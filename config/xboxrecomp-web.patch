+        CHECK(!SDL_SubmitGPUCommandBuffer(command), "failed recording discards its valid upload prefix");
+        download(small, 0, 1, 2, bytes);
+        CHECK(bytes[0] == 0xFF010203u, "rejected recording leaves the texture unchanged");
