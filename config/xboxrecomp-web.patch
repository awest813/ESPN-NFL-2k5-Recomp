new file mode 100644
index 0000000..a3ffcc0
--- /dev/null
+++ b/src/video/present_layout.h
@@ -0,0 +1,57 @@
+#ifndef XBOXRECOMP_PRESENT_LAYOUT_H
+#define XBOXRECOMP_PRESENT_LAYOUT_H
+#include <stdint.h>
+enum { XBOX_PRESENT_ORIGINAL, XBOX_PRESENT_STRETCH, XBOX_PRESENT_16_9,
+       XBOX_PRESENT_21_9, XBOX_PRESENT_32_9, XBOX_PRESENT_ZOOM };
+/* Presentation geometry. Guest scanout pixels are anamorphic; their numeric
+ * width/height is not the display aspect of the widescreen picture. */
+typedef struct {
+    uint32_t sx, sy, sw, sh, dx, dy, dw, dh;
+    float aspect;
+} XboxPresentLayout;
+
+static XboxPresentLayout xbox_present_layout(uint32_t fw, uint32_t fh,
+        uint32_t ww, uint32_t wh, int crop, int wide, int mode)
+{
+    XboxPresentLayout r = {0};
+    if (!fw || !fh || !ww || !wh) return r;
+    r.sx = fw == 720 && fh == 480 ? (uint32_t)(crop < 0 ? 0 : crop > 40 ? 40 : crop) : 0;
+    r.sy = r.sx == 40 && wide ? 16 : 0;
+    r.sw = fw - 2 * r.sx; r.sh = fh - 2 * r.sy;
+    float window = (float)ww / wh;
+    r.aspect = wide ? 16.0f / 9.0f : 4.0f / 3.0f;
+    if (mode == XBOX_PRESENT_16_9) r.aspect = 16.0f / 9.0f;
+    else if (mode == XBOX_PRESENT_21_9) r.aspect = 21.0f / 9.0f;
+    else if (mode == XBOX_PRESENT_32_9) r.aspect = 32.0f / 9.0f;
+    else if (mode == XBOX_PRESENT_ORIGINAL && wide && window > r.aspect)
+        r.aspect = window > 32.0f / 9.0f ? 32.0f / 9.0f : window;
+    if (mode == XBOX_PRESENT_STRETCH || mode == XBOX_PRESENT_ZOOM) {
+        if (mode == XBOX_PRESENT_ZOOM) {
+            if (window > r.aspect) {
+                uint32_t h = (uint32_t)(r.sh * r.aspect / window + 0.5f);
+                if (!h) h = 1;
+                r.sy += (r.sh - h) / 2; r.sh = h;
+            } else {
+                uint32_t w = (uint32_t)(r.sw * window / r.aspect + 0.5f);
+                if (!w) w = 1;
+                r.sx += (r.sw - w) / 2; r.sw = w;
+            }
+        }
+        r.dw = ww; r.dh = wh;
+        return r;
+    }
+    if (window > r.aspect) {
+        r.dh = wh; r.dw = (uint32_t)(wh * r.aspect + 0.5f);
+    } else {
+        r.dw = ww; r.dh = (uint32_t)(ww / r.aspect + 0.5f);
+    }
+    if (!r.dw) r.dw = 1;
+    if (!r.dh) r.dh = 1;
+    if (r.dw > ww) r.dw = ww;
+    if (r.dh > wh) r.dh = wh;
+    r.dx = (ww - r.dw) / 2; r.dy = (wh - r.dh) / 2;
+    return r;
+}
+
+
+#endif
diff --git a/tests/sdlgpu_web/test_wait.cjs b/tests/sdlgpu_web/test_wait.cjs
new file mode 100644
index 0000000..3297182
--- /dev/null
+++ b/tests/sdlgpu_web/test_wait.cjs
@@ -0,0 +1,31 @@
+// Bound the whole suite while distinguishing a slow software GPU from a stall.
+'use strict';
+const {performance}=require('node:perf_hooks');
+async function waitForSuiteProgress(readState,{idleMs=30000,totalMs=300000,pollMs=250,
+  now=()=>performance.now(),sleep=ms=>new Promise(resolve=>setTimeout(resolve,ms))}={}) {
+  const started=now();let lastProgress=started,lastCount=-1;
+  for(;;) {
+    // A frozen renderer can leave page.evaluate pending indefinitely. Bound
+    // the observation itself, as well as the intervals between log entries.
+    const elapsed=now()-started,idle=now()-lastProgress;
+    const totalRemaining=totalMs-elapsed,idleRemaining=idleMs-idle;
+    const totalFirst=totalRemaining<=idleRemaining;
+    let timer,state;
+    try {
+      state=await Promise.race([Promise.resolve().then(readState),new Promise((_,reject)=>{
+        timer=setTimeout(()=>reject(Error(totalFirst
+          ? `WebGPU suite exceeded total time ${totalMs} ms during state read`
+          : `WebGPU suite made no progress for ${idleMs} ms during state read`)),
+          Math.max(1,Math.min(totalRemaining,idleRemaining)));
+      })]);
+    } finally {clearTimeout(timer);}
+    const time=now();
+    if(state?.done)return state;
+    const count=state?.count||0;
+    if(count>lastCount){lastCount=count;lastProgress=time;}
+    if(time-started>=totalMs)throw Error(`WebGPU suite exceeded total time ${totalMs} ms (${count} log entries)`);
+    if(time-lastProgress>=idleMs)throw Error(`WebGPU suite made no progress for ${idleMs} ms (${count} log entries)`);
+    await sleep(Math.max(1,Math.min(pollMs,totalMs-(time-started),idleMs-(time-lastProgress))));
+  }
+}
+module.exports={waitForSuiteProgress};
