--- /dev/null
+++ b/src/platform/wasm_fixed.h
@@ -0,0 +1,42 @@
+#ifndef XBOX_WASM_FIXED_H
+#define XBOX_WASM_FIXED_H
+/* Fixed-address memory for WebAssembly builds.
+ *
+ * A native host gives each guest region a mapping at a chosen address, so a
+ * guest address becomes a host pointer by adding one offset. wasm32 has a
+ * single linear memory and no mmap, so the same arithmetic is kept by making
+ * that memory the address space: a fixed mapping at address A is simply the
+ * linear memory at A, and the host is kept out of every range a mapping may
+ * use. Two rules keep it out:
+ *
+ *   - below __global_base: nothing. The host's static data, stack and heap
+ *     all start at the link-time global base (-sGLOBAL_BASE), so a game that
+ *     needs low guest RAM links with a base above it.
+ *   - at and above WASM_FIXED_CEILING: nothing. The heap grows by sbrk, and
+ *     sbrk is wrapped (--wrap=sbrk, see wasm_fixed.c) to refuse growth past
+ *     the ceiling.
+ *
+ * What lies between is the host's. A fixed mapping may claim any range in
+ * the two outer windows that no other mapping holds. There is no aliasing:
+ * two claims are two different pieces of memory, which callers that want a
+ * second view of the same bytes must handle themselves. */
+#ifdef __EMSCRIPTEN__
+#include <stddef.h>
+#include <stdint.h>
+
+#define WASM_FIXED_CEILING 0x80000000u
+
+/* Claim [address, address + size) and return address, or NULL when the range
+ * is not in a fixed window, overlaps another claim, or the memory cannot grow
+ * to cover it. Memory never claimed before reads as zero; a range that was
+ * claimed and released is zeroed again, as a fresh anonymous mapping is. */
+void *wasm_fixed_map(void *address, size_t size);
+
+/* Release the claim that starts at address. Returns its size, or 0 when no
+ * claim starts there. */
+size_t wasm_fixed_unmap(const void *address);
+
+/* True when [address, address + size) lies inside one claim. */
+int wasm_fixed_claimed(const void *address, size_t size);
+#endif
+#endif
