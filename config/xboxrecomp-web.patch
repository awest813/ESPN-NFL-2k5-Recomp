+static void test_line_reference(const char *prefix) {
+    uint32_t saved=s_gpu.line_width,specular=s_vp.specular_enable;
+    CHECK(vp_method(0x0380,15) && s_gpu.line_width==15,"fractional line width preserves low three bits");
+    CHECK(vp_method(0x0380,512) && s_gpu.line_width==15,"invalid width preserves nondefault state");
+    CHECK(vp_method(0x0380,0xFFFFFFFFu) && s_gpu.line_width==15,"invalid all-bits width does not wrap");
+    CHECK(vp_method(0x0380,511) && s_gpu.line_width==511,"largest legal width is accepted");
+    CHECK(s_vp.specular_enable==specular,"line width method does not alias specular enable");
+    for(unsigned k=0;k<sizeof line_width_references/sizeof *line_width_references;k++)
+        test_line_reference_case(prefix,&line_width_references[k]);
+    vp_method(0x0380,saved);
+}
