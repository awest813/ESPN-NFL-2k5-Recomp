+        SDL_GPUColorTargetInfo ct={.texture=color,.load_op=SDL_GPU_LOADOP_LOAD,.store_op=SDL_GPU_STOREOP_STORE};
+        SDL_GPURenderPass *pass=SDL_BeginGPURenderPass(bad,&ct,1,NULL);
