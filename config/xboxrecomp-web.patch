+/* Analytic reference for the triangle (0,0), (64,0), (0,64).
+ * No rasterizer or production vertex-colour helper is used here. */
+static const float pretransform_colors[3][3][4] = {
+    {{1,0,0,0.25f},{0,1,0,0.75f},{0,0,1,1}},
+    {{-1,2,0.25f,0.25f},{2,-1,0.75f,1},{0.25f,0.75f,2,0.5f}},
+    {{0.2f,0.4f,0.6f,0.8f},{0.2f,0.4f,0.6f,0.8f},{0.2f,0.4f,0.6f,0.8f}}
+};
+static const int pretransform_probes[6][2]={{3,5},{13,7},{27,3},{7,27},{21,21},{40,8}};
+static uint32_t pretransform_expected(unsigned pattern,int flat,int textured,int alpha_test,int x,int y)
+{
+    float green=(x+0.5f)/64.0f,blue=(y+0.5f)/64.0f,red=1-green-blue;
+    const unsigned texture[4]={128,64,255,192};
+    uint32_t result=0;
+    for(unsigned c=0;c<4;c++) {
+        float v=flat?pretransform_colors[pattern][0][c]
+            :red*pretransform_colors[pattern][0][c]+green*pretransform_colors[pattern][1][c]+blue*pretransform_colors[pattern][2][c];
+        if(v<0)v=0;if(v>1)v=1;
+        unsigned value=(unsigned)floorf(v*255+(flat?0:0.5f));
+        if(textured)value=(value*texture[c]+127)/255;
+        result|=value<<(c==3?24:16-c*8);
+    }
+    return alpha_test && (result>>24)<=128 ? 0xFF112233u:result;
+}
