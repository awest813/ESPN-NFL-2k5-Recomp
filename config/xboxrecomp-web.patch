+        .buffer = { .type = WGPUBufferBindingType_Uniform, .hasDynamicOffset = 1 } };
+    WGPUBindGroupLayoutEntry tex[2 * WG_MAX_SAMPLERS];
+    for (uint32_t i = 0; i < WG_MAX_SAMPLERS; i++) {
+        tex[i] = (WGPUBindGroupLayoutEntry){ .binding = i, .visibility = WGPUShaderStage_Fragment,
+            .texture = { .sampleType = WGPUTextureSampleType_Float,
+                         .viewDimension = i >= 4 ? WGPUTextureViewDimension_Cube : WGPUTextureViewDimension_2D } };
+        tex[WG_MAX_SAMPLERS + i] = (WGPUBindGroupLayoutEntry){ .binding = WG_MAX_SAMPLERS + i,
+            .visibility = WGPUShaderStage_Fragment, .sampler = { .type = WGPUSamplerBindingType_Filtering } };
+    }
+    s_bgl[0] = make_bgl(NULL, 0);
+    s_bgl[1] = make_bgl(&vs_u, 1);
+    s_bgl[2] = make_bgl(tex, 2 * WG_MAX_SAMPLERS);
+    s_bgl[3] = make_bgl(&fs_u, 1);
