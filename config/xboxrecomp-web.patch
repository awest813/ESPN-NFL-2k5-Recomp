+        download(color, 0, W, H, img);
+        CHECK(px(img, 1, 1) == 0xFFFF0000u, "alternate material samples red");
+        d.tex = checker;
+        draw(&d);
+        download(color, 0, W, H, img);
+        CHECK(px(img, 1, 1) == 0xFF1080F0u, "cached checker material restored across submissions");
+        SDL_ReleaseGPUTexture(dev, alternate);
+        alternate = make_tex(SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, SDL_GPU_TEXTUREUSAGE_SAMPLER, 1, 1, 1);
+        uint32_t green = 0xFF00FF00u;
+        upload(alternate, &green, 1, 1);
+        d.tex = alternate;
+        draw(&d);
+        download(color, 0, W, H, img);
+        CHECK(px(img, 1, 1) == 0xFF00FF00u, "released material does not reuse stale bindings");
