+/* Fullscreen triangle for blits and mipmaps. */
+static const char k_blit_wgsl[] =
+    "struct V { @builtin(position) pos: vec4f, @location(0) uv: vec2f }\n"
+    "@vertex fn vs(@builtin(vertex_index) i: u32) -> V {\n"
+    "  let uv = vec2f(f32((i << 1u) & 2u), f32(i & 2u));\n"
+    "  return V(vec4f(uv * vec2f(2.0, -2.0) + vec2f(-1.0, 1.0), 0.0, 1.0), uv);\n"
+    "}\n"
+    "@group(0) @binding(0) var t: texture_2d<f32>;\n"
+    "@group(0) @binding(1) var s: sampler;\n"
+    "@group(0) @binding(2) var<uniform> source: vec4f;\n"
+    "@fragment fn fs(v: V) -> @location(0) vec4f {\n"
+    "  let half_texel = 0.5 / vec2f(textureDimensions(t));\n"
+    "  let uv = clamp(source.xy + v.uv * source.zw,\n"
+    "                 source.xy + half_texel, source.xy + source.zw - half_texel);\n"
+    "  return textureSampleLevel(t, s, uv, 0.0);\n"
+    "}\n";
+
+static void create_fixed_objects(void)
+{
+    WGPUBindGroupLayoutEntry vs_u = { .binding = 0, .visibility = WGPUShaderStage_Vertex,
+        .buffer = { .type = WGPUBufferBindingType_Uniform, .hasDynamicOffset = 1 } };
