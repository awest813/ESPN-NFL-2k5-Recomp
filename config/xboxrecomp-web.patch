+                download(color, 0, W, H, img);
+                CHECK(px(img, 25, 25) == colours[0], "normal-map dot products select diffuse lighting cube +X");
+                shade.prog[2] = 11u;
+                shade.prog[3] = 0x1B00u;
+                draw(&d);
+                download(color, 0, W, H, img);
+                CHECK(px(img, 25, 25) == colours[3], "reflected eye vector selects specular lighting cube -Y");
+            }
+        }
+    }
+
+    /* 10. Presenting: copy the flipped target to a sampled texture, then
+     * acquire the canvas texture and blit the copy. */
+    {
+        quad(v, W / 4, H / 4, 3 * W / 4, 3 * H / 4, 0, 0, 0, 0, 0xFF00C030u, 0);
+        d = (Draw){ .color = color, .depth = depth, .tex = white, .pipe = opaque, .v = v, .n = 6,
+                    .clear_color = 1, .clear_argb = 0xFF000000u, .clear_depth = 1, .depth_value = 1.0f };
+        draw(&d);
+        SDL_GPUTextureCreateInfo frame_info = {
+            .type = SDL_GPU_TEXTURETYPE_2D, .format = SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM,
+            .usage = SDL_GPU_TEXTUREUSAGE_SAMPLER, .width = W, .height = H,
+            .layer_count_or_depth = 1, .num_levels = 1,
+        };
+        SDL_GPUTexture *frame_texture = SDL_CreateGPUTexture(dev, &frame_info);
+        SDL_GPUCommandBuffer *copy_cmd = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_GPUCopyPass *copy = SDL_BeginGPUCopyPass(copy_cmd);
+        SDL_GPUTextureLocation src = { .texture = color };
+        SDL_GPUTextureLocation dst = { .texture = frame_texture };
+        SDL_CopyGPUTextureToTexture(copy, &src, &dst, W, H, 1, false);
+        SDL_EndGPUCopyPass(copy);
+        SDL_SubmitGPUCommandBuffer(copy_cmd);
+        download(frame_texture, 0, W, H, img);
+        CHECK(px(img, W / 2, H / 2) == 0xFF00C030u, "flipped target copied to sampled texture");
+        CHECK(px(img, 0, 0) == 0xFF000000u, "source has a distinct overscan border");
+        SDL_GPUBlitInfo crop = {
+            .source = { .texture = frame_texture, .x = W / 4, .y = H / 4, .w = W / 2, .h = H / 2 },
+            .destination = { .texture = color, .w = W, .h = H },
+            .load_op = SDL_GPU_LOADOP_CLEAR, .filter = SDL_GPU_FILTER_LINEAR,
+        };
+        SDL_GPUCommandBuffer *crop_cmd = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_BlitGPUTexture(crop_cmd, &crop);
+        SDL_SubmitGPUCommandBuffer(crop_cmd);
+        download(color, 0, W, H, img);
+        CHECK(px(img, 0, 0) == 0xFF00C030u && px(img, W - 1, H - 1) == 0xFF00C030u,
+              "scaled source rectangle excludes the overscan border at both corners");
+        CHECK(SDL_ClaimWindowForGPUDevice(dev, NULL), "claim the window (the GPU canvas)");
+        for (int frame = 0; frame < 3; frame++) {
+            SDL_GPUCommandBuffer *c = SDL_AcquireGPUCommandBuffer(dev);
+            SDL_GPUTexture *swap = NULL;
+            Uint32 sw = 0, sh = 0;
+            SDL_WaitAndAcquireGPUSwapchainTexture(c, NULL, &swap, &sw, &sh);
+            SDL_GPUBlitInfo b = { .source = crop.source,
+                                  .destination = { .texture = swap, .x = 0, .y = 0, .w = sw, .h = sh },
+                                  .load_op = SDL_GPU_LOADOP_CLEAR, .clear_color = { 0, 0, 0, 1 }, .filter = SDL_GPU_FILTER_NEAREST };
+            SDL_BlitGPUTexture(c, &b);
+            SDL_GPUFence *presented = SDL_SubmitGPUCommandBufferAndAcquireFence(c);
+            CHECK(presented && SDL_WaitForGPUFences(dev, true, &presented, 1), "presented frame %d completes on the queue", frame);
+            SDL_ReleaseGPUFence(dev, presented);
+        }
+        printf("PRESENTED 00C030\n");   /* test_page.js reads the canvas now */
+    }
+
+    printf("%s (%d failures)\n", fails ? "FAILED" : "ALL PASS", fails);
+    printf("SDLGPU-WEB DONE rc=%d\n", fails != 0);
+    return fails != 0;
+}
