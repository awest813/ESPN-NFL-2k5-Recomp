+/* NV2A vertex programs -> WGSL. Shares the native decoder's register and
+ * paired-MAC/ILU rules, with scalar component writes (WGSL forbids assigning
+ * to multi-component swizzles). Constant-writing programs stay on the CPU. */
+#include "webgpu/sg_wgsl.h"
+
+static void sg_wgsl_src(char *out, size_t n, const uint32_t *t, int mux, int reg,
+                        int neg, const int swz[4], int scalar)
+{
+    char source[96];
+    sg_vp_src(source, sizeof source, t, mux, reg, neg, swz, scalar);
+    /* The only language difference in a source operand is the constant
+     * buffer's qualified name. Relative addressing and swizzles carry over. */
+    const char *c = strstr(source, "c[");
+    if (c)
+        snprintf(out, n, "%.*svc.%s", (int)(c - source), source, c);
+    else
+        snprintf(out, n, "%s", source);
+}
+
+static void sg_wgsl_write(SgText *b, const char *dst, const char *src, uint32_t mask)
+{
+    const char *xyzw = "xyzw";
+    for (unsigned k = 0; k < 4; k++)
+        if (mask & (8u >> k))
+            sg_text(b, "      %s.%c = %s.%c;\n", dst, xyzw[k], src, xyzw[k]);
+}
+
+static char *sg_vp_translate_wgsl(uint32_t start)
+{
+    SgText b = {0};
+    if (start >= VP_PROG_LEN) return NULL;
+    sg_text(&b, "%s", k_sg_vp_prelude_wgsl);
