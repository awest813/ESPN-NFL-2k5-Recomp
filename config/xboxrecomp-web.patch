+    static int previous_limit;
+    int limit = xbox_VideoFpsLimit();
+    uint64_t now = SDL_GetTicksNS();
+    if (limit != 30) { deadline = 0; previous_limit = limit; return; }
+    const uint64_t period = 1000000000ull / 30u;
+    if (previous_limit != limit || !deadline) deadline = now;
+    previous_limit = limit;
+    if (now < deadline) {
