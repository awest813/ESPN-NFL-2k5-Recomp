diff --git a/templates/runtime/recomp_types.h b/templates/runtime/recomp_types.h
index 0e3de94..97d843d 100644
--- a/templates/runtime/recomp_types.h
+++ b/templates/runtime/recomp_types.h
@@ -386,7 +386,36 @@ void recomp_trace_esp(const char *name, const char *tag);
  * uintptr_t cast preserves the overflow bits, landing us 4GB+ past
  * our mapping and causing access violations.
  */
+#if defined(__EMSCRIPTEN__)
+/* WebAssembly: guest memory is the wasm linear memory itself at
+ * g_xbox_mem_offset (xboxrecomp platform/wasm_fixed.h), and the host's heap
+ * lives in the guest addresses between RAM and 2 GB -- where a native host
+ * maps RAM mirrors. Fold those addresses onto RAM, which is the mirror wrap
+ * the hardware does and keeps generated code out of host memory: below 2 GB
+ * an address is taken modulo RECOMP_WASM_RAM_SPAN, from 2 GB up it is used as
+ * is (contiguous window, device apertures). Four integer operations and no
+ * branch or load.
+ *
+ * RECOMP_WASM_TILED_FOLD additionally maps the NV2A tiled aperture
+ * (0xF0000000..0xF3FFFFFF) onto the contiguous window it aliases on
+ * hardware; linear memory cannot alias, so a title that renders through
+ * tiled addresses needs it. Off by default: it costs a compare per access. */
+#ifndef RECOMP_WASM_RAM_SPAN
+#define RECOMP_WASM_RAM_SPAN 0x08000000u   /* 128 MB, the largest RAM map */
+#endif
+static inline uint32_t recomp_wasm_va(uint32_t a)
+{
+    a &= (RECOMP_WASM_RAM_SPAN - 1u) | (0u - (a >> 31));
+#ifdef RECOMP_WASM_TILED_FOLD
+    if (a - 0xF0000000u < 0x04000000u)
+        a -= 0x70000000u;
+#endif
+    return a;
+}
+#define XBOX_PTR(addr) ((uintptr_t)recomp_wasm_va((uint32_t)(addr)) + g_xbox_mem_offset)
+#else
 #define XBOX_PTR(addr) ((uintptr_t)(uint32_t)(addr) + g_xbox_mem_offset)
+#endif
 
 /** Read/write N bytes at a flat Xbox memory address. */
 #define MEM8(addr)   (*(volatile uint8_t  *)XBOX_PTR(addr))
diff --git a/tests/sdlgpu_web/CMakeLists.txt b/tests/sdlgpu_web/CMakeLists.txt
new file mode 100644
index 0000000..a5fab6d
--- /dev/null
+++ b/tests/sdlgpu_web/CMakeLists.txt
@@ -0,0 +1,20 @@
+# Emscripten only: the SDL GPU renderer on WebGPU, in headless Chromium.
+#   emcmake cmake -S . -B build -DSDL3_DIR=<sdl3-wasm>/lib/cmake/SDL3 -DCMAKE_C_FLAGS=-pthread
+#   cmake --build build && node test_page.js build
+cmake_minimum_required(VERSION 3.20)
+project(sdlgpu_web C CXX)
+find_package(SDL3 REQUIRED CONFIG)
+get_filename_component(SRC "${CMAKE_CURRENT_SOURCE_DIR}/../../src" ABSOLUTE)
+add_executable(sdlgpu_web test_web.c "${SRC}/kernel/sdlgpu/webgpu/sdl_gpu_webgpu.c")
+target_include_directories(sdlgpu_web PRIVATE "${SRC}")
+target_compile_definitions(sdlgpu_web PRIVATE SG_HAVE_SHADERS=1)
+target_compile_options(sdlgpu_web PRIVATE --use-port=emdawnwebgpu -Wall -Wno-unused-function)
+target_link_libraries(sdlgpu_web PRIVATE SDL3::SDL3 m)
+target_link_options(sdlgpu_web PRIVATE --use-port=emdawnwebgpu -pthread -sPROXY_TO_PTHREAD -sPTHREAD_POOL_SIZE=8
+    -sOFFSCREENCANVAS_SUPPORT=1 "-sOFFSCREENCANVASES_TO_PTHREAD=#gpucanvas"
+    -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=256MB -sMAXIMUM_MEMORY=2GB
+    -sMODULARIZE=1 -sEXPORT_NAME=createTest -sENVIRONMENT=web,worker -sEXIT_RUNTIME=0)
+set_target_properties(sdlgpu_web PROPERTIES SUFFIX ".js" LINKER_LANGUAGE CXX)
+add_custom_target(sdlgpu_web_page ALL
+  COMMAND "${CMAKE_COMMAND}" -E copy "${CMAKE_CURRENT_SOURCE_DIR}/index.html" "${CMAKE_BINARY_DIR}" VERBATIM)
+add_dependencies(sdlgpu_web sdlgpu_web_page)
