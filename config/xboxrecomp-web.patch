diff --git a/src/kernel/sdlgpu/sdlgpu_clip.h b/src/kernel/sdlgpu/sdlgpu_clip.h
new file mode 100644
index 0000000..c06e770
--- /dev/null
+++ b/src/kernel/sdlgpu/sdlgpu_clip.h
@@ -0,0 +1,83 @@
+#ifndef SDLGPU_CLIP_H
+#define SDLGPU_CLIP_H
+
+#include <SDL3/SDL_rect.h>
+#include <stdint.h>
+
+enum { SG_CLIP_WINDOWS = 8, SG_CLIP_SCISSORS = (2 * SG_CLIP_WINDOWS + 1) * (SG_CLIP_WINDOWS + 1) };
+
+typedef struct {
+    uint32_t x[SG_CLIP_WINDOWS], y[SG_CLIP_WINDOWS];
+    uint32_t exclusive;
+} SgWindowClip;
+
+/* Partition the surface into horizontal bands at window edges, then merge
+ * the active x intervals in each band. Scissors never overlap, so a
+ * fragment's blending and stencil operations run at most once per draw. */
+static int sg_clip_scissors(SDL_Rect surface, const SgWindowClip *state, SDL_Rect out[SG_CLIP_SCISSORS])
+{
+    SDL_Rect windows[SG_CLIP_WINDOWS];
+    int right = surface.x + surface.w, bottom = surface.y + surface.h;
+    int edges[2 * SG_CLIP_WINDOWS + 2] = {surface.y, bottom};
+    int count = 0, edge_count = 2, emitted = 0;
+
+    if (surface.w <= 0 || surface.h <= 0)
+        return 0;
+    for (int i = 0; i < SG_CLIP_WINDOWS; i++) {
+        uint32_t x = state->x[i], y = state->y[i];
+        int left = (int)(x & 0xfff), top = (int)(y & 0xfff);
+        /* NV2A stores the last included pixel in the maximum field. */
+        SDL_Rect window = {left, top, (int)((x >> 16) & 0xfff) + 1 - left,
+                                      (int)((y >> 16) & 0xfff) + 1 - top};
+        SDL_Rect clipped;
+        if (!SDL_GetRectIntersection(&surface, &window, &clipped))
+            continue;
+        if (clipped.w == surface.w && clipped.h == surface.h) {
+            out[0] = surface;
+            return state->exclusive ? 0 : 1;
+        }
+        int j = count++;
+        while (j > 0 && windows[j - 1].x > clipped.x) {
+            windows[j] = windows[j - 1];
+            j--;
+        }
+        windows[j] = clipped;
+        edges[edge_count++] = clipped.y;
+        edges[edge_count++] = clipped.y + clipped.h;
+    }
+    for (int i = 1; i < edge_count; i++) {
+        int edge = edges[i], j = i;
+        while (j > 0 && edges[j - 1] > edge) {
+            edges[j] = edges[j - 1];
+            j--;
+        }
+        edges[j] = edge;
+    }
+    for (int band = 0; band + 1 < edge_count; band++) {
+        int top = edges[band], height = edges[band + 1] - top;
+        int start = surface.x, end = start;
+        if (!height)
+            continue;
+        for (int i = 0; i < count; i++) {
+            SDL_Rect w = windows[i];
+            if (top < w.y || top >= w.y + w.h)
+                continue;
+            if (w.x > end) {
+                if (state->exclusive)
+                    out[emitted++] = (SDL_Rect){end, top, w.x - end, height};
+                else if (end > start)
+                    out[emitted++] = (SDL_Rect){start, top, end - start, height};
+                start = w.x;
+            }
+            if (w.x + w.w > end)
+                end = w.x + w.w;
+        }
+        if (state->exclusive && end < right)
+            out[emitted++] = (SDL_Rect){end, top, right - end, height};
+        else if (!state->exclusive && end > start)
+            out[emitted++] = (SDL_Rect){start, top, end - start, height};
+    }
+    return emitted;
+}
+
+#endif
