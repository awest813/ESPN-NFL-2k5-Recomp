+/* ── Command buffers ──────────────────────────────────────────────────── */
+SDL_GPUCommandBuffer *WG_AcquireGPUCommandBuffer(SDL_GPUDevice *d)
+{
+    (void)d;
+    return (SDL_GPUCommandBuffer *)calloc(1, sizeof(SDL_GPUCommandBuffer));
+}
+
+static void cmd_fail(SDL_GPUCommandBuffer *c, const char *message)
+{
+    if (c) c->failed = 1;
+    SDL_SetError("WebGPU command recording: %s", message);
+}
+
+static Op *push(SDL_GPUCommandBuffer *c, OpKind k)
+{
+    if (!c || c->failed) return NULL;
+    if (c->n == c->cap) {
+        if (c->cap > UINT32_MAX / 2) { cmd_fail(c, "too many commands"); return NULL; }
+        uint32_t cap = c->cap ? c->cap * 2 : 64;
+        if ((size_t)cap > SIZE_MAX / sizeof(Op)) { cmd_fail(c, "command storage overflow"); return NULL; }
+        Op *o = (Op *)realloc(c->ops, cap * sizeof *o);
+        if (!o) { cmd_fail(c, "out of memory"); return NULL; }
+        c->ops = o;
+        c->cap = cap;
+    }
+    Op *o = &c->ops[c->n++];
+    memset(o, 0, sizeof *o);
+    o->kind = k;
+    return o;
+}
+
+/* SDL release relinquishes the application reference. Recorded commands
+ * keep wrappers and upload/readback storage alive through replay, including
+ * cancellation, rejected submissions, and asynchronous readbacks. */
+static void texture_ref(WgTextureStorage *t, int release)
+{
+    if (!t || t->swapchain) return;
+    if (release) texture_storage_drop(t);
+    else atomic_fetch_add(&t->refs, 1);
+}
+static void buffer_ref(WgBufferStorage *b, int release)
+{
+    if (!b) return;
+    if (release) buffer_storage_drop(b);
+    else atomic_fetch_add(&b->refs, 1);
+}
+static void transfer_ref(WgTransferStorage *b, int release)
+{
+    if (!b) return;
+    if (release) transfer_storage_drop(b);
+    else atomic_fetch_add(&b->refs, 1);
+}
+static void op_resources(const Op *o, int release)
+{
+    switch (o->kind) {
+    case OP_UPLOAD_BUFFER: transfer_ref(o->ub.src, release); buffer_ref(o->ub.dst, release); break;
+    case OP_UPLOAD_TEXTURE: transfer_ref(o->ut.src, release); texture_ref(o->ut.dst, release); break;
+    case OP_DOWNLOAD_TEXTURE: texture_ref(o->dt.src, release); transfer_ref(o->dt.dst, release); break;
+    case OP_COPY_TEXTURE: texture_ref(o->ct.src, release); texture_ref(o->ct.dst, release); break;
+    case OP_MIPMAPS: texture_ref(o->mip.tex, release); break;
+    case OP_BLIT: texture_ref(o->blit.source, release); texture_ref(o->blit.destination, release); break;
+    case OP_BEGIN_PASS:
+        if (o->pass.has_color) texture_ref(o->pass.color_storage, release);
+        if (o->pass.has_depth) texture_ref(o->pass.depth_storage, release);
+        break;
+    case OP_VERTEX_BUFFER: case OP_INDEX_BUFFER: buffer_ref(o->vb.buf, release); break;
+    case OP_SAMPLERS:
+        for (uint32_t i = 0; i < o->samplers.n; i++) texture_ref(o->samplers.tex[i], release);
+        break;
+    default: break;
+    }
+}
+static void cmd_free(SDL_GPUCommandBuffer *c)
+{
+    for (uint32_t i = 0; i < c->n; i++) op_resources(&c->ops[i], 1);
+    free(c->ops); free(c->uniforms); free(c);
+}
+
+bool WG_CancelGPUCommandBuffer(SDL_GPUCommandBuffer *c) { if (c) cmd_free(c); return true; }
+
+/* Passes are views of their command buffer. */
+SDL_GPUCopyPass *WG_BeginGPUCopyPass(SDL_GPUCommandBuffer *c) { return (SDL_GPUCopyPass *)c; }
+void WG_EndGPUCopyPass(SDL_GPUCopyPass *p) { (void)p; }
+#define CMD(pass) ((SDL_GPUCommandBuffer *)(pass))
