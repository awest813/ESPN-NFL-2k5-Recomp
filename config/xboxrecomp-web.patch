+/* Replay the pinned Xbox Line_width geometry. Optional raw dumps preserve
+ * the entire frame for the full-mask audit, including known coverage gaps. */
+static void test_line_reference_case(const char *prefix,const LineWidthReference *reference)
+{
+    CHECK(vp_method(0x0380,8) && vp_method(0x0380,reference->raw),"width register method handled");
+    CHECK(s_gpu.line_width==reference->expected_width,"width register raw %08X accepted/ignored correctly",reference->raw);
+    target(0x400000,640,480,2560);s_gpu.shade_mode=0x1D01;s_gpu.prim=NV_PRIM_LINE_LOOP;s_gpu.idx_count=16;
+    for(unsigned k=0;k<16;k++) {
+        float *v=(float *)(g_ram+0x600000)+k*16;memset(v,0,64);
+        v[0]=160+line_reference_xy[k][0];v[1]=48+line_reference_xy[k][1];v[2]=1;v[3]=1;
+        for(unsigned c=0;c<4;c++)v[4+c]=(float)((line_reference_palette[k%8]>>(c*8))&255)/255;
+        s_gpu.idx[k]=(uint16_t)k;
+    }
+    const char *names[]={"gpu","software","2d","2d-software"};
+    for(unsigned mode=0;mode<4;mode++) {
+        /* The Xbox capture executes a VP. Pre-transformed replays consume
+         * that VP's projected 1/16-grid output, not its unsnapped input. */
+        if(mode==2)for(unsigned k=0;k<16;k++) {
+            float *v=(float *)(g_ram+0x600000)+k*16;
+            v[0]=vp_screen_coord(v[0]);v[1]=vp_screen_coord(v[1]);
+        }
+        s_gpu.clear_color=0xFF202224u;
+        if(mode==0 || mode==2) {
+            CHECK(sg_clear(0xF0) && sg_draw_batch(mode==2),"line capture replay %s",names[mode]);download_frame();
+        } else {
+            for(unsigned k=0;k<640*480;k++)((uint32_t *)(g_ram+0x400000))[k]=s_gpu.clear_color;
+            surface_stage_reset();if(mode==3)raster_batch();else batch_lines_xf(raster_line_xf_cb,NULL);
+            CHECK(surface_stage_flush(g_ram),"line capture software flush");surface_stage_reset();
+        }
+        for(unsigned k=0;k<reference->count;k++) {
+            const LineReferenceProbe *p=&reference->probes[k];uint32_t pixel;
+            memcpy(&pixel,g_ram+0x400000+(p->y*640+p->x)*4,4);
+            CHECK(abs((int)((pixel>>16)&255)-p->r)<=2 && abs((int)((pixel>>8)&255)-p->g)<=2 &&
+                  abs((int)(pixel&255)-p->b)<=2,"Xbox diagonal line %s at %u,%u: %08X",names[mode],p->x,p->y,pixel);
+        }
+        unsigned missing=0,extra=0,bad_rgb=0,reference_index=0;
+        for(unsigned y=0;y<reference->h;y++)for(unsigned x=0;x<reference->w;x++) {
+            unsigned bit=y*reference->w+x;int expected=(reference->mask[bit/8]>>(bit%8))&1;
+            uint32_t pixel;memcpy(&pixel,g_ram+0x400000+((y+reference->y)*640+x+reference->x)*4,4);
+            int covered=(pixel&0xFFFFFFu)!=0x202224u;
+            missing+=expected && !covered;extra+=covered && !expected;
+            if(expected && reference->expected_width==8) {
+                const uint8_t *rgb=line_reference_rgb[reference_index++];
+                if(covered)bad_rgb+=abs((int)((pixel>>16)&255)-rgb[0])>2 ||
+                    abs((int)((pixel>>8)&255)-rgb[1])>2 || abs((int)(pixel&255)-rgb[2])>2;
+            }
+        }
+        printf("Xbox line raw=%08X %s: missing=%u extra=%u full-RGB=%s errors=%u\n",reference->raw,names[mode],missing,extra,reference->expected_width==8?"yes":"64 probes",bad_rgb);
+        CHECK(missing==0 && extra==0 && bad_rgb==0,"Xbox full line crop without coverage tolerance %s",names[mode]);
+        if(!prefix || !*prefix)continue;
+        char path[1024];int n=snprintf(path,sizeof path,"%s-w%08X-%s.argb",prefix,reference->raw,names[mode]);
+        CHECK(n>0 && (size_t)n<sizeof path,"line reference output path fits");
+        if(n<=0 || (size_t)n>=sizeof path)continue;
+        FILE *f=fopen(path,"wb");CHECK(f!=NULL,"open line capture output");
+        if(f){CHECK(fwrite(g_ram+0x400000,1,640*480*4,f)==640*480*4,"write line capture output");fclose(f);}
+    }
+}
