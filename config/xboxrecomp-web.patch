+    else if (mode == AR_21_9) r.aspect = 21.0f / 9.0f;
+    else if (mode == AR_32_9) r.aspect = 32.0f / 9.0f;
+    else if (mode == AR_ORIGINAL && wide && window > r.aspect)
+        r.aspect = window > 32.0f / 9.0f ? 32.0f / 9.0f : window;
+    if (mode == AR_STRETCH || mode == AR_ZOOM) {
