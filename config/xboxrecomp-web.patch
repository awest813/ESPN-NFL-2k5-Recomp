@@ -0,0 +1,18 @@
+/* Independent texel-domain reference for an 8-wide repeating row. */
+static uint32_t flat_filter_texel(int x, int mode)
+{
+    if (mode == 1) x = (x % 8 + 8) % 8;
+    else if (mode == 2) { x = (x % 16 + 16) % 16; if (x >= 8) x = 15 - x; }
+    else if (mode == 4 && (x < 0 || x >= 8)) return 0xFF209060u;
+    else { if (x < 0) x = 0; if (x > 7) x = 7; }
+    return 0xFF000000u | (uint32_t)(x * 32) << 16 | (uint32_t)(255 - x * 32);
+}
+static uint32_t flat_filter_expected(float u, int mode, int linear)
+{
+    if (!linear) return flat_filter_texel((int)floorf(u), mode);
+    float p = u - 0.5f, f = p - floorf(p);
+    uint32_t a = flat_filter_texel((int)floorf(p), mode), b = flat_filter_texel((int)floorf(p) + 1, mode), out = 0;
+    for (int ch = 0; ch < 32; ch += 8)
+        out |= (uint32_t)floorf(((a >> ch) & 255u) * (1-f) + ((b >> ch) & 255u) * f + 0.5f) << ch;
+    return out;
+}
