+SDL_GPURenderPass *WG_BeginGPURenderPass(SDL_GPUCommandBuffer *c, const SDL_GPUColorTargetInfo *ct, Uint32 n,
+                                         const SDL_GPUDepthStencilTargetInfo *ds)
+{
+    Op *o = push(c, OP_BEGIN_PASS);
+    if (!o) return NULL;
+    if (n) {
+        WgTextureStorage *color = texture_for_write(ct[0].texture, ct[0].cycle && ct[0].load_op != SDL_GPU_LOADOP_LOAD);
+        if (!color) { cmd_fail(c, "color target cycling failed"); return NULL; }
+        texture_ref(color, 0);
+        o->pass.color = ct[0]; o->pass.color.texture = NULL;
+        o->pass.has_color = 1; o->pass.color_storage = color;
+    }
+    if (ds) {
+        bool cycle = ds->cycle && ds->load_op != SDL_GPU_LOADOP_LOAD && ds->stencil_load_op != SDL_GPU_LOADOP_LOAD;
+        WgTextureStorage *depth = texture_for_write(ds->texture, cycle);
+        if (!depth) { cmd_fail(c, "depth target cycling failed"); return NULL; }
+        texture_ref(depth, 0);
+        o->pass.depth = *ds; o->pass.depth.texture = NULL;
+        o->pass.has_depth = 1; o->pass.depth_storage = depth;
+    }
+    return (SDL_GPURenderPass *)c;
+}
