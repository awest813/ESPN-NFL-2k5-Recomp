+    }
+
+    /* 3. Flat 2D: orientation and flat colour. */
+    SDL_GPUGraphicsPipeline *opaque = flat_pipe(0, 15, 0, SDL_GPU_COMPAREOP_ALWAYS);
+    SDL_GPUTexture *white = make_tex(SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, SDL_GPU_TEXTUREUSAGE_SAMPLER, 1, 1, 1);
+    { uint32_t w1 = 0xFFFFFFFFu; upload(white, &w1, 1, 1); }
+    SgVertex v[12];
+    quad(v, 10, 20, 110, 70, 0, 0, 0, 0, 0xFF336699u, 0);
+    d = (Draw){ .color = color, .depth = depth, .tex = white, .pipe = opaque, .v = v, .n = 6,
+                .clear_color = 1, .clear_argb = 0xFF000000u, .clear_depth = 1, .depth_value = 1.0f };
+    draw(&d);
+    download(color, 0, W, H, img);
+    CHECK(px(img, 15, 25) == 0xFF336699u && px(img, 105, 65) == 0xFF336699u,
+          "flat quad at its top-left position: %08X (y not flipped)", px(img, 15, 25));
+    CHECK(px(img, 5, 25) == 0xFF000000u && px(img, 15, 75) == 0xFF000000u, "nothing drawn outside the quad");
+
+    /* 4. Textured: 8x8 checker, point sampled, wrapped, modulated as the software path does. */
+    static uint32_t tex[64];
+    for (int i = 0; i < 64; i++) {      /* R8G8B8A8 bytes: R,G,B,A */
+        uint32_t c = (((i % 8) + (i / 8)) & 1) ? 0xFF1030E0u : 0xFFF08010u;   /* ABGR in memory order */
+        tex[i] = c;
+    }
+    SDL_GPUTexture *checker = make_tex(SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+                                       SDL_GPU_TEXTUREUSAGE_SAMPLER | SDL_GPU_TEXTUREUSAGE_COLOR_TARGET, 8, 8, 4);
+    upload(checker, tex, 8, 8);
+    {
+        SDL_GPUCommandBuffer *c = SDL_AcquireGPUCommandBuffer(dev);
+        SDL_GenerateMipmapsForGPUTexture(c, checker);
+        SDL_SubmitGPUCommandBuffer(c);
