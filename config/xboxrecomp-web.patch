+static void dis_pm_4(dsp_core_t* dsp);
+static void dis_pm_8(dsp_core_t* dsp);
+
+static const dis_func_t disasm_opcodes_parmove[16] = {
+    dis_pm_0,
+    dis_pm_1,
+    dis_pm_2,
+    dis_pm_2,
+    dis_pm_4,
