+ *   - xxHash source repository: https://github.com/Cyan4973/xxHash
+ */
+
+/* Compact, one-shot XXH64 adapted from xxHash v0.8.3. Streaming, SIMD
+ * dispatch and the other hash families are intentionally omitted.
+ * Reference: https://github.com/Cyan4973/xxHash/blob/v0.8.3/xxhash.h
+ * Reference SHA256: 17973c0dc49d9854ca26caa191f0e12f7a424b68858d9a78de3860d959d85e4b
+ */
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+#define SG_XXH_P1 UINT64_C(11400714785074694791)
+#define SG_XXH_P2 UINT64_C(14029467366897019727)
+#define SG_XXH_P3 UINT64_C(1609587929392839161)
+#define SG_XXH_P4 UINT64_C(9650029242287828579)
+#define SG_XXH_P5 UINT64_C(2870177450012600261)
+
+static inline uint32_t sg_xxh_read32(const uint8_t *p) {
+    return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24;
+}
+static inline uint64_t sg_xxh_read64(const uint8_t *p) {
+    return (uint64_t)sg_xxh_read32(p) | (uint64_t)sg_xxh_read32(p+4)<<32;
+}
+static inline uint64_t sg_xxh_rot(uint64_t v,unsigned bits) {return (v<<bits)|(v>>(64-bits));}
+static inline uint64_t sg_xxh_round(uint64_t a,uint64_t value) {
+    return sg_xxh_rot(a+value*SG_XXH_P2,31)*SG_XXH_P1;
+}
+static inline uint64_t sg_xxh_merge(uint64_t hash,uint64_t value) {
+    return (hash^sg_xxh_round(0,value))*SG_XXH_P1+SG_XXH_P4;
+}
+static uint64_t sg_xxh64(const uint8_t *p,size_t bytes,uint64_t seed) {
+    size_t remaining=bytes;uint64_t hash;
+    if(remaining>=32) {
+        uint64_t a=seed+SG_XXH_P1+SG_XXH_P2,b=seed+SG_XXH_P2,c=seed,d=seed-SG_XXH_P1;
+        do {
+            a=sg_xxh_round(a,sg_xxh_read64(p));b=sg_xxh_round(b,sg_xxh_read64(p+8));
+            c=sg_xxh_round(c,sg_xxh_read64(p+16));d=sg_xxh_round(d,sg_xxh_read64(p+24));
+            p+=32;remaining-=32;
+        }while(remaining>=32);
+        hash=sg_xxh_rot(a,1)+sg_xxh_rot(b,7)+sg_xxh_rot(c,12)+sg_xxh_rot(d,18);
+        hash=sg_xxh_merge(hash,a);hash=sg_xxh_merge(hash,b);
+        hash=sg_xxh_merge(hash,c);hash=sg_xxh_merge(hash,d);
+    }else hash=seed+SG_XXH_P5;
+    hash+=(uint64_t)bytes;
+    for(;remaining>=8;p+=8,remaining-=8)
+        hash=sg_xxh_rot(hash^sg_xxh_round(0,sg_xxh_read64(p)),27)*SG_XXH_P1+SG_XXH_P4;
+    if(remaining>=4) {
+        hash=sg_xxh_rot(hash^((uint64_t)sg_xxh_read32(p)*SG_XXH_P1),23)*SG_XXH_P2+SG_XXH_P3;
+        p+=4;remaining-=4;
+    }
+    for(;remaining;p++,remaining--)hash=sg_xxh_rot(hash^((uint64_t)*p*SG_XXH_P5),11)*SG_XXH_P1;
+    hash^=hash>>33;hash*=SG_XXH_P2;hash^=hash>>29;hash*=SG_XXH_P3;return hash^(hash>>32);
+}
