     return ok;
 }
 
-#endif
\ No newline at end of file
+#endif
+/* Device accessors for hosts without MMIO faults (WebAssembly): generated
+ * code routes an access in the register window here itself instead of
+ * faulting into apu_hook_handle_mmio (src/platform/web/recomp_web_dev.h in
+ * the game). Same semantics as the fault path: the access goes to the
+ * emulated APU when one exists, and returns 0 -- "not routed, use memory" --
+ * when none does, which is what an untrapped window means natively. */
+int xbox_apu_guest_read(uint32_t offset, unsigned size, uint32_t *value)
+{
+    if (!g_apu_state || offset >= APU_MMIO_SIZE)
+        return 0;
+    *value = (uint32_t)mcpx_apu_mmio_read(g_apu_state, offset, size);
+    g_apu_mmio_read_count++;
+    return 1;
+}
+
+int xbox_apu_guest_write(uint32_t offset, unsigned size, uint32_t value)
+{
+    if (!g_apu_state || offset >= APU_MMIO_SIZE)
+        return 0;
+    mcpx_apu_mmio_write(g_apu_state, offset, value, size);
+    g_apu_mmio_write_count++;
+    return 1;
+}
diff --git a/src/apu/apu_web_audio.c b/src/apu/apu_web_audio.c
new file mode 100644
index 0000000..8ee742d
--- /dev/null
+++ b/src/apu/apu_web_audio.c
@@ -0,0 +1,118 @@
+/* WebAssembly audio output through an AudioWorklet. See apu_web_audio.h. */
+#ifdef __EMSCRIPTEN__
+#include "apu_web_audio.h"
+
+#include <emscripten/em_asm.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define RING_FRAMES 16384u   /* 341 ms at 48 kHz; the producer keeps ~150 ms */
+
+typedef struct {
+    _Atomic uint32_t write;
+    _Atomic uint32_t read;
+    uint32_t capacity;
+    uint32_t reserved;
+    int16_t data[RING_FRAMES * 2];
+} WebAudioRing;
+
+static WebAudioRing *s_ring;
+
+int web_audio_open(void)
+{
+    if (s_ring)
+        return 1;
+    WebAudioRing *ring = (WebAudioRing *)aligned_alloc(16, sizeof *ring);
+    if (!ring)
+        return 0;
+    memset(ring, 0, sizeof *ring);
+    ring->capacity = RING_FRAMES;
+
+    /* On the page's thread: find the AudioContext (the page made one in the
+     * Play click and handed it over as Module.SDL3.audioContext, see
+     * web/launch.js), load the processor and connect it. Loading is
+     * asynchronous; frames written meanwhile wait in the ring. */
+    int ok = MAIN_THREAD_EM_ASM_INT({
+        var C = globalThis.AudioContext || globalThis.webkitAudioContext;
+        var ctx = (Module['SDL3'] && Module['SDL3'].audioContext) || Module['nfl2k5AudioContext'];
+        if (!ctx) {
+            if (!C) return 0;
+            try { ctx = new C({ latencyHint: 'interactive', sampleRate: 48000 }); }
+            catch (e) { ctx = new C({ latencyHint: 'interactive' }); }
+        }
+        if (!ctx.audioWorklet || typeof AudioWorkletNode === 'undefined') return 0;
+        Module['nfl2k5AudioContext'] = ctx;
+        /* Parenthesised: a comma outside parentheses would split this
+         * macro argument (braces do not protect it). */
+        var stats = Module['nfl2k5Audio'] = ({ state: 'loading', contextRate: ctx.sampleRate,
+                                                played: 0, underruns: 0, peak: 0, frequency: 0 });
+        var url = Module['nfl2k5AudioWorklet'] || 'audio-worklet.js';
+        ctx.audioWorklet.addModule(url).then(function() {
+            var node = new AudioWorkletNode(ctx, 'nfl2k5-output', {
+                numberOfInputs: 0, numberOfOutputs: 1, outputChannelCount: [2],
+                processorOptions: { memory: HEAPU8.buffer, ring: $0, rate: 48000 }
+            });
+            node.port.onmessage = function(e) { Object.assign(stats, e.data); };
+            node.connect(ctx.destination);
+            stats.node = node;
+            stats.state = 'running';
+        }).catch(function(e) {
+            stats.state = 'failed';
+            err('[AUDIO] AudioWorklet could not start (' + url + '): ' + e);
+        });
+        return 1;
+    }, ring);
+    if (!ok) {
+        free(ring);
+        return 0;
+    }
+    s_ring = ring;
+    fprintf(stderr, "[AUDIO] AudioWorklet output (48000 Hz stereo 16-bit, %u-frame ring)\n",
+            RING_FRAMES);
+    return 1;
+}
+
+void web_audio_close(void)
+{
+    if (!s_ring)
+        return;
+    MAIN_THREAD_EM_ASM({
+        var s = Module['nfl2k5Audio'];
+        if (s && s.node) { s.node.disconnect(); s.node.port.postMessage('stop'); }
+        if (s) s.state = 'closed';
+    });
+    /* The worklet may still hold the ring's address; leave it allocated. */
+    s_ring = NULL;
+}
+
+uint32_t web_audio_queued(void)
+{
+    if (!s_ring)
+        return 0;
+    uint32_t w = atomic_load_explicit(&s_ring->write, memory_order_relaxed);
+    uint32_t r = atomic_load_explicit(&s_ring->read, memory_order_acquire);
+    return w - r;
+}
+
+uint32_t web_audio_put(const int16_t *frames, uint32_t count)
+{
+    if (!s_ring)
+        return 0;
+    uint32_t w = atomic_load_explicit(&s_ring->write, memory_order_relaxed);
+    uint32_t r = atomic_load_explicit(&s_ring->read, memory_order_acquire);
+    uint32_t space = RING_FRAMES - (w - r);
+    if (count > space)
+        count = space;
+    for (uint32_t done = 0; done < count; ) {
+        uint32_t at = (w + done) & (RING_FRAMES - 1);
+        uint32_t run = RING_FRAMES - at;
+        if (run > count - done) run = count - done;
+        memcpy(&s_ring->data[at * 2], frames + done * 2, run * 2 * sizeof(int16_t));
+        done += run;
+    }
+    atomic_store_explicit(&s_ring->write, w + count, memory_order_release);
+    return count;
+}
+#endif
diff --git a/src/apu/apu_web_audio.h b/src/apu/apu_web_audio.h
new file mode 100644
index 0000000..f2bf1e7
--- /dev/null
+++ b/src/apu/apu_web_audio.h
@@ -0,0 +1,32 @@
+#ifndef APU_WEB_AUDIO_H
+#define APU_WEB_AUDIO_H
+/* WebAssembly audio output: an AudioWorklet reading a ring in shared memory.
+ *
+ * The APU's mixer thread writes 48 kHz 16-bit stereo frames into a
+ * single-producer, single-consumer ring in wasm memory. The page's
+ * AudioWorkletProcessor (web/audio-worklet.js in the game) reads the same
+ * memory -- wasm memory is a SharedArrayBuffer, which a cross-origin
+ * isolated page may hand to its audio worklet -- on the browser's audio
+ * rendering thread. No wasm runs in the worklet and nothing passes through
+ * the page's main thread, unlike SDL's Emscripten backend
+ * (ScriptProcessorNode, which pulls samples on the main thread).
+ *
+ * Ring layout (byte offsets): 0 write index, 4 read index (frame counters,
+ * wrapping at 2^32), 8 capacity in frames (a power of two), 12 reserved,
+ * 16.. capacity * 2 int16 samples. The producer publishes with a release
+ * store of the write index; the consumer with a release store of the read
+ * index (Atomics in the worklet). */
+#ifdef __EMSCRIPTEN__
+#include <stdint.h>
+
+/* Start the worklet. Returns 0 when the browser has no AudioWorklet (the
+ * caller then uses SDL's audio); 1 means the ring accepts frames, though the
+ * worklet may still be loading. */
+int  web_audio_open(void);
+void web_audio_close(void);
+/* Frames written and not yet played. */
+uint32_t web_audio_queued(void);
+/* Append frames (interleaved stereo); returns how many fit. */
+uint32_t web_audio_put(const int16_t *frames, uint32_t count);
+#endif
+#endif
