diff --git a/src/kernel/sdlgpu/sdlgpu_vp_wgsl.inc.c b/src/kernel/sdlgpu/sdlgpu_vp_wgsl.inc.c
new file mode 100644
index 0000000..28bb6e7
--- /dev/null
+++ b/src/kernel/sdlgpu/sdlgpu_vp_wgsl.inc.c
@@ -0,0 +1,105 @@
+/* NV2A vertex programs -> WGSL. Shares the native decoder's register and
+ * paired-MAC/ILU rules, with scalar component writes (WGSL forbids assigning
+ * to multi-component swizzles). Constant-writing programs stay on the CPU. */
+#include "webgpu/sg_wgsl.h"
+
+static void sg_wgsl_src(char *out, size_t n, const uint32_t *t, int mux, int reg,
+                        int neg, const int swz[4], int scalar)
+{
+    char source[96];
+    sg_vp_src(source, sizeof source, t, mux, reg, 0, swz, scalar);
+    /* Qualify constants and apply negation as a sign-bit flip. Floating-point
+     * unary minus may canonicalize NaNs on some browser GPU backends. */
+    const char *c = strstr(source, "c[");
+    if (c)
+        snprintf(out, n, "%s%.*svc.%s%s", neg ? "vneg(" : "", (int)(c - source), source, c, neg ? ")" : "");
+    else
+        snprintf(out, n, "%s%s%s", neg ? "vneg(" : "", source, neg ? ")" : "");
+}
+
+static void sg_wgsl_write(SgText *b, const char *dst, const char *src, uint32_t mask)
+{
+    const char *xyzw = "xyzw";
+    for (unsigned k = 0; k < 4; k++)
+        if (mask & (8u >> k))
+            sg_text(b, "      %s.%c = %s.%c;\n", dst, xyzw[k], src, xyzw[k]);
+}
+
+static char *sg_vp_translate_wgsl(uint32_t start)
+{
+    SgText b = {0};
+    if (start >= VP_PROG_LEN) return NULL;
+    sg_text(&b, "%s", k_sg_vp_prelude_wgsl);
+    for (uint32_t slot = start; slot < VP_PROG_LEN; slot++) {
+        const uint32_t *t = s_vp.prog[slot];
+        uint32_t ilu = vp_field(t, 1, 25, 3), mac = vp_field(t, 1, 21, 4);
+        int mux_a = (int)vp_field(t, 2, 26, 2), mux_b = (int)vp_field(t, 2, 11, 2);
+        int mux_c = (int)vp_field(t, 3, 28, 2);
+        int reg_a = (int)vp_field(t, 2, 28, 4), reg_b = (int)vp_field(t, 2, 13, 4);
+        int reg_c = (int)((vp_field(t, 2, 0, 2) << 2) | vp_field(t, 3, 30, 2));
+        uint32_t mac_mask = vp_field(t, 3, 24, 4), ilu_mask = vp_field(t, 3, 16, 4);
+        uint32_t o_mask = vp_field(t, 3, 12, 4), out_r = vp_field(t, 3, 20, 4);
+        uint32_t orb = vp_field(t, 3, 11, 1), out_addr = vp_field(t, 3, 3, 8);
+        uint32_t out_mux = vp_field(t, 3, 2, 1);
+        int sa[4], sb[4], sc[4];
+        char A[112], B[112], C[112], dst[16];
+
+        if (mac > 13 || (o_mask && !orb &&
+            ((out_mux == 0 && mac && mac != 13) || (out_mux == 1 && ilu)))) {
+            free(b.p);
+            return NULL;
+        }
+        for (int k = 0; k < 4; k++) {
+            sa[k] = (int)vp_field(t, 1, 6 - k * 2, 2);
+            sb[k] = (int)vp_field(t, 2, 23 - k * 2, 2);
+            sc[k] = (int)vp_field(t, 2, 8 - k * 2, 2);
+        }
+        sg_wgsl_src(A, sizeof A, t, mux_a, reg_a, (int)vp_field(t, 1, 8, 1), sa, 0);
+        sg_wgsl_src(B, sizeof B, t, mux_b, reg_b, (int)vp_field(t, 2, 25, 1), sb, 0);
+        sg_wgsl_src(C, sizeof C, t, mux_c, reg_c, (int)vp_field(t, 2, 10, 1), sc, ilu >= 2 && ilu <= 6);
+        sg_text(&b, "    { let A = %s; let B = %s; let C = %s; var m = vec4f(0.0); var il = vec4f(0.0); var na0 = a0;\n", A, B, C);
+        switch (mac) {
+        case 1: sg_text(&b, "      m = A;\n"); break;
+        case 2: sg_text(&b, "      m = vmul(A, B);\n"); break;
+        case 3: sg_text(&b, "      m = A + C;\n"); break;
+        case 4: sg_text(&b, "      m = vmul(A, B) + C;\n"); break;
+        case 5: sg_text(&b, "      m = vec4f(vdot3(A, B));\n"); break;
+        case 6: sg_text(&b, "      m = vec4f(vdot3(A, B) + B.w);\n"); break;
+        case 7: sg_text(&b, "      m = vec4f(vdot4(A, B));\n"); break;
+        case 8: sg_text(&b, "      m = vec4f(1.0, vmul1(A.y, B.y), A.z, B.w);\n"); break;
+        case 9: sg_text(&b, "      m = select(B, A, A < B);\n"); break;
+        case 10: sg_text(&b, "      m = select(B, A, A >= B);\n"); break;
+        case 11: sg_text(&b, "      m = select(vec4f(0.0), vec4f(1.0), vlt(A, B));\n"); break;
+        case 12: sg_text(&b, "      m = select(vec4f(0.0), vec4f(1.0), vge(A, B));\n"); break;
+        case 13: sg_text(&b, "      na0 = i32(floor(A.x + 0.001));\n"); break;
+        default: break;
+        }
+        switch (ilu) {
+        case 1: sg_text(&b, "      il = C;\n"); break;
+        case 2: sg_text(&b, "      il = vec4f(vrcp(C.x));\n"); break;
+        case 3: sg_text(&b, "      il = vec4f(vrcc(C.x));\n"); break;
+        case 4: sg_text(&b, "      il = vec4f(vrsq(C.x));\n"); break;
+        case 5: sg_text(&b, "      il = vexp(C.x);\n"); break;
+        case 6: sg_text(&b, "      il = vlog(C.x);\n"); break;
+        case 7: sg_text(&b, "      il = vlit(C);\n"); break;
+        default: break;
+        }
+        if (out_r == 12) snprintf(dst, sizeof dst, "O[0]");
+        else snprintf(dst, sizeof dst, "R[%u]", out_r < 13 ? out_r : 0);
+        if (mac && mac != 13 && mac_mask && !(ilu && out_r == 1))
+            sg_wgsl_write(&b, dst, "m", mac_mask);
+        if (ilu && ilu_mask)
+            sg_wgsl_write(&b, mac ? "R[1]" : dst, "il", ilu_mask);
+        if (o_mask && orb && ((out_mux == 0 && mac && mac != 13) || (out_mux == 1 && ilu))) {
+            snprintf(dst, sizeof dst, "O[%u]", out_addr & 15u);
+            sg_wgsl_write(&b, dst, out_mux ? "il" : "m",
+                           (out_addr & 15u) == 5 ? vp_fog_write_mask(o_mask) : o_mask);
+        }
+        if (mac == 13) sg_text(&b, "      a0 = na0;\n");
+        sg_text(&b, "    }\n");
+        if (vp_field(t, 3, 0, 1)) break;
+    }
+    sg_text(&b, "%s", k_sg_vp_epilogue_wgsl);
+    if (b.failed) { free(b.p); return NULL; }
+    return b.p;
+}
diff --git a/src/kernel/sdlgpu/shaders/vp.wgsl b/src/kernel/sdlgpu/shaders/vp.wgsl
new file mode 100644
index 0000000..f0555f5
--- /dev/null
+++ b/src/kernel/sdlgpu/shaders/vp.wgsl
@@ -0,0 +1,151 @@
+// Runtime-specialized NV2A vertex programs. tools/gen-wgsl.py embeds the
+// two halves; the C translator inserts straight-line instructions between them.
+struct VpUniforms {
+    c: array<vec4f, 192>,
+    info: vec4f,
+    clipr: vec4f,
+    fogp: vec4f,
+    lightp: vec4f,
+}
+@group(1) @binding(0) var<uniform> vc: VpUniforms;
+struct VpInputs {
+    @location(0) v0: vec4f, @location(1) v1: vec4f,
+    @location(2) v2: vec4f, @location(3) v3: vec4f,
+    @location(4) v4: vec4f, @location(5) v5: vec4f,
+    @location(6) v6: vec4f, @location(7) v7: vec4f,
+    @location(8) v8: vec4f, @location(9) v9: vec4f,
+    @location(10) v10: vec4f, @location(11) v11: vec4f,
+    @location(12) v12: vec4f, @location(13) v13: vec4f,
+    @location(14) v14: vec4f, @location(15) v15: vec4f,
+}
+struct VpOutputs {
+    @builtin(position) position: vec4f,
+    @location(0) color: vec4f, @location(1) specular: vec4f,
+    @location(2) t0: vec4f, @location(3) t1: vec4f,
+    @location(4) t2: vec4f, @location(5) t3: vec4f,
+    @location(6) fog: f32, @location(7) w: f32,
+}
+fn vnan(x: f32) -> bool { return (bitcast<u32>(x) & 0x7fffffffu) > 0x7f800000u; }
+fn vinf(x: f32) -> bool { return (bitcast<u32>(x) & 0x7fffffffu) == 0x7f800000u; }
+// WGSL rejects NaN/Inf in constant expressions. A function parameter keeps
+// the bitcast a runtime expression, as required for NV2A exceptional math.
+fn vexception(bits: u32) -> f32 { return bitcast<f32>(bits); }
+// Preserve signed zeros and NaN signs through driver optimizations.
+fn vneg(x: vec4f) -> vec4f { return bitcast<vec4f>(bitcast<vec4u>(x) ^ vec4u(0x80000000u)); }
+fn vcompare_key(x: f32) -> u32 {
+    var bits = bitcast<u32>(x);
+    if ((bits & 0x7fffffffu) > 0x7f800000u) { bits = (bits & 0x80000000u) | 0x7fc00000u; }
+    return select(bits ^ 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);
+}
+fn vlt(a: vec4f, b: vec4f) -> vec4<bool> {
+    return vec4<bool>(vcompare_key(a.x)<vcompare_key(b.x), vcompare_key(a.y)<vcompare_key(b.y),
+                      vcompare_key(a.z)<vcompare_key(b.z), vcompare_key(a.w)<vcompare_key(b.w));
+}
+fn vge(a: vec4f, b: vec4f) -> vec4<bool> {
+    return vec4<bool>(vcompare_key(a.x)>=vcompare_key(b.x), vcompare_key(a.y)>=vcompare_key(b.y),
+                      vcompare_key(a.z)>=vcompare_key(b.z), vcompare_key(a.w)>=vcompare_key(b.w));
+}
+fn vmul1(a: f32, b: f32) -> f32 {
+    // NV2A MUL/MAD return positive zero for any product with a zero operand,
+    // including infinity and NaN. Handle this before propagating NaNs.
+    if (a == 0.0 || b == 0.0) { return 0.0; }
+    if (vnan(a) || vnan(b)) { return vexception(0x7fc00000u); }
+    return a * b;
+}
+fn vmul(a: vec4f, b: vec4f) -> vec4f {
+    return vec4f(vmul1(a.x,b.x), vmul1(a.y,b.y), vmul1(a.z,b.z), vmul1(a.w,b.w));
+}
+fn vdot3(a: vec4f, b: vec4f) -> f32 {
+    let p = vmul(a,b); return (p.x + p.y) + p.z;
+}
+fn vdot4(a: vec4f, b: vec4f) -> f32 {
+    let p = vmul(a,b); return ((p.x + p.y) + p.z) + p.w;
+}
+fn vrcp(x: f32) -> f32 {
+    if (x == 1.0) { return 1.0; }
+    let sign = bitcast<u32>(x) & 0x80000000u;
+    if (x == 0.0) { return vexception(0x7f800000u | sign); }
+    if (vinf(x)) { return vexception(sign); }
+    if (vnan(x)) { return vexception(0x7fc00000u); }
+    return 1.0 / x;
+}
+fn vrcc(x: f32) -> f32 {
+    if (vnan(x)) { return vexception(0x7fc00000u); }
+    return vclampw(vrcp(x));
+}
+fn vrsq(x: f32) -> f32 {
+    let a = abs(x);
+    if (a == 1.0) { return 1.0; }
+    if (a == 0.0) { return vexception(0x7f800000u); }
+    if (vinf(a)) { return 0.0; }
+    if (vnan(a)) { return vexception(0x7fc00000u); }
+    return inverseSqrt(a);
+}
+fn vexp(x: f32) -> vec4f { let f = floor(x); return vec4f(exp2(f), x - f, exp2(x), 1.0); }
+fn vlog(x: f32) -> vec4f {
+    let a = abs(x);
+    if (a == 0.0) { return vec4f(vexception(0xff800000u), 1.0, vexception(0xff800000u), 1.0); }
+    let e = floor(log2(a));
+    return vec4f(e, a / exp2(e), log2(a), 1.0);
+}
+fn vlit(s: vec4f) -> vec4f {
+    let sx = select(s.x, 0.0, s.x < 0.0);
+    let sy = select(s.y, 0.0, s.y < 0.0);
+    let sw = clamp(s.w, -127.99609375, 127.99609375);
+    var z = 0.0;
+    if (sx > 0.0) {
+        // log2(0) is not portable WGSL arithmetic. Preserve NV2A's zero-base
+        // outcomes explicitly, including negative and zero exponents.
+        if (sy == 0.0) {
+            if (sw < 0.0) { z = vexception(0x7f800000u); }
+            else if (sw == 0.0) { z = 1.0; }
+            else if (vnan(sw)) { z = vexception(0x7fc00000u); }
+        } else { z = exp2(vmul1(sw, log2(sy))); }
+    }
+    return vec4f(1.0, sx, z, 1.0);
+}
+fn vclampw(w: f32) -> f32 {
+    if ((bitcast<u32>(w) & 0x80000000u) == 0u) {
+        return clamp(w, bitcast<f32>(0x1f800000u), bitcast<f32>(0x5f800000u));
+    }
+    return clamp(w, bitcast<f32>(0xdf800000u), bitcast<f32>(0x9f800000u));
+}
+@vertex fn main(vin: VpInputs) -> VpOutputs {
+    let v = array<vec4f, 16>(vin.v0, vin.v1, vin.v2, vin.v3, vin.v4, vin.v5, vin.v6, vin.v7,
+                           vin.v8, vin.v9, vin.v10, vin.v11, vin.v12, vin.v13, vin.v14, vin.v15);
+    var R: array<vec4f, 13>;
+    var O: array<vec4f, 16>;
+    var a0 = 0;
+    for (var k = 0u; k < 16u; k++) { O[k] = vec4f(0.0, 0.0, 0.0, 1.0); }
+// INSERT_PROGRAM
+    let p = O[0];
+    let w = vclampw(p.w);
+    let nx = (p.x + vc.info.w) / vc.info.x * 2.0 - 1.0;
+    let ny = 1.0 - p.y / vc.info.y * 2.0;
+    var nz = p.z / vc.info.z;
+    // Guest depth clamp is independent of clipping against the eye plane.
+    if (vc.lightp.z != 0.0) { nz = clamp(nz, 0.0, 1.0); }
+    var position = vec4f(nx * w, ny * w, nz * w, w);
+    if (vnan(p.x) || vnan(p.y) || vnan(p.w)) { position = vec4f(vexception(0x7fc00000u)); }
+    var d0 = O[3]; var d1 = O[4];
+    for (var k = 0u; k < 4u; k++) {
+        if (vnan(d0[k])) { d0[k] = 1.0; }
+        if (vnan(d1[k])) { d1[k] = 1.0; }
+    }
+    d0 = clamp(d0, vec4f(0.0), vec4f(1.0));
+    d1 = clamp(d1, vec4f(0.0), vec4f(1.0));
+    if (vc.lightp.x == 0.0) { d1 = vec4f(0.0, 0.0, 0.0, 1.0); }
+    if (vc.lightp.y == 0.0) { d1.w = 1.0; }
+    let fd = O[5].x; var ff = 1.0; var exceptional = 0.0;
+    let fm = bitcast<u32>(vc.fogp.y);
+    if (vc.fogp.x != 0.0) {
+        if (fm == 0x2601u || fm == 0x804u) { ff = vc.fogp.z + fd * vc.fogp.w - 1.0; }
+        else if (fm == 0x800u || fm == 0x802u) { ff = vc.fogp.z + exp2(fd * vc.fogp.w * 16.0) - 1.5; }
+        else if (fm == 0x801u || fm == 0x803u) { ff = vc.fogp.z + exp2(-fd * fd * vc.fogp.w * vc.fogp.w * 32.0) - 1.5; }
+        if (fm == 0x2601u || fm == 0x804u || fm == 0x800u) { exceptional = 1.0; }
+        if (fm == 0x804u || fm == 0x802u || fm == 0x803u) { ff = abs(ff); }
+        if (vinf(fd) || vnan(ff)) { ff = exceptional; }
+        else { ff = clamp(ff, -bitcast<f32>(0x7f7fffffu), bitcast<f32>(0x7f7fffffu)); }
+    }
+    return VpOutputs(position, d0, d1, O[9], O[10], O[11], O[12], ff, w);
+}
