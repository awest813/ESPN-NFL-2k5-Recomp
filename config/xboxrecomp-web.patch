+        command = SDL_AcquireGPUCommandBuffer(dev); copy = SDL_BeginGPUCopyPass(command);
+        SDL_DownloadFromGPUTexture(copy, &region, &src); SDL_EndGPUCopyPass(copy);
+        CHECK(!SDL_SubmitGPUCommandBuffer(command), "texture readback rejects an undersized destination");
+        src.offset = 0; src.pixels_per_row = UINT32_MAX;
+        command = SDL_AcquireGPUCommandBuffer(dev); copy = SDL_BeginGPUCopyPass(command);
+        SDL_UploadToGPUTexture(copy, &src, &region, false); SDL_EndGPUCopyPass(copy);
+        CHECK(!SDL_SubmitGPUCommandBuffer(command), "oversized row stride rejects without integer wraparound");
+        SDL_ReleaseGPUTransferBuffer(dev, transfer); SDL_ReleaseGPUTexture(dev, small);
+        SDL_ClearError();
+    }
+
+    /* 1. Clear and download, byte for byte. */
+    Draw d = { .color = color, .depth = depth, .clear_color = 1, .clear_argb = 0xFF2040C0u, .clear_depth = 1, .depth_value = 1.0f };
+    draw(&d);
+    download(color, 0, W, H, img);
+    CHECK(px(img, 0, 0) == 0xFF2040C0u && px(img, W - 1, H - 1) == 0xFF2040C0u && px(img, 123, 77) == 0xFF2040C0u,
+          "clear then download: %08X (FF2040C0 expected)", px(img, 123, 77));
+
+    /* 2. Upload and download round trip; 300-pixel rows are not 256-byte aligned. */
+    {
+        static uint8_t up[300 * 7 * 4], back[300 * 7 * 4];
+        for (size_t i = 0; i < sizeof up; i++) up[i] = (uint8_t)(i * 7 + 3);
+        SDL_GPUTexture *t = make_tex(SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM, SDL_GPU_TEXTUREUSAGE_COLOR_TARGET, 300, 7, 1);
