+#version 450
+// Conservative line candidates; each primitive selects its original endpoint pair.
+layout(location=0) in vec2 in_pos;
+layout(location=1) in float in_index;
+layout(location=0) flat out float v_line_index;
+layout(set=1,binding=0) uniform Viewport {vec2 surface_size;} vp;
+void main() {
+    vec2 ndc=in_pos/vp.surface_size*2.0-1.0;
+    gl_Position=vec4(ndc.x,-ndc.y,0.5,1.0);
+    v_line_index=in_index;
+}
