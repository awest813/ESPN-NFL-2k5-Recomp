diff --git a/tests/wasm_fixed/test_wasm_fixed.c b/tests/wasm_fixed/test_wasm_fixed.c
new file mode 100644
index 0000000..48c0d26
--- /dev/null
+++ b/tests/wasm_fixed/test_wasm_fixed.c
@@ -0,0 +1,65 @@
+/* wasm_fixed: fixed claims land where asked, refuse host memory and double
+ * claims, and the host heap never grows into a fixed window -- even when the
+ * program allocates until malloc gives up. Run under Node (see CMakeLists). */
+#include "wasm_fixed.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern char __global_base;
+static int failures;
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); failures++; } } while (0)
+
+int main(void)
+{
+    uint8_t *ram    = (uint8_t *)0x00010000u;   /* guest RAM view */
+    uint8_t *contig = (uint8_t *)0x80010000u;   /* contiguous window */
+    uint8_t *top    = (uint8_t *)0xFD010000u;   /* device apertures */
+    const size_t MB = 1024u * 1024u;
+
+    CHECK((uintptr_t)&__global_base >= 0x10000u + 128u * MB);
+    CHECK(wasm_fixed_map(ram, 128 * MB) == ram);
+    CHECK(wasm_fixed_map(contig, 64 * MB) == contig);
+    CHECK(wasm_fixed_map(top, 16 * MB) == top);
+    CHECK(wasm_fixed_map(ram + MB, MB) == NULL);            /* overlaps a claim */
+    CHECK(wasm_fixed_map((void *)0x09000000u, MB) == NULL); /* host memory */
+    CHECK(wasm_fixed_map((void *)0x7FF00000u, 2 * MB) == NULL); /* straddles the ceiling */
+    CHECK(wasm_fixed_claimed(contig + 4, 4));
+    CHECK(!wasm_fixed_claimed(contig + 64 * MB, 4));
+
+    /* Fresh claims read as zero; then fill the windows with a pattern. */
+    CHECK(ram[0] == 0 && contig[64 * MB - 1] == 0 && top[5] == 0);
+    memset(ram, 0xA5, 128 * MB);
+    memset(contig, 0x5A, 64 * MB);
+    memset(top, 0xC3, 16 * MB);
+
+    /* Exhaust the heap. Every block must be host memory, and none may reach
+     * a window; afterwards the patterns must be intact. */
+    size_t total = 0, n = 0;
+    uintptr_t highest = 0;
+    for (;;) {
+        uint8_t *p = malloc(16 * MB);
+        if (!p) break;
+        CHECK((uintptr_t)p >= (uintptr_t)&__global_base);
+        CHECK((uintptr_t)p + 16 * MB <= WASM_FIXED_CEILING);
+        if ((uintptr_t)p + 16 * MB > highest) highest = (uintptr_t)p + 16 * MB;
+        p[0] = 1; p[16 * MB - 1] = 1;
+        total += 16 * MB; n++;
+    }
+    printf("heap: %zu MB in %zu blocks, highest end 0x%08lX\n",
+           total / MB, n, (unsigned long)highest);
+    CHECK(total >= 1024 * MB);   /* the host still has ~1.8 GB */
+    for (size_t i = 0; i < 128 * MB; i += 4093) CHECK(ram[i] == 0xA5);
+    for (size_t i = 0; i < 64 * MB; i += 4093)  CHECK(contig[i] == 0x5A);
+    for (size_t i = 0; i < 16 * MB; i += 4093)  CHECK(top[i] == 0xC3);
+
+    /* Release and reclaim: the range is zeroed like a fresh mapping. */
+    CHECK(wasm_fixed_unmap(top) == 16 * MB);
+    CHECK(wasm_fixed_map(top, 16 * MB) == top);
+    CHECK(top[0] == 0 && top[16 * MB - 1] == 0);
+
+    if (failures) { printf("%d failure(s)\n", failures); return 1; }
+    printf("wasm_fixed: all checks passed\n");
+    return 0;
+}
