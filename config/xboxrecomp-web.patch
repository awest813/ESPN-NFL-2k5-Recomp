+        draw(&d); /* overwrite the original surface */
+        d.tex = snapshot;
+        d.shade.tex_size[0] = W; d.shade.tex_size[1] = H;
+        draw(&d);
+        download(color, 0, W, H, img);
+        CHECK(px(img, 1, 1) == 0xFF00FF00u, "GPU surface snapshot retains pixels after source overwrite");
