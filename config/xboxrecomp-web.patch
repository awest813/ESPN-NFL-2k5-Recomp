+int xbox_Nv2aWaitFence(uint32_t semaphore_va, uint32_t target)
+{
+    if (!pb_async_on() || (semaphore_va & 3u) || !fence_readable(semaphore_va, 4))
+        return 0;
+    volatile uint32_t *fence = (volatile uint32_t *)((uintptr_t)semaphore_va + g_memory_offset);
+    uint32_t value = __atomic_load_n(fence, __ATOMIC_ACQUIRE);
+    if ((int32_t)(value - target) >= 0) return 1;
+    int depth = xbox_ggl_release_all();
+    do {
+        /* The expected-value check also handles a release between our load
+         * and the wait. A timeout covers guest stores outside the executor. */
+        emscripten_futex_wait((void *)fence, value, 10.0);
+        value = __atomic_load_n(fence, __ATOMIC_ACQUIRE);
+    } while ((int32_t)(value - target) < 0);
+    xbox_ggl_reacquire(depth);
+    return 1;
+}
