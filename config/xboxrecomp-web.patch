diff --git a/src/platform/wasm_fixed.c b/src/platform/wasm_fixed.c
new file mode 100644
index 0000000..2a4cc10
--- /dev/null
+++ b/src/platform/wasm_fixed.c
@@ -0,0 +1,141 @@
+/* Fixed-address memory for WebAssembly builds. See wasm_fixed.h. */
+#ifdef __EMSCRIPTEN__
+#include "wasm_fixed.h"
+
+#include <emscripten/heap.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+
+extern char __global_base;   /* wasm-ld: start of static data (-sGLOBAL_BASE) */
+
+#define MAX_CLAIMS   64
+#define MAX_RELEASED 64
+
+typedef struct { uintptr_t lo, hi; } Range;
+
+/* Writers (map, unmap) serialise on s_lock. Readers (wasm_fixed_claimed, on
+ * the checked-copy path the GPU uses per draw) take no lock: slots are never
+ * moved, a slot is published by storing hi last, and an unmapped slot is
+ * emptied by storing hi = 0 first. A reader racing an unmap may still see
+ * the claim, which is harmless -- the memory does not go anywhere. */
+static pthread_mutex_t s_lock = PTHREAD_MUTEX_INITIALIZER;
+static Range s_claims[MAX_CLAIMS];
+static int   s_claim_count;   /* slots ever used; empty slots have hi == 0 */
+/* Ranges that were claimed and released: the guest wrote there, so a new
+ * claim over them must zero them. Everything else is still pristine. */
+static Range s_released[MAX_RELEASED];
+static int   s_released_count;
+
+static int overlaps(Range a, Range b) { return a.lo < b.hi && b.lo < a.hi; }
+
+static int in_fixed_window(uintptr_t lo, uintptr_t hi)
+{
+    uintptr_t low_end = (uintptr_t)&__global_base;
+    if (hi <= low_end)
+        return 1;
+    return lo >= WASM_FIXED_CEILING;
+}
+
+void *wasm_fixed_map(void *address, size_t size)
+{
+    uintptr_t lo = (uintptr_t)address;
+    Range r;
+    void *result = NULL;
+
+    /* Address 0 is the host's NULL; a mapping there could not be told apart
+     * from a failure. Nothing needs it (XBE images start at 0x10000). */
+    if (!address || !size || size > UINTPTR_MAX - lo)
+        return NULL;
+    r.lo = lo;
+    r.hi = lo + size;
+    if (!in_fixed_window(r.lo, r.hi))
+        return NULL;
+
+    pthread_mutex_lock(&s_lock);
+    int slot = -1;
+    for (int i = 0; i < s_claim_count; i++) {
+        if (!s_claims[i].hi) { if (slot < 0) slot = i; continue; }
+        if (overlaps(s_claims[i], r))
+            goto out;
+    }
+    if (slot < 0 && s_claim_count == MAX_CLAIMS)
+        goto out;
+    /* The memory must exist before anyone touches it. Growth only ever adds
+     * zeroed pages, and the heap ceiling means the host never used them. */
+    if (r.hi > emscripten_get_heap_size() && !emscripten_resize_heap(r.hi)) {
+        fprintf(stderr, "wasm_fixed_map: cannot grow memory to 0x%08lX\n",
+                (unsigned long)r.hi);
+        goto out;
+    }
+    for (int i = 0; i < s_released_count; i++) {
+        if (overlaps(s_released[i], r)) {
+            uintptr_t a = s_released[i].lo > r.lo ? s_released[i].lo : r.lo;
+            uintptr_t b = s_released[i].hi < r.hi ? s_released[i].hi : r.hi;
+            memset((void *)a, 0, b - a);
+        }
+    }
+    if (slot < 0)
+        slot = s_claim_count;
+    __atomic_store_n(&s_claims[slot].lo, r.lo, __ATOMIC_RELAXED);
+    __atomic_store_n(&s_claims[slot].hi, r.hi, __ATOMIC_RELEASE);
+    if (slot == s_claim_count)
+        __atomic_store_n(&s_claim_count, s_claim_count + 1, __ATOMIC_RELEASE);
+    result = address;
+out:
+    pthread_mutex_unlock(&s_lock);
+    return result;
+}
+
+size_t wasm_fixed_unmap(const void *address)
+{
+    size_t size = 0;
+    pthread_mutex_lock(&s_lock);
+    for (int i = 0; i < s_claim_count; i++) {
+        if (s_claims[i].hi && s_claims[i].lo == (uintptr_t)address) {
+            Range gone = s_claims[i];
+            size = gone.hi - gone.lo;
+            __atomic_store_n(&s_claims[i].hi, 0, __ATOMIC_RELEASE);
+            if (s_released_count < MAX_RELEASED)
+                s_released[s_released_count++] = gone;
+            else  /* out of bookkeeping: zero now rather than track it */
+                memset((void *)gone.lo, 0, size);
+            break;
+        }
+    }
+    pthread_mutex_unlock(&s_lock);
+    return size;
+}
+
+int wasm_fixed_claimed(const void *address, size_t size)
+{
+    uintptr_t lo = (uintptr_t)address;
+    int n = __atomic_load_n(&s_claim_count, __ATOMIC_ACQUIRE);
+    for (int i = 0; i < n; i++) {
+        uintptr_t hi = __atomic_load_n(&s_claims[i].hi, __ATOMIC_ACQUIRE);
+        uintptr_t c_lo = __atomic_load_n(&s_claims[i].lo, __ATOMIC_RELAXED);
+        if (hi && lo >= c_lo && lo < hi && size <= hi - lo)
+            return 1;
+    }
+    return 0;
+}
+
+/* The heap ceiling. Linked with --wrap=sbrk, so every sbrk call outside libc's
+ * own sbrk.o -- dlmalloc's included -- lands here. Growth past the ceiling
+ * fails with ENOMEM, which malloc reports as out of memory, instead of
+ * handing the host memory that a guest region owns. */
+void *__real_sbrk(intptr_t increment);
+
+void *__wrap_sbrk(intptr_t increment)
+{
+    uintptr_t brk = *emscripten_get_sbrk_ptr();
+    /* sbrk treats the increment as unsigned in 32-bit builds (see libc's
+     * sbrk.c), so a "negative" one is a huge request and is refused too. */
+    if ((uintptr_t)increment > WASM_FIXED_CEILING - brk || brk > WASM_FIXED_CEILING) {
+        errno = ENOMEM;
+        return (void *)-1;
+    }
+    return __real_sbrk(increment);
+}
+#endif
