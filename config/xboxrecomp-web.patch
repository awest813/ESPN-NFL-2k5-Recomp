diff --git a/tools/recomp/test_flag_reachability.py b/tools/recomp/test_flag_reachability.py
new file mode 100644
index 0000000..0ee749d
--- /dev/null
+++ b/tools/recomp/test_flag_reachability.py
@@ -0,0 +1,37 @@
+"""Flag inference follows executable paths, not decoded table/padding bytes."""
+from tools.recomp import config
+from tools.recomp.translator import FunctionTranslator
+
+BASE = 0x10000
+
+
+def translate(image, targets=None):
+    config._install([config.Section('.text', BASE, len(image), 0, len(image), True)],
+                    entry_point=BASE, kernel_thunk_addr=BASE, origin='flag-reachability-test')
+    info = {'_addr': BASE, 'start': hex(BASE), 'end': BASE + len(image), 'size': len(image)}
+    translator = FunctionTranslator(image, {BASE: info})
+    if targets is not None:
+        translator.lifter._analyze_switch_table = lambda operands: targets
+    return translator.translate_function(BASE, info)
+
+
+def test_dead_predecessor_cannot_poison_cmp_after_register_overwrite():
+    # cmp eax,1; jmp join; dead:add edx,1; jmp join;
+    # join:mov eax,ebx; jne taken; mov eax,0;ret; taken:mov eax,1;ret
+    code = translate(bytes.fromhex('83f801eb0583c201eb0089d87506b800000000c3b801000000c3'))
+    assert 'CMP_NE(_fa, _fb)' in code, code
+    assert 'RECOMP_FLAGS_FALLBACK' not in code, code
+    assert 'eax = ebx;' in code
+
+
+def test_real_conflicting_paths_remain_unknown():
+    # Both the cmp and add paths are reachable from test edi,edi; jz alternate.
+    code = translate(bytes.fromhex('85ff740583f801eb0383c2017506b800000000c3b801000000c3'))
+    assert 'RECOMP_FLAGS_FALLBACK' in code, code
+
+
+def test_recovered_switch_cases_inherit_dispatch_comparison():
+    # cmp eax,1; jmp [edx*4+20000h]; two cases each consume its flags.
+    code = translate(bytes.fromhex('83f801ff2495000002007501c3c37501c3c3'), [BASE + 10, BASE + 14])
+    assert code.count('if (CMP_NE(_fa, _fb))') == 2, code
+    assert 'RECOMP_FLAGS_FALLBACK' not in code, code
