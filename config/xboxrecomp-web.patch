+static void test_guest_culling(void)
+{
+    SgXfList list = {0};
+    XfVert a = {.x=0, .y=0, .w=1, .ok=1};
+    XfVert b = {.x=100, .y=0, .w=1, .ok=1};
+    XfVert c = {.x=0, .y=100, .w=1, .ok=1};
+    SgPipeKey key;
+    s_vp.cull = 1; s_vp.cull_face = 0x0405; s_vp.front_face = 0x0900;
+    sg_collect_xf(&list, &a, &b, &c);
+    CHECK(list.count == 3, "guest CW front face disappeared");
+    list.count = 0;
+    sg_collect_xf(&list, &a, &c, &b);
+    CHECK(list.count == 0, "guest back face rendered with default culling");
+    CHECK(sg_pipeline_key(1, 1, &key) && ((key.color >> 18) & 3u) == 2u
+        && (key.color & (1u << 20)), "GPU VP key ignored guest CW/back culling");
+    s_vp.front_face = 0x0901;
+    sg_collect_xf(&list, &a, &c, &b);
+    CHECK(list.count == 3, "guest CCW front face disappeared");
+    list.count = 0;
+    s_vp.cull_face = 0x0404;
+    sg_collect_xf(&list, &a, &c, &b);
+    CHECK(list.count == 0, "guest front-face culling ignored");
+    CHECK(sg_pipeline_key(1, 1, &key) && ((key.color >> 18) & 3u) == 1u
+        && !(key.color & (1u << 20)), "GPU VP key ignored guest CCW/front culling");
+    s_vp.cull_face = 0x0408;
+    sg_collect_xf(&list, &a, &b, &c);
+    CHECK(list.count == 0 && !sg_pipeline_key(1, 1, &key), "front-and-back culling did not discard");
