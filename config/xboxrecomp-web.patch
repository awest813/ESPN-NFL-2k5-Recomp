+    numreg1 = dsp->disasm_cur_inst & BITMASK(6);
+
+    if (dsp->disasm_cur_inst & (1<<15)) {
+        /* Write D1 */
+        sprintf(dsp->disasm_str_instr,"movec %s,%s", registers_name[numreg2], registers_name[numreg1]);
+    } else {
