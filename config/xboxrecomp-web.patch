diff --git a/src/kernel/irq_profile.h b/src/kernel/irq_profile.h
new file mode 100644
index 0000000..bdb0b56
--- /dev/null
+++ b/src/kernel/irq_profile.h
@@ -0,0 +1,109 @@
+/* Optional signal-to-service timing for the shared IRQ/DPC worker.
+ * Win32-compatible primitives must already be declared by the including TU.
+ * This records coalesced notifications, not hardware line-assertion duration.
+ */
+#pragma once
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+
+enum {IRQ_PROFILE_WAIT,IRQ_PROFILE_GGL,IRQ_PROFILE_VBLANK,IRQ_PROFILE_ISR,
+      IRQ_PROFILE_DPC,IRQ_PROFILE_OTHER};
+typedef struct {int64_t asked,locked,isr_begin;} BridgeIrqTimes;
+typedef struct {
+    int started;int64_t since;
+    unsigned calls,samples,missing,discarded,uncallable,declined;
+    int64_t age,prelock,ggl,vblank,isr,max_isr,max_dpc;
+    unsigned raised_stage;
+} BridgeIrqStats;
+static INIT_ONCE s_irq_profile_once=INIT_ONCE_STATIC_INIT;
+static int s_irq_profile_on;
+static LARGE_INTEGER s_irq_profile_frequency;
+static volatile LONGLONG s_irq_profile_pending;
+static volatile LONG s_irq_profile_stage,s_irq_profile_coalesced;
+static BridgeIrqStats s_irq_profile_stats;
+
+static BOOL WINAPI bridge_irq_profile_init(PINIT_ONCE once,PVOID param,PVOID *context) {
+    (void)once;(void)param;(void)context;
+    s_irq_profile_on=getenv("RECOMP_IRQ_PROFILE")!=NULL;
+    if(s_irq_profile_on && (!QueryPerformanceFrequency(&s_irq_profile_frequency) ||
+       s_irq_profile_frequency.QuadPart<=0))s_irq_profile_on=0;
+    return TRUE;
+}
+static int bridge_irq_profile_enabled(void) {
+    InitOnceExecuteOnce(&s_irq_profile_once,bridge_irq_profile_init,NULL,NULL);
+    return s_irq_profile_on;
+}
+static int64_t bridge_irq_profile_clock(void) {
+    LARGE_INTEGER now;QueryPerformanceCounter(&now);
+    int64_t frequency=s_irq_profile_frequency.QuadPart;
+    return (now.QuadPart/frequency)*1000000+(now.QuadPart%frequency)*1000000/frequency;
+}
+static LONGLONG bridge_irq_profile_exchange(volatile LONGLONG *p,LONGLONG value) {
+    LONGLONG old=InterlockedCompareExchange64(p,0,0),seen;
+    while((seen=InterlockedCompareExchange64(p,value,old))!=old)old=seen;
+    return old;
+}
+static void bridge_irq_profile_phase(unsigned stage) {
+    if(bridge_irq_profile_enabled())InterlockedExchange(&s_irq_profile_stage,(LONG)stage);
+}
+static int64_t bridge_irq_profile_stamp(unsigned stage) {
+    if(!bridge_irq_profile_enabled())return 0;
+    InterlockedExchange(&s_irq_profile_stage,(LONG)stage);
+    return bridge_irq_profile_clock();
+}
+static void bridge_irq_profile_signal(void) {
+    if(!bridge_irq_profile_enabled())return;
+    uint64_t now=(uint64_t)bridge_irq_profile_clock();
+    unsigned stage=(unsigned)InterlockedCompareExchange(&s_irq_profile_stage,0,0);
+    /* One atomic word publishes time and phase together. Zero means empty;
+     * retain the first notification when the auto-reset event coalesces. */
+    LONGLONG token=(LONGLONG)(((now+1)<<3)|(stage&7u));
+    if(InterlockedCompareExchange64(&s_irq_profile_pending,token,0)!=0)
+        InterlockedIncrement(&s_irq_profile_coalesced);
+}
+static LONGLONG bridge_irq_profile_take(void) {
+    return bridge_irq_profile_enabled()?bridge_irq_profile_exchange(&s_irq_profile_pending,0):0;
+}
+static int64_t bridge_irq_profile_span(int64_t begin,int64_t end,int64_t raised) {
+    if(begin<raised)begin=raised;
+    return end>begin?end-begin:0;
+}
+static void bridge_irq_profile_record(LONGLONG token,const BridgeIrqTimes *t,int64_t end,int result) {
+    if(!bridge_irq_profile_enabled())return;
+    BridgeIrqStats *s=&s_irq_profile_stats;s->calls++;
+    if(result<0)s->uncallable++;else if(!result)s->declined++;
+    int64_t isr=end>t->isr_begin?end-t->isr_begin:0;
+    if(isr>s->max_isr)s->max_isr=isr;
+    if(!token){s->missing++;return;}
+    int64_t raised=(int64_t)((uint64_t)token>>3)-1;
+    int64_t age=t->isr_begin>raised?t->isr_begin-raised:0;
+    s->samples++;
+    if(s->samples==1 || age>s->age) {
+        s->age=age;s->raised_stage=(unsigned)((uint64_t)token&7u);
+        s->prelock=t->asked>raised?t->asked-raised:0;
+        s->ggl=bridge_irq_profile_span(t->asked,t->locked,raised);
+        s->vblank=bridge_irq_profile_span(t->locked,t->isr_begin,raised);
+        s->isr=isr;
+    }
+}
+static void bridge_irq_profile_discard(LONGLONG token) {
+    if(token && bridge_irq_profile_enabled())s_irq_profile_stats.discarded++;
+}
+static void bridge_irq_profile_finish(int64_t begin) {
+    if(!bridge_irq_profile_enabled())return;
+    int64_t now=bridge_irq_profile_stamp(IRQ_PROFILE_OTHER);
+    BridgeIrqStats *s=&s_irq_profile_stats;
+    if(now>begin && now-begin>s->max_dpc)s->max_dpc=now-begin;
+    if(!s->started){s->started=1;s->since=now;return;}
+    if(now-s->since<5000000)return;
+    static const char *names[]={"wait","ggl","vblank","isr","dpc","other"};
+    unsigned phase=s->raised_stage<6?s->raised_stage:IRQ_PROFILE_OTHER;
+    LONG coalesced=InterlockedExchange(&s_irq_profile_coalesced,0);
+    fprintf(stderr,"[IRQ-PROFILE] calls=%u samples=%u missing=%u discarded=%u coalesced=%ld uncallable=%u declined=%u max-age=%.3fms prelock=%.3fms ggl=%.3fms vblank=%.3fms isr=%.3fms raised=%s max-isr=%.3fms max-dpc=%.3fms\n",
+        s->calls,s->samples,s->missing,s->discarded,(long)coalesced,s->uncallable,s->declined,
+        s->age/1000.0,s->prelock/1000.0,s->ggl/1000.0,s->vblank/1000.0,s->isr/1000.0,
+        names[phase],s->max_isr/1000.0,s->max_dpc/1000.0);
+    memset(s,0,sizeof *s);s->started=1;s->since=now;
+}
