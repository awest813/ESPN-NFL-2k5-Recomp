diff --git a/tests/wasm_layout/test_wasm_layout.c b/tests/wasm_layout/test_wasm_layout.c
new file mode 100644
index 0000000..f0e4b59
--- /dev/null
+++ b/tests/wasm_layout/test_wasm_layout.c
@@ -0,0 +1,97 @@
+/* The real xbox_MemoryLayoutInit on WebAssembly, fed a minimal XBE: every
+ * guest region lands at guest VA + the memory offset, generated-code
+ * addressing (XBOX_PTR) folds RAM mirrors, checked copies accept guest
+ * regions and refuse host memory, and the host heap stays out of the guest
+ * windows afterwards. Run under Node (see CMakeLists.txt). */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "xbox_memory_layout.h"
+#include "platform/guest_memory.h"
+#include "platform/wasm_fixed.h"
+#include "../../templates/runtime/recomp_types.h"
+
+static int failures;
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #c); failures++; } } while (0)
+
+static void put32(uint8_t *p, uint32_t v) { memcpy(p, &v, 4); }
+
+int main(void)
+{
+    /* XBE: header at 0x10000 (size 0x1000), one section at VA 0x11000. */
+    static uint8_t xbe[0x2000];
+    memcpy(xbe, "XBEH", 4);
+    put32(xbe + 0x104, 0x10000);      /* base address */
+    put32(xbe + 0x108, 0x1000);       /* size of headers */
+    put32(xbe + 0x10C, 0x2000);       /* size of image */
+    put32(xbe + 0x11C, 1);            /* section count */
+    put32(xbe + 0x120, 0x10200);      /* section headers VA */
+    uint8_t *sh = xbe + 0x200;
+    put32(sh + 0x04, 0x11000);        /* VA */
+    put32(sh + 0x08, 0x1000);         /* virtual size */
+    put32(sh + 0x0C, 0x1000);         /* raw offset */
+    put32(sh + 0x10, 0x100);          /* raw size */
+    memset(xbe + 0x1000, 0x7E, 0x100);
+
+    setenv("RECOMP_AC97_READY", "1", 1);   /* the APU/AC97 path, as NFL 2K5 runs */
+    CHECK(xbox_MemoryLayoutInit(xbe, sizeof xbe));
+
+    uintptr_t off = (uintptr_t)xbox_GetMemoryOffset();
+    printf("memory offset 0x%lX\n", (unsigned long)off);
+    const struct { const char *name; uint32_t va, size; } regions[] = {
+        { "RAM",        0x00010000u, 64u << 20 },
+        { "contiguous", 0x80000000u, 64u << 20 },
+        { "tiled",      0xF0000000u, 64u << 20 },
+        { "NV2A",       0xFD000000u, 16u << 20 },
+        { "MCPX",       0xFE800000u,  8u << 20 },
+        { "flash",      0xFF000000u,  1u << 20 },
+    };
+    for (unsigned i = 0; i < sizeof regions / sizeof regions[0]; i++) {
+        int ok = wasm_fixed_claimed((void *)(off + regions[i].va), regions[i].size - (regions[i].va == 0x10000u ? 0x10000u : 0));
+        printf("  %-10s 0x%08X claimed: %s\n", regions[i].name, regions[i].va, ok ? "yes" : "NO");
+        CHECK(ok);
+    }
+
+    /* The section landed at its VA. */
+    CHECK(MEM8(0x11000) == 0x7E && MEM8(0x110FF) == 0x7E && MEM8(0x11100) == 0);
+
+    /* Generated-code addressing: mirrors fold onto RAM, high regions do not. */
+    MEM32(0x00100000) = 0xA1B2C3D4u;
+    CHECK(MEM32(0x08100000) == 0xA1B2C3D4u);      /* 128 MB mirror */
+    CHECK(MEM32(0x40100000) == 0xA1B2C3D4u);
+    MEM32(0x80001000) = 0x11223344u;
+    CHECK(*(volatile uint32_t *)(off + 0x80001000u) == 0x11223344u);
+    CHECK(MEM32(0x00001000) != 0x11223344u);      /* contiguous is its own storage */
+    MEM32(0xFD001804) = 0x55u;
+    CHECK(*(volatile uint32_t *)(off + 0xFD001804u) == 0x55u);
+
+    /* Checked copies: guest regions yes, host memory no. */
+    uint32_t v = 0;
+    CHECK(xbox_guest_memory_read(off, 0x80001000u, &v, 4) && v == 0x11223344u);
+    CHECK(xbox_guest_memory_read(off, 0xFD001804u, &v, 4) && v == 0x55u);
+    CHECK(!xbox_guest_memory_read(off, 0x20000000u, &v, 4));   /* host heap */
+    CHECK(!xbox_guest_memory_write(off, 0x30000000u, &v, 4));
+    CHECK(xbox_guest_memory_direct(off, 0x80001000u, 4, true));
+    CHECK(!xbox_guest_memory_direct(off, 0x20000000u, 4, false));
+
+    /* The host keeps allocating below the ceiling and never into a window. */
+    MEM32(0x83FFFFF0) = 0xDEADBEEFu;
+    size_t total = 0;
+    void *keep[256]; int n = 0;
+    while (n < 256) {
+        void *p = malloc(8u << 20);
+        if (!p) break;
+        CHECK((uintptr_t)p + (8u << 20) <= WASM_FIXED_CEILING);
+        memset(p, 0xEE, 8u << 20);
+        keep[n++] = p; total += 8u << 20;
+    }
+    printf("host heap after init: %zu MB allocatable\n", total >> 20);
+    CHECK(total >= (1024u << 20));
+    CHECK(MEM32(0x83FFFFF0) == 0xDEADBEEFu && MEM32(0x00100000) == 0xA1B2C3D4u);
+    while (n) free(keep[--n]);
+
+    if (failures) { printf("%d failure(s)\n", failures); return 1; }
+    printf("wasm layout: all checks passed\n");
+    return 0;
+}
diff --git a/tools/gen-wgsl.py b/tools/gen-wgsl.py
new file mode 100644
index 0000000..c08c002
--- /dev/null
+++ b/tools/gen-wgsl.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+"""GLSL renderer shaders -> WGSL for the WebGPU build of the SDL GPU renderer.
+
+    gen-wgsl.py <shaders dir> <out header>
+
+The SDL GPU renderer's shaders (src/kernel/sdlgpu/shaders/*.vert/.frag) are
+Vulkan GLSL compiled to SPIR-V for native builds. The web build runs the same
+renderer on WebGPU (src/kernel/sdlgpu/webgpu/), which takes WGSL, so this
+translates them with naga (`cargo install naga-cli --version 27.0.0 --locked`) and embeds the result as
+C strings (k_sg_<name>_<stage>_wgsl). The output is committed, so building
+needs no naga; rerun this after changing a shader.
+
+Three adjustments, all mechanical:
+  - naga's GLSL front end has no combined `sampler2D`. Each one becomes the
+    Vulkan GLSL pair `texture2D <name>_t` (binding N) + `sampler <name>_s`
+    (binding N + 8), recombined as sampler2D(<name>_t, <name>_s) at every
+    use. The WebGPU shim binds an SDL sampler slot N that way.
+  - Fragment shaders sample inside per-stage branches, which WGSL's
+    derivative-uniformity analysis rejects although the stage is uniform per
+    draw; `diagnostic(off, derivative_uniformity)` turns that check off.
+  - naga refuses `return` inside a switch case (it calls it a
+    fall-through), so a switch whose every case is a single return -- the
+    alpha-test compares -- becomes the equivalent if chain.
+Sets and bindings carry over as WGSL groups and bindings (SDL's layout: set 1
+vertex uniforms, set 2 fragment samplers, set 3 fragment uniforms).
+"""
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+SAMPLER_OFFSET = 8
+SHADERS = ['flat2d.vert', 'flat2d.frag', 'xf.vert', 'xf.frag']
+
+
+def split_samplers(src):
+    names = []
+
+    def decl(m):
+        kind, name = m.group(3), m.group(4)
+        names.append((kind, name))
+        s, b = int(m.group(1)), int(m.group(2))
+        return (f'layout(set = {s}, binding = {b}) uniform texture{kind} {name}_t;\n'
+                f'layout(set = {s}, binding = {b + SAMPLER_OFFSET}) uniform sampler {name}_s;')
+    src = re.sub(r'layout\(set\s*=\s*(\d+),\s*binding\s*=\s*(\d+)\)\s*uniform\s+sampler(2D|Cube)\s+(\w+)\s*;', decl, src)
+    for kind, n in names:
+        src = re.sub(r'\b(texelFetch|texture|textureLod|textureSize)\(\s*' + n + r'\s*,',
+                     lambda m: f'{m.group(1)}(sampler{kind}({n}_t, {n}_s),', src)
+        src = re.sub(r'\btextureSize\(\s*' + n + r'\s*\)', f'textureSize(sampler{kind}({n}_t, {n}_s))', src)
+    return src
+
+
+def returning_switches(src):
+    """naga's GLSL front end refuses `return` inside a switch case (it
+    reports a fall-through). A switch whose every case is one `return` --
+    the alpha-test compares -- becomes the equivalent if chain; switches that
+    break are left alone."""
+    case_re = re.compile(r'^\s*case\s+([^:]+?)\s*:\s*return\s+([^;]+);\s*(//.*)?$')
+    default_re = re.compile(r'^\s*default\s*:\s*return\s+([^;]+);\s*(//.*)?$')
+
+    def rewrite(m):
+        indent, subject, body = m.group(1), m.group(2).strip(), m.group(3)
+        lines = [l for l in body.split('\n') if l.strip()]
+        out, default = [], None
+        for l in lines:
+            c, d = case_re.match(l), default_re.match(l)
+            if c:
+                out.append(f'{indent}if (({subject}) == {c.group(1)}) return {c.group(2)};')
+            elif d and default is None:
+                default = d.group(1)
+            else:
+                return m.group(0)          # not the all-return shape
+        if default is None:
+            return m.group(0)
+        out.append(f'{indent}return {default};')
+        return '\n'.join(out)
+    return re.sub(r'^([ \t]*)switch\s*\(([^)]*)\)\s*\{\n((?:[^{}]*\n)*?)\1\}', rewrite, src, flags=re.M)
+
+
+def translate(path):
+    stage = 'vert' if path.endswith('.vert') else 'frag'
+    with open(path) as f:
+        src = returning_switches(split_samplers(f.read()))
+    with tempfile.TemporaryDirectory() as tmp:
+        gl = os.path.join(tmp, 'in.' + stage)
+        out = os.path.join(tmp, 'out.wgsl')
+        with open(gl, 'w') as f:
+            f.write(src)
+        r = subprocess.run(['naga', '--shader-stage', stage, '--input-kind', 'glsl', gl, out],
+                           capture_output=True, text=True)
+        if r.returncode != 0:
+            sys.exit(f'naga failed on {path}:\n{r.stdout}{r.stderr}')
+        with open(out) as f:
+            wgsl = f.read()
+    if stage == 'frag':
+        wgsl = 'diagnostic(off, derivative_uniformity);\n\n' + wgsl
+    return wgsl
+
+
+def c_string(text):
+    lines = []
+    for line in text.splitlines():
+        lines.append('    "' + line.replace('\\', '\\\\').replace('"', '\\"') + '\\n"')
+    return '\n'.join(lines)
+
+
+def main():
+    if len(sys.argv) != 3:
+        sys.exit(__doc__)
+    shaders, out = sys.argv[1], sys.argv[2]
+    parts = ['/* Generated by tools/gen-wgsl.py from src/kernel/sdlgpu/shaders: do not edit. */',
+             '#pragma once', '']
+    for name in SHADERS:
+        wgsl = translate(os.path.join(shaders, name))
+        ident = 'k_sg_' + name.replace('.', '_') + '_wgsl'
+        parts.append(f'static const char {ident}[] =\n{c_string(wgsl)};\n')
+    with open(os.path.join(shaders, 'vp.wgsl'), encoding='utf-8') as f:
+        prelude, epilogue = f.read().split('// INSERT_PROGRAM\n')
+    for half, src in [('prelude', prelude), ('epilogue', epilogue)]:
+        parts.append(f'static const char k_sg_vp_{half}_wgsl[] =\n{c_string(src)};\n')
+    with open(out, 'w') as f:
+        f.write('\n'.join(parts))
+    print('wrote', out)
+
+
+if __name__ == '__main__':
+    main()
