+/* ── Command buffers ──────────────────────────────────────────────────── */
+SDL_GPUCommandBuffer *WG_AcquireGPUCommandBuffer(SDL_GPUDevice *d)
+{
+    (void)d;
+    return (SDL_GPUCommandBuffer *)calloc(1, sizeof(SDL_GPUCommandBuffer));
+}
+
+static void cmd_fail(SDL_GPUCommandBuffer *c, const char *message)
+{
+    if (c) c->failed = 1;
+    SDL_SetError("WebGPU command recording: %s", message);
+}
+
+static Op *push(SDL_GPUCommandBuffer *c, OpKind k)
+{
+    if (!c || c->failed) return NULL;
+    if (c->n == c->cap) {
+        if (c->cap > UINT32_MAX / 2) { cmd_fail(c, "too many commands"); return NULL; }
+        uint32_t cap = c->cap ? c->cap * 2 : 64;
+        if ((size_t)cap > SIZE_MAX / sizeof(Op)) { cmd_fail(c, "command storage overflow"); return NULL; }
+        Op *o = (Op *)realloc(c->ops, cap * sizeof *o);
+        if (!o) { cmd_fail(c, "out of memory"); return NULL; }
+        c->ops = o;
+        c->cap = cap;
+    }
+    Op *o = &c->ops[c->n++];
+    memset(o, 0, sizeof *o);
+    o->kind = k;
+    return o;
+}
+
+static void cmd_free(SDL_GPUCommandBuffer *c) { free(c->ops); free(c->uniforms); free(c); }
+
+bool WG_CancelGPUCommandBuffer(SDL_GPUCommandBuffer *c) { if (c) cmd_free(c); return true; }
+
+/* Passes are views of their command buffer. */
+SDL_GPUCopyPass *WG_BeginGPUCopyPass(SDL_GPUCommandBuffer *c) { return (SDL_GPUCopyPass *)c; }
+void WG_EndGPUCopyPass(SDL_GPUCopyPass *p) { (void)p; }
+#define CMD(pass) ((SDL_GPUCommandBuffer *)(pass))
+
+void WG_UploadToGPUBuffer(SDL_GPUCopyPass *p, const SDL_GPUTransferBufferLocation *s, const SDL_GPUBufferRegion *d, bool cycle)
+{
+    (void)cycle;
+    if (!s || !d || !s->transfer_buffer || !d->buffer ||
+        (uint64_t)s->offset + d->size > s->transfer_buffer->size ||
+        (uint64_t)d->offset + d->size > d->buffer->size ||
+        ((s->offset | d->offset | d->size) & 3u)) {
+        cmd_fail(CMD(p), "invalid buffer upload range or alignment"); return;
+    }
+    Op *o = push(CMD(p), OP_UPLOAD_BUFFER);
+    if (o) o->ub = (typeof(o->ub)){ s->transfer_buffer, s->offset, d->buffer, d->offset, d->size };
+}
+static int texture_region_valid(SDL_GPUTexture *t, uint32_t level, uint32_t x, uint32_t y,
+                                uint32_t w, uint32_t h, uint32_t layer, uint32_t depth)
+{
+    if (!t || t->swapchain || level >= t->levels || level >= 32 || layer >= t->layers ||
+        depth != 1 || !w || !h || is_depth(t->format)) return 0;
+    uint32_t tw = t->w >> level, th = t->h >> level;
+    if (!tw) tw = 1;
+    if (!th) th = 1;
+    return (uint64_t)x + w <= tw && (uint64_t)y + h <= th;
+}
+
+static int transfer_region_valid(SDL_GPUTransferBuffer *buffer, uint32_t offset,
+                                 uint32_t row_px, uint32_t w, uint32_t h)
+{
+    if (!buffer || !w || !h || row_px < w || offset > buffer->size) return 0;
+    uint64_t available = buffer->size - offset, row_bytes = (uint64_t)w * 4;
+    if (row_bytes > available) return 0;
+    return h == 1 || (uint64_t)(h - 1) <= (available - row_bytes) / ((uint64_t)row_px * 4);
+}
+
+void WG_UploadToGPUTexture(SDL_GPUCopyPass *p, const SDL_GPUTextureTransferInfo *s, const SDL_GPUTextureRegion *d, bool cycle)
+{
+    (void)cycle;
+    if (!s || !d || !texture_region_valid(d->texture, d->mip_level, d->x, d->y, d->w, d->h, d->layer, d->d) ||
+        !transfer_region_valid(s->transfer_buffer, s->offset, s->pixels_per_row ? s->pixels_per_row : d->w, d->w, d->h)) {
+        cmd_fail(CMD(p), "invalid texture upload region or transfer range"); return;
+    }
+    Op *o = push(CMD(p), OP_UPLOAD_TEXTURE);
+    if (o) o->ut = (typeof(o->ut)){ s->transfer_buffer, s->offset, s->pixels_per_row ? s->pixels_per_row : d->w,
+                                   s->rows_per_layer ? s->rows_per_layer : d->h, d->texture, d->mip_level,
+                                   d->x, d->y, d->w, d->h, d->layer };
+}
+void WG_DownloadFromGPUTexture(SDL_GPUCopyPass *p, const SDL_GPUTextureRegion *s, const SDL_GPUTextureTransferInfo *d)
+{
+    if (!s || !d || !texture_region_valid(s->texture, s->mip_level, s->x, s->y, s->w, s->h, s->layer, s->d) ||
+        !transfer_region_valid(d->transfer_buffer, d->offset, d->pixels_per_row ? d->pixels_per_row : s->w, s->w, s->h)) {
+        cmd_fail(CMD(p), "invalid texture download region or transfer range"); return;
+    }
+    Op *o = push(CMD(p), OP_DOWNLOAD_TEXTURE);
+    if (o) {
+        o->dt = (typeof(o->dt)){ s->texture, s->mip_level, s->x, s->y, s->w, s->h, s->layer, d->transfer_buffer, d->offset,
+                                   d->pixels_per_row ? d->pixels_per_row : s->w };
+        CMD(p)->has_download = 1;
+    }
+}
+void WG_CopyGPUTextureToTexture(SDL_GPUCopyPass *p, const SDL_GPUTextureLocation *s, const SDL_GPUTextureLocation *d,
+                                Uint32 w, Uint32 h, Uint32 depth, bool cycle)
+{
+    (void)cycle;
+    if (!s || !d || !texture_region_valid(s->texture, s->mip_level, s->x, s->y, w, h, s->layer, depth) ||
+        !texture_region_valid(d->texture, d->mip_level, d->x, d->y, w, h, d->layer, depth) ||
+        s->texture->format != d->texture->format) {
+        cmd_fail(CMD(p), "invalid texture copy region or format"); return;
+    }
+    Op *o = push(CMD(p), OP_COPY_TEXTURE);
+    if (o) o->ct = (typeof(o->ct)){ s->texture, d->texture, s->mip_level, s->x, s->y, d->mip_level, d->x, d->y, w, h, s->layer, d->layer };
+}
+void WG_GenerateMipmapsForGPUTexture(SDL_GPUCommandBuffer *c, SDL_GPUTexture *t)
+{
+    Op *o = push(c, OP_MIPMAPS);
+    if (o) o->mip.tex = t;
+}
+void WG_BlitGPUTexture(SDL_GPUCommandBuffer *c, const SDL_GPUBlitInfo *i)
+{
+    Op *o = push(c, OP_BLIT);
+    if (o) o->blit = (typeof(o->blit)){ i->source, i->destination, i->filter == SDL_GPU_FILTER_LINEAR,
+                                       i->load_op == SDL_GPU_LOADOP_CLEAR, i->clear_color };
+}
+
+SDL_GPURenderPass *WG_BeginGPURenderPass(SDL_GPUCommandBuffer *c, const SDL_GPUColorTargetInfo *ct, Uint32 n,
+                                         const SDL_GPUDepthStencilTargetInfo *ds)
+{
+    Op *o = push(c, OP_BEGIN_PASS);
+    if (o) {
+        if (n) { o->pass.color = ct[0]; o->pass.has_color = 1; }
+        if (ds) { o->pass.depth = *ds; o->pass.has_depth = 1; }
+    }
+    return (SDL_GPURenderPass *)c;
+}
+void WG_EndGPURenderPass(SDL_GPURenderPass *p) { push(CMD(p), OP_END_PASS); }
+void WG_SetGPUViewport(SDL_GPURenderPass *p, const SDL_GPUViewport *v) { Op *o = push(CMD(p), OP_VIEWPORT); if (o) o->viewport = *v; }
+void WG_SetGPUScissor(SDL_GPURenderPass *p, const SDL_Rect *r) { Op *o = push(CMD(p), OP_SCISSOR); if (o) o->scissor = *r; }
+void WG_SetGPUBlendConstants(SDL_GPURenderPass *p, SDL_FColor c) { Op *o = push(CMD(p), OP_BLEND_CONSTANT); if (o) o->blend = c; }
+void WG_SetGPUStencilReference(SDL_GPURenderPass *p, Uint8 r) { Op *o = push(CMD(p), OP_STENCIL_REF); if (o) o->stencil_ref = r; }
+void WG_BindGPUGraphicsPipeline(SDL_GPURenderPass *p, SDL_GPUGraphicsPipeline *g) { Op *o = push(CMD(p), OP_PIPELINE); if (o) o->pipeline = g; }
+void WG_BindGPUVertexBuffers(SDL_GPURenderPass *p, Uint32 first, const SDL_GPUBufferBinding *b, Uint32 n)
+{
+    (void)first;
+    if (n) { Op *o = push(CMD(p), OP_VERTEX_BUFFER); if (o) o->vb = (typeof(o->vb)){ b[0].buffer, b[0].offset }; }
+}
+void WG_BindGPUIndexBuffer(SDL_GPURenderPass *p, const SDL_GPUBufferBinding *b, SDL_GPUIndexElementSize s)
+{
+    (void)s;   /* the renderer only uses 32-bit indices */
+    Op *o = push(CMD(p), OP_INDEX_BUFFER);
+    if (o) o->vb = (typeof(o->vb)){ b->buffer, b->offset };
+}
+void WG_BindGPUFragmentSamplers(SDL_GPURenderPass *p, Uint32 first, const SDL_GPUTextureSamplerBinding *b, Uint32 n)
+{
+    Op *o = push(CMD(p), OP_SAMPLERS);
+    if (!o) return;
+    o->samplers.first = first;
+    o->samplers.n = n > WG_MAX_SAMPLERS ? WG_MAX_SAMPLERS : n;
+    for (uint32_t i = 0; i < o->samplers.n; i++) { o->samplers.tex[i] = b[i].texture; o->samplers.smp[i] = b[i].sampler; }
+}
+static void push_uniform(SDL_GPUCommandBuffer *c, int fragment, const void *data, Uint32 len)
+{
+    if (!c || c->failed || !len) return;
+    uint32_t limit = fragment ? WG_FS_UNIFORM_BYTES : WG_VS_UNIFORM_BYTES;
+    if (!data || len > limit || c->ubytes > UINT32_MAX - WG_UNIFORM_ALIGN - len - 4) {
+        cmd_fail(c, "invalid uniform data or size"); return;
+    }
+    if (c->last_uniform[fragment].valid && c->last_uniform[fragment].size == len
+        && memcmp(c->uniforms + c->last_uniform[fragment].offset, data, len) == 0) {
+        Op *o = push(c, OP_UNIFORM);
+        if (o) o->uniform = (typeof(o->uniform)){ fragment, c->last_uniform[fragment].offset };
+        return;
+    }
+    uint32_t off = (c->ubytes + WG_UNIFORM_ALIGN - 1) & ~(WG_UNIFORM_ALIGN - 1);
+    uint32_t cap_needed = off + len + 4;   /* + the 4-byte rounding of the final write */
+    if (cap_needed > c->ucap) {
+        uint32_t cap = c->ucap ? c->ucap : 4096;
+        while (cap < cap_needed) {
+            if (cap > UINT32_MAX / 2) { cap = cap_needed; break; }
+            cap *= 2;
+        }
+        uint8_t *u = (uint8_t *)realloc(c->uniforms, cap);
+        if (!u) { cmd_fail(c, "out of memory"); return; }
+        c->uniforms = u;
+        c->ucap = cap;
+    }
+    memset(c->uniforms + c->ubytes, 0, off - c->ubytes);
+    memcpy(c->uniforms + off, data, len);
+    c->ubytes = off + len;
+    c->last_uniform[fragment].offset = off;
+    c->last_uniform[fragment].size = len;
+    c->last_uniform[fragment].valid = 1;
+    Op *o = push(c, OP_UNIFORM);
+    if (o) o->uniform = (typeof(o->uniform)){ fragment, off };
+}
+void WG_PushGPUVertexUniformData(SDL_GPUCommandBuffer *c, Uint32 slot, const void *d, Uint32 len) { (void)slot; push_uniform(c, 0, d, len); }
+void WG_PushGPUFragmentUniformData(SDL_GPUCommandBuffer *c, Uint32 slot, const void *d, Uint32 len) { (void)slot; push_uniform(c, 1, d, len); }
+void WG_DrawGPUPrimitives(SDL_GPURenderPass *p, Uint32 n, Uint32 inst, Uint32 first_v, Uint32 first_i)
+{
+    Op *o = push(CMD(p), OP_DRAW);
+    if (o) o->draw = (typeof(o->draw)){ n, inst, first_v, first_i, 0 };
+}
+void WG_DrawGPUIndexedPrimitives(SDL_GPURenderPass *p, Uint32 n, Uint32 inst, Uint32 first_idx, Sint32 voff, Uint32 first_i)
+{
+    Op *o = push(CMD(p), OP_DRAW_INDEXED);
+    if (o) o->draw = (typeof(o->draw)){ n, inst, first_idx, first_i, voff };
+}
+
+/* ── Replay (server thread) ───────────────────────────────────────────── */
+typedef struct {
+    WGPUBuffer buf;
+    uint8_t *dst;              /* transfer buffer memory */
+    uint32_t row_bytes, padded, rows, dst_stride;
+} Readback;
+
+typedef struct {
+    SDL_GPUCommandBuffer *c;
+    WGPUCommandEncoder enc;
+    int encoded;               /* GPU commands in `enc` not yet submitted */
+    WGPUTexture swap_tex;      /* the canvas's current texture, once resolved */
+    WGPUTextureView swap_view;
+    Readback *rb; uint32_t nrb, caprb;
+    WGPUBuffer ubuf;           /* this submission's uniforms */
+    WGPUBindGroup vs_group, fs_group, empty_group;
+    em_proxying_ctx *ctx;
+    atomic_int pending;
+    atomic_int failed;
+    SDL_GPUFence *fence;
+} Replay;
+
+static WGPUTextureView view_of(Replay *r, SDL_GPUTexture *t, uint32_t level, int sampling)
+{
+    if (t->swapchain) {
+        if (!r->swap_tex) {
+            WGPUSurfaceTexture st = {0};
+            wgpuSurfaceGetCurrentTexture(s_surface, &st);
+            r->swap_tex = st.texture;
+            r->swap_view = st.texture ? wgpuTextureCreateView(st.texture, NULL) : NULL;
+        }
+        return r->swap_view;
+    }
+    return sampling ? t->view : t->level_views[level < t->levels ? level : 0];
+}
+
+static void flush_encoder(Replay *r)
+{
+    if (!r->encoded) return;
+    WGPUCommandBuffer cb = wgpuCommandEncoderFinish(r->enc, NULL);
+    wgpuQueueSubmit(s_queue, 1, &cb);
+    wgpuCommandBufferRelease(cb);
+    wgpuCommandEncoderRelease(r->enc);
+    r->enc = wgpuDeviceCreateCommandEncoder(s_dev, NULL);
+    r->encoded = 0;
+}
+
+static void fullscreen_pass(Replay *r, WGPUTextureView src, WGPUSampler smp, WGPUTextureView dst,
+                            WGPUTextureFormat fmt, int clear, SDL_FColor cc, const float *viewport, const float *source)
+{
+    WGPURenderPassColorAttachment ca = { .view = dst, .depthSlice = WGPU_DEPTH_SLICE_UNDEFINED,
+        .loadOp = clear ? WGPULoadOp_Clear : WGPULoadOp_Load, .storeOp = WGPUStoreOp_Store,
+        .clearValue = { cc.r, cc.g, cc.b, cc.a } };
+    WGPURenderPassDescriptor rp = { .colorAttachmentCount = 1, .colorAttachments = &ca };
+    WGPURenderPipeline pipe = blit_pipeline(fmt);
+    const float whole[4] = {0, 0, 1, 1};
+    WGPUBufferDescriptor uv_desc = { .usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst, .size = sizeof whole };
+    static WGPUBuffer whole_uv;
+    if (!whole_uv) {
+        whole_uv = wgpuDeviceCreateBuffer(s_dev, &uv_desc);
+        wgpuQueueWriteBuffer(s_queue, whole_uv, 0, whole, sizeof whole);
+    }
+    WGPUBuffer uv = whole_uv;
+    if (source) {
+        uv = wgpuDeviceCreateBuffer(s_dev, &uv_desc);
+        wgpuQueueWriteBuffer(s_queue, uv, 0, source, sizeof whole);
+    }
+    WGPUBindGroupEntry be[3] = { { .binding = 0, .textureView = src }, { .binding = 1, .sampler = smp },
+                                { .binding = 2, .buffer = uv, .size = sizeof whole } };
+    WGPUBindGroupDescriptor bd = { .layout = wgpuRenderPipelineGetBindGroupLayout(pipe, 0), .entryCount = 3, .entries = be };
+    WGPUBindGroup bg = wgpuDeviceCreateBindGroup(s_dev, &bd);
+    WGPURenderPassEncoder pe = wgpuCommandEncoderBeginRenderPass(r->enc, &rp);
+    wgpuRenderPassEncoderSetPipeline(pe, pipe);
+    wgpuRenderPassEncoderSetBindGroup(pe, 0, bg, 0, NULL);
+    if (viewport && viewport[2] > 0 && viewport[3] > 0)
+        wgpuRenderPassEncoderSetViewport(pe, viewport[0], viewport[1], viewport[2], viewport[3], 0, 1);
+    wgpuRenderPassEncoderDraw(pe, 3, 1, 0, 0);
+    wgpuRenderPassEncoderEnd(pe);
+    wgpuRenderPassEncoderRelease(pe);
+    wgpuBindGroupRelease(bg);
+    wgpuBindGroupLayoutRelease(bd.layout);
+    if (source)
+        wgpuBufferRelease(uv);
+    r->encoded = 1;
+}
+
+static void replay_pass(Replay *r, uint32_t *ip)
+{
+    SDL_GPUCommandBuffer *c = r->c;
+    const Op *begin = &c->ops[*ip];
+    WGPURenderPassColorAttachment ca = {0};
+    WGPURenderPassDepthStencilAttachment da = {0};
+    WGPURenderPassDescriptor rp = {0};
+    uint32_t tw = 0, th = 0;
+
+    if (begin->pass.has_color) {
+        const SDL_GPUColorTargetInfo *t = &begin->pass.color;
+        ca = (WGPURenderPassColorAttachment){ .view = view_of(r, t->texture, t->mip_level, 0),
+            .depthSlice = WGPU_DEPTH_SLICE_UNDEFINED, .loadOp = load_op(t->load_op), .storeOp = store_op(t->store_op),
+            .clearValue = { t->clear_color.r, t->clear_color.g, t->clear_color.b, t->clear_color.a } };
+        rp.colorAttachmentCount = 1;
+        rp.colorAttachments = &ca;
+        tw = t->texture->swapchain ? s_surface_w : t->texture->w;
+        th = t->texture->swapchain ? s_surface_h : t->texture->h;
+    }
+    if (begin->pass.has_depth) {
+        const SDL_GPUDepthStencilTargetInfo *t = &begin->pass.depth;
+        da = (WGPURenderPassDepthStencilAttachment){ .view = t->texture->level_views[0],
+            .depthLoadOp = load_op(t->load_op), .depthStoreOp = store_op(t->store_op), .depthClearValue = t->clear_depth };
+        if (has_stencil(t->texture->format)) {
+            da.stencilLoadOp = load_op(t->stencil_load_op);
+            da.stencilStoreOp = store_op(t->stencil_store_op);
+            da.stencilClearValue = t->clear_stencil;
+        }
+        rp.depthStencilAttachment = &da;
+        if (!tw) { tw = t->texture->w; th = t->texture->h; }
+    }
+
+    WGPURenderPassEncoder pe = wgpuCommandEncoderBeginRenderPass(r->enc, &rp);
+    r->encoded = 1;
+    SDL_GPUTexture *tex[WG_MAX_SAMPLERS] = {0};
+    SDL_GPUSampler *smp[WG_MAX_SAMPLERS] = {0};
+    uint32_t vs_off = 0, fs_off = 0;
+    int samplers_dirty = 1;
+    int vs_dirty = 1, fs_dirty = 1;
+    wgpuRenderPassEncoderSetBindGroup(pe, 0, r->empty_group, 0, NULL);
+
+    for ((*ip)++; *ip < c->n && c->ops[*ip].kind != OP_END_PASS; (*ip)++) {
+        const Op *o = &c->ops[*ip];
+        switch (o->kind) {
+        case OP_VIEWPORT:
+            wgpuRenderPassEncoderSetViewport(pe, o->viewport.x, o->viewport.y, o->viewport.w, o->viewport.h,
+                                             o->viewport.min_depth, o->viewport.max_depth);
+            break;
+        case OP_SCISSOR: {
+            /* WebGPU rejects rectangles outside the target: clamp. */
+            int x0 = o->scissor.x < 0 ? 0 : o->scissor.x, y0 = o->scissor.y < 0 ? 0 : o->scissor.y;
+            int x1 = o->scissor.x + o->scissor.w, y1 = o->scissor.y + o->scissor.h;
+            if (x1 > (int)tw) x1 = (int)tw;
+            if (y1 > (int)th) y1 = (int)th;
+            if (x0 > x1) x0 = x1;
+            if (y0 > y1) y0 = y1;
+            wgpuRenderPassEncoderSetScissorRect(pe, (uint32_t)x0, (uint32_t)y0, (uint32_t)(x1 - x0), (uint32_t)(y1 - y0));
+            break;
+        }
+        case OP_BLEND_CONSTANT: {
+            WGPUColor col = { o->blend.r, o->blend.g, o->blend.b, o->blend.a };
+            wgpuRenderPassEncoderSetBlendConstant(pe, &col);
+            break;
+        }
+        case OP_STENCIL_REF: wgpuRenderPassEncoderSetStencilReference(pe, o->stencil_ref); break;
+        case OP_PIPELINE: wgpuRenderPassEncoderSetPipeline(pe, o->pipeline->pipe); break;
+        case OP_VERTEX_BUFFER: wgpuRenderPassEncoderSetVertexBuffer(pe, 0, o->vb.buf->buf, o->vb.off, WGPU_WHOLE_SIZE); break;
+        case OP_INDEX_BUFFER:
+            wgpuRenderPassEncoderSetIndexBuffer(pe, o->vb.buf->buf, WGPUIndexFormat_Uint32, o->vb.off, WGPU_WHOLE_SIZE);
+            break;
+        case OP_SAMPLERS:
+            for (uint32_t i = 0; i < o->samplers.n && o->samplers.first + i < WG_MAX_SAMPLERS; i++) {
+                uint32_t slot = o->samplers.first + i;
+                if (tex[slot] != o->samplers.tex[i] || smp[slot] != o->samplers.smp[i]) {
+                    tex[slot] = o->samplers.tex[i];
+                    smp[slot] = o->samplers.smp[i];
+                    samplers_dirty = 1;
+                }
+            }
+            break;
+        case OP_UNIFORM:
+            if (o->uniform.fragment) {
+                fs_dirty |= fs_off != o->uniform.off;
+                fs_off = o->uniform.off;
+            } else {
+                vs_dirty |= vs_off != o->uniform.off;
+                vs_off = o->uniform.off;
+            }
+            break;
+        case OP_DRAW:
+        case OP_DRAW_INDEXED:
+            if (samplers_dirty) {
+                wgpuRenderPassEncoderSetBindGroup(pe, 2, material_group(tex, smp), 0, NULL);
+                samplers_dirty = 0;
+            }
+            if (vs_dirty) {
+                wgpuRenderPassEncoderSetBindGroup(pe, 1, r->vs_group, 1, &vs_off);
+                vs_dirty = 0;
+            }
+            if (fs_dirty) {
+                wgpuRenderPassEncoderSetBindGroup(pe, 3, r->fs_group, 1, &fs_off);
+                fs_dirty = 0;
+            }
+            if (o->kind == OP_DRAW)
+                wgpuRenderPassEncoderDraw(pe, o->draw.count, o->draw.instances, o->draw.first, o->draw.first_instance);
+            else
+                wgpuRenderPassEncoderDrawIndexed(pe, o->draw.count, o->draw.instances, o->draw.first,
+                                                 o->draw.vertex_offset, o->draw.first_instance);
+            break;
+        default:
+            break;
+        }
+    }
+    wgpuRenderPassEncoderEnd(pe);
+    wgpuRenderPassEncoderRelease(pe);
+}
+
+static void on_readback(WGPUMapAsyncStatus st, WGPUStringView msg, void *u1, void *u2)
+{
+    Replay *r = (Replay *)u1;
+    Readback *b = (Readback *)u2;
+    if (st == WGPUMapAsyncStatus_Success) {
+        const uint8_t *src = (const uint8_t *)wgpuBufferGetConstMappedRange(b->buf, 0, (size_t)b->padded * b->rows);
+        if (!src) { atomic_store(&r->failed, 1); report("download", sv("mapped range unavailable")); }
+        for (uint32_t y = 0; src && y < b->rows; y++)
+            memcpy(b->dst + (size_t)y * b->dst_stride, src + (size_t)y * b->padded, b->row_bytes);
+        wgpuBufferUnmap(b->buf);
+    } else {
+        atomic_store(&r->failed, 1);
+        report("download", msg);
+    }
+    wgpuBufferRelease(b->buf);
+    if (atomic_fetch_sub(&r->pending, 1) == 1)
+        emscripten_proxy_finish(r->ctx);
+}
+
+static void replay(Replay *r)
+{
+    SDL_GPUCommandBuffer *c = r->c;
+    r->enc = wgpuDeviceCreateCommandEncoder(s_dev, NULL);
+
+    /* Uniforms of the whole submission in one buffer; each draw binds its
+     * own offsets. Room past the end for a full binding at the last offset. */
+    {
+        uint32_t size = c->ubytes + WG_VS_UNIFORM_BYTES;
+        size = (size + 3u) & ~3u;
+        WGPUBufferDescriptor bd = { .usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst, .size = size };
+        r->ubuf = wgpuDeviceCreateBuffer(s_dev, &bd);
+        if (c->ubytes)
+            wgpuQueueWriteBuffer(s_queue, r->ubuf, 0, c->uniforms, (c->ubytes + 3u) & ~3u);
+        WGPUBindGroupEntry ve = { .binding = 0, .buffer = r->ubuf, .offset = 0, .size = WG_VS_UNIFORM_BYTES };
+        WGPUBindGroupEntry fe = { .binding = 0, .buffer = r->ubuf, .offset = 0, .size = WG_FS_UNIFORM_BYTES };
+        WGPUBindGroupDescriptor vd = { .layout = s_bgl[1], .entryCount = 1, .entries = &ve };
+        WGPUBindGroupDescriptor fd = { .layout = s_bgl[3], .entryCount = 1, .entries = &fe };
+        WGPUBindGroupDescriptor ed = { .layout = s_bgl[0], .entryCount = 0 };
+        r->vs_group = wgpuDeviceCreateBindGroup(s_dev, &vd);
+        r->fs_group = wgpuDeviceCreateBindGroup(s_dev, &fd);
+        r->empty_group = wgpuDeviceCreateBindGroup(s_dev, &ed);
+    }
+
+    for (uint32_t i = 0; i < c->n; i++) {
+        const Op *o = &c->ops[i];
+        switch (o->kind) {
+        case OP_UPLOAD_BUFFER:
+            /* Queue writes run ahead of the encoder: submit what is encoded
+             * first so the order SDL promises holds. */
+            flush_encoder(r);
+            wgpuQueueWriteBuffer(s_queue, o->ub.dst->buf, o->ub.dst_off, o->ub.src->mem + o->ub.src_off,
+                                 (o->ub.size + 3u) & ~3u);
+            break;
+        case OP_UPLOAD_TEXTURE: {
+            flush_encoder(r);
+            WGPUTexelCopyTextureInfo dst = { .texture = o->ut.dst->tex, .mipLevel = o->ut.level,
+                                             .origin = { o->ut.x, o->ut.y, o->ut.layer }, .aspect = WGPUTextureAspect_All };
+            WGPUTexelCopyBufferLayout layout = { .offset = 0, .bytesPerRow = o->ut.row_px * 4, .rowsPerImage = o->ut.rows };
+            WGPUExtent3D ext = { o->ut.w, o->ut.h, 1 };
+            wgpuQueueWriteTexture(s_queue, &dst, o->ut.src->mem + o->ut.src_off,
+                                  (size_t)(o->ut.h - 1) * o->ut.row_px * 4 + (size_t)o->ut.w * 4, &layout, &ext);
+            break;
+        }
+        case OP_DOWNLOAD_TEXTURE: {
+            if (r->nrb == r->caprb) {
+                uint32_t cap = r->caprb ? r->caprb * 2 : 4;
+                if (cap < r->caprb || (size_t)cap > SIZE_MAX / sizeof *r->rb) {
+                    atomic_store(&r->failed, 1); break;
+                }
+                Readback *buffers = (Readback *)realloc(r->rb, cap * sizeof *r->rb);
+                if (!buffers) { atomic_store(&r->failed, 1); break; }
+                r->rb = buffers; r->caprb = cap;
+            }
+            Readback *b = &r->rb[r->nrb];
+            b->row_bytes = o->dt.w * 4;
+            b->padded = (b->row_bytes + 255u) & ~255u;     /* copyTextureToBuffer's row alignment */
+            b->rows = o->dt.h;
+            b->dst = o->dt.dst->mem + o->dt.dst_off;
+            b->dst_stride = o->dt.row_px * 4;
+            WGPUBufferDescriptor bd = { .usage = WGPUBufferUsage_MapRead | WGPUBufferUsage_CopyDst,
+                                        .size = (uint64_t)b->padded * b->rows };
+            b->buf = wgpuDeviceCreateBuffer(s_dev, &bd);
+            if (!b->buf) { atomic_store(&r->failed, 1); break; }
+            r->nrb++;
+            WGPUTexelCopyTextureInfo src = { .texture = o->dt.src->tex, .mipLevel = o->dt.level,
+                                             .origin = { o->dt.x, o->dt.y, o->dt.layer }, .aspect = WGPUTextureAspect_All };
+            WGPUTexelCopyBufferInfo dst = { .layout = { .bytesPerRow = b->padded, .rowsPerImage = b->rows }, .buffer = b->buf };
+            WGPUExtent3D ext = { o->dt.w, o->dt.h, 1 };
+            wgpuCommandEncoderCopyTextureToBuffer(r->enc, &src, &dst, &ext);
+            r->encoded = 1;
+            break;
+        }
+        case OP_COPY_TEXTURE: {
+            WGPUTexelCopyTextureInfo src = { .texture = o->ct.src->tex, .mipLevel = o->ct.sl,
+                                             .origin = { o->ct.sx, o->ct.sy, o->ct.src_layer }, .aspect = WGPUTextureAspect_All };
+            WGPUTexelCopyTextureInfo dst = { .texture = o->ct.dst->tex, .mipLevel = o->ct.dl,
+                                             .origin = { o->ct.dx, o->ct.dy, o->ct.dst_layer }, .aspect = WGPUTextureAspect_All };
+            WGPUExtent3D ext = { o->ct.w, o->ct.h, 1 };
+            wgpuCommandEncoderCopyTextureToTexture(r->enc, &src, &dst, &ext);
+            r->encoded = 1;
+            break;
+        }
+        case OP_MIPMAPS: {
+            SDL_GPUTexture *t = o->mip.tex;
+            for (uint32_t face = 0; face < t->layers; face++)
+            for (uint32_t l = 1; l < t->levels; l++)
+                fullscreen_pass(r, t->level_views[face * t->levels + l - 1], s_linear_sampler,
+                                t->level_views[face * t->levels + l], t->format, 1,
+                                (SDL_FColor){0, 0, 0, 0}, NULL, NULL);
+            break;
+        }
+        case OP_BLIT: {
+            const SDL_GPUBlitRegion *src = &o->blit.src, *dst = &o->blit.dst;
+            SDL_GPUTexture *s = src->texture, *d = dst->texture;
+            if (!src->w || !src->h || !dst->w || !dst->h || src->mip_level >= s->levels)
+                break;
+            WGPUTextureView dv = view_of(r, d, dst->mip_level, 0);
+            WGPUTextureFormat df = d->swapchain ? s_surface_format : d->format;
+            uint32_t w = s->w >> src->mip_level, h = s->h >> src->mip_level;
+            float iw = 1.0f / (w ? w : 1), ih = 1.0f / (h ? h : 1);
+            float uv[4] = { src->x * iw, src->y * ih, src->w * iw, src->h * ih };
+            int cropped = src->x || src->y || src->w != w || src->h != h;
+            float vp[4] = { (float)dst->x, (float)dst->y, (float)dst->w, (float)dst->h };
+            if (dv && s->view)
+                fullscreen_pass(r, s->level_views[src->mip_level], o->blit.linear ? s_linear_sampler : s_nearest_sampler, dv, df,
+                                o->blit.clear, o->blit.clear_color, vp, cropped ? uv : NULL);
+            break;
+        }
+        case OP_BEGIN_PASS:
+            replay_pass(r, &i);
+            break;
+        default:
+            break;   /* render-pass state outside a pass: nothing to do */
+        }
+    }
+
+    WGPUCommandBuffer cb = wgpuCommandEncoderFinish(r->enc, NULL);
+    wgpuQueueSubmit(s_queue, 1, &cb);
+    wgpuCommandBufferRelease(cb);
+    wgpuCommandEncoderRelease(r->enc);
+    wgpuBindGroupRelease(r->vs_group);
+    wgpuBindGroupRelease(r->fs_group);
+    wgpuBindGroupRelease(r->empty_group);
+    wgpuBufferRelease(r->ubuf);
+    if (r->swap_view) wgpuTextureViewRelease(r->swap_view);
+    if (r->swap_tex) wgpuTextureRelease(r->swap_tex);
+}
+
+static void track_fence(void *p);
+static void do_submit(void *p)
+{
+    Replay *r = (Replay *)p;
+    replay(r);
+    if (r->fence) track_fence(r->fence);
+}
+
+static void do_submit_download(em_proxying_ctx *ctx, void *p)
+{
+    Replay *r = (Replay *)p;
+    r->ctx = ctx;
+    replay(r);
+    /* Register completion before starting asynchronous readbacks, so their
+     * waiter does not need a second proxy/promise round trip afterwards. */
+    if (r->fence) track_fence(r->fence);
+    atomic_store(&r->pending, (int)r->nrb);
+    if (!r->nrb) { emscripten_proxy_finish(ctx); return; }
+    for (uint32_t i = 0; i < r->nrb; i++) {
+        WGPUBufferMapCallbackInfo ci = { .mode = WGPUCallbackMode_AllowSpontaneous, .callback = on_readback,
+                                         .userdata1 = r, .userdata2 = &r->rb[i] };
+        wgpuBufferMapAsync(r->rb[i].buf, WGPUMapMode_Read, 0, (size_t)r->rb[i].padded * r->rb[i].rows, ci);
+    }
+}
+
+static bool submit(SDL_GPUCommandBuffer *c, SDL_GPUFence *fence)
+{
+    if (!c) { SDL_SetError("WebGPU submit: null command buffer"); return false; }
+    if (c->failed) { cmd_free(c); return false; }
+    Replay r = { .c = c, .fence = fence };
+    if (c->has_download) run_sync_ctx(do_submit_download, &r);   /* returns with the data in place */
+    else run_sync(do_submit, &r);
+    free(r.rb);
+    cmd_free(c);
+    if (atomic_load(&r.failed)) { SDL_SetError("WebGPU texture readback failed"); return false; }
+    return true;
+}
+
+bool WG_SubmitGPUCommandBuffer(SDL_GPUCommandBuffer *c) { return submit(c, NULL); }
+
+static void fence_drop(SDL_GPUFence *f)
+{
+    if (atomic_fetch_sub(&f->refs, 1) == 1) free(f);
+}
+
+static void on_fence(WGPUQueueWorkDoneStatus status, WGPUStringView message, void *u1, void *u2)
+{
+    SDL_GPUFence *f = (SDL_GPUFence *)u1;
+    (void)u2;
+    if (status != WGPUQueueWorkDoneStatus_Success) report("fence", message);
+    atomic_store(&f->state, status == WGPUQueueWorkDoneStatus_Success ? 1 : -1);
+    atomic_fetch_add(&s_fence_event, 1);
+    emscripten_futex_wake((void *)&s_fence_event, INT_MAX);
+    fence_drop(f);                 /* callback owns a reference until it fires */
+}
+
+static void track_fence(void *p)
+{
+    SDL_GPUFence *f = (SDL_GPUFence *)p;
+    atomic_fetch_add(&f->refs, 1); /* acquired only when the callback is registered */
+    WGPUQueueWorkDoneCallbackInfo info = { .mode = WGPUCallbackMode_AllowSpontaneous,
+        .callback = on_fence, .userdata1 = p };
+    wgpuQueueOnSubmittedWorkDone(s_queue, info);
+}
+
+/* Queue submission is asynchronous even when replay has returned. */
+SDL_GPUFence *WG_SubmitGPUCommandBufferAndAcquireFence(SDL_GPUCommandBuffer *c)
+{
+    SDL_GPUFence *f = (SDL_GPUFence *)calloc(1, sizeof *f);
+    if (!f) { if (c) cmd_free(c); SDL_SetError("WebGPU fence allocation failed"); return NULL; }
+    atomic_init(&f->state, 0);
+    atomic_init(&f->refs, 1);       /* caller; registration adds the callback */
+    if (!submit(c, f)) { fence_drop(f); return NULL; }
+    return f;
+}
+bool WG_WaitForGPUFences(SDL_GPUDevice *d, bool all, SDL_GPUFence *const *f, Uint32 n)
+{
+    (void)d;
+    if (!n) return true;
+    if (!f) { SDL_SetError("WebGPU fence array is null"); return false; }
+    for (;;) {
+        int event = atomic_load(&s_fence_event);
+        Uint32 done = 0;
+        for (Uint32 i = 0; i < n; i++) {
+            if (!f[i]) { SDL_SetError("WebGPU fence is null"); return false; }
+            int state = atomic_load(&f[i]->state);
+            if (state < 0) { SDL_SetError("WebGPU queue completion failed"); return false; }
+            done += state != 0;
+        }
+        if (all ? done == n : done != 0) return true;
+        /* Observe the epoch before checking states to avoid a lost wakeup. */
+        emscripten_futex_wait((void *)&s_fence_event, event, 1000.0);
+    }
+}
+void WG_ReleaseGPUFence(SDL_GPUDevice *d, SDL_GPUFence *f) { (void)d; if (f) fence_drop(f); }
+
+/* ── Presenting ───────────────────────────────────────────────────────── */
+typedef struct { uint32_t w, h; } SizeArgs;
+static void do_configure(void *p)
+{
+    SizeArgs *a = (SizeArgs *)p;
+    if (!s_surface) return;
+    emscripten_set_canvas_element_size(s_canvas_selector, (int)a->w, (int)a->h);
+    WGPUSurfaceConfiguration cfg = { .device = s_dev, .format = s_surface_format,
+        .usage = WGPUTextureUsage_RenderAttachment, .width = a->w, .height = a->h,
+        .alphaMode = WGPUCompositeAlphaMode_Opaque, .presentMode = WGPUPresentMode_Fifo };
+    wgpuSurfaceConfigure(s_surface, &cfg);
+    s_surface_w = a->w;
+    s_surface_h = a->h;
+}
+
+static void window_pixels(SDL_Window *w, uint32_t *pw, uint32_t *ph)
+{
+    int x = 0, y = 0;
+    if (w) SDL_GetWindowSizeInPixels(w, &x, &y);
+    *pw = x > 0 ? (uint32_t)x : 640;
+    *ph = y > 0 ? (uint32_t)y : 480;
+}
+
+bool WG_ClaimWindowForGPUDevice(SDL_GPUDevice *d, SDL_Window *w)
+{
+    (void)d;
+    SizeArgs a;
+    if (!s_surface) { SDL_SetError("no WebGPU canvas"); return false; }
+    window_pixels(w, &a.w, &a.h);
+    run_sync(do_configure, &a);
+    /* Show the GPU canvas over SDL's (which keeps the input focus). */
+    MAIN_THREAD_EM_ASM({
+        var c = document.querySelector(UTF8ToString($0));
+        if (c) c.hidden = false;
+        if (Module['onGpuPresent']) Module['onGpuPresent'](true);
+    }, s_canvas_selector);
+    return true;
+}
+void WG_ReleaseWindowFromGPUDevice(SDL_GPUDevice *d, SDL_Window *w)
+{
+    (void)d; (void)w;
+    MAIN_THREAD_EM_ASM({
+        var c = document.querySelector(UTF8ToString($0));
+        if (c) c.hidden = true;
+        if (Module['onGpuPresent']) Module['onGpuPresent'](false);
+    }, s_canvas_selector);
+}
+
+/* Wait for the next animation frame on the server: the presenter's pacing.
+ * The callback finishes the proxied call through an exported C function. */
+EMSCRIPTEN_KEEPALIVE void wg_frame_done(em_proxying_ctx *ctx) { emscripten_proxy_finish(ctx); }
+EM_JS(void, wg_frame_wait_js, (em_proxying_ctx *ctx), {
+    var done = () => _wg_frame_done(ctx);
+    if (typeof requestAnimationFrame === 'function') requestAnimationFrame(done);
+    else setTimeout(done, 16);
+});
+static void do_frame_wait(em_proxying_ctx *ctx, void *p) { (void)p; wg_frame_wait_js(ctx); }
+
+bool WG_WaitAndAcquireGPUSwapchainTexture(SDL_GPUCommandBuffer *c, SDL_Window *w, SDL_GPUTexture **t, Uint32 *tw, Uint32 *th)
+{
+    static struct SDL_GPUTexture swap = { .swapchain = 1, .levels = 1 };
+    SizeArgs a;
+    (void)c;
+    window_pixels(w, &a.w, &a.h);
+    if (a.w != s_surface_w || a.h != s_surface_h)
+        run_sync(do_configure, &a);
+    run_sync_ctx(do_frame_wait, NULL);
+    swap.w = s_surface_w;
+    swap.h = s_surface_h;
+    swap.format = s_surface_format;
+    *t = &swap;
+    if (tw) *tw = s_surface_w;
+    if (th) *th = s_surface_h;
+    return true;
+}
+#endif /* __EMSCRIPTEN__ */
diff --git a/src/kernel/sdlgpu/webgpu/sdl_gpu_webgpu.h b/src/kernel/sdlgpu/webgpu/sdl_gpu_webgpu.h
new file mode 100644
index 0000000..b1e0dec
--- /dev/null
+++ b/src/kernel/sdlgpu/webgpu/sdl_gpu_webgpu.h
@@ -0,0 +1,153 @@
+#ifndef SDL_GPU_WEBGPU_H
+#define SDL_GPU_WEBGPU_H
+/* The SDL GPU renderer on WebGPU (Emscripten builds).
+ *
+ * SDL 3 has no WebGPU backend for its GPU API, so the subset of that API the
+ * renderer in src/kernel/sdlgpu/ uses -- 46 functions, SDL's own types -- is
+ * implemented here on Dawn's webgpu.h (emdawnwebgpu), and this header
+ * redirects the renderer's SDL_*GPU* calls to it. The renderer itself is
+ * unchanged apart from loading WGSL shaders (webgpu/sg_wgsl.h, generated
+ * from its GLSL by tools/gen-wgsl.py).
+ *
+ * Threads. A WebGPU device and everything made from it belong to the
+ * JavaScript context that created them, and a device only makes progress
+ * (mapAsync, adapter requests, presenting) when that context returns to its
+ * event loop -- which the renderer's threads never do. So one thread, the
+ * GPU server, owns the device and sits in its event loop; every call below,
+ * from any thread, runs there through Emscripten's proxying queue. Command
+ * buffers are recorded on the caller's side and replayed into a
+ * GPUCommandEncoder on submit. Submits are synchronous (they copy upload data
+ * into WebGPU before returning) and wait for any downloads in them. The
+ * renderer calls from two threads -- the pushbuffer executor and the window
+ * presenter -- which this makes safe.
+ *
+ * Presenting. The server thread receives the page's <canvas id="gpucanvas">
+ * (an OffscreenCanvas, transferred to the program's main thread at startup by
+ * -sOFFSCREENCANVASES_TO_PTHREAD and on to the server when it is created), so
+ * wg_server_start() must run on the main thread. A frame is shown when the
+ * server returns to its event loop after the submit that drew it. Acquiring a
+ * swapchain texture waits for the next animation frame, which paces the
+ * presenter as vsync does natively. */
+#ifdef __EMSCRIPTEN__
+#include <SDL3/SDL.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Start the GPU server and create the WebGPU device; `canvas_id` is the id of
+ * the transferred presentation canvas (no '#'). Call once, on the main
+ * thread. Returns 0 when the browser has no usable WebGPU; the renderer then
+ * finds no device and draws in software. */
+int wg_server_start(const char *canvas_id);
+/* 1 once wg_server_start() succeeded. */
+int wg_available(void);
+
+/* SDL_GPU_SHADERFORMAT_PRIVATE carries WGSL source here: the shader format
+ * enum has no WGSL value in SDL 3.2. */
+#define SDL_GPU_SHADERFORMAT_WGSL SDL_GPU_SHADERFORMAT_PRIVATE
+
+#define WG_API(ret, name, args) ret WG_##name args;
+WG_API(SDL_GPUDevice *, CreateGPUDevice, (SDL_GPUShaderFormat formats, bool debug, const char *name))
+WG_API(void, DestroyGPUDevice, (SDL_GPUDevice *d))
+WG_API(const char *, GetGPUDeviceDriver, (SDL_GPUDevice *d))
+WG_API(bool, GPUTextureSupportsFormat, (SDL_GPUDevice *d, SDL_GPUTextureFormat f, SDL_GPUTextureType t, SDL_GPUTextureUsageFlags u))
+WG_API(SDL_GPUTexture *, CreateGPUTexture, (SDL_GPUDevice *d, const SDL_GPUTextureCreateInfo *i))
+WG_API(void, ReleaseGPUTexture, (SDL_GPUDevice *d, SDL_GPUTexture *t))
+WG_API(SDL_GPUBuffer *, CreateGPUBuffer, (SDL_GPUDevice *d, const SDL_GPUBufferCreateInfo *i))
+WG_API(void, ReleaseGPUBuffer, (SDL_GPUDevice *d, SDL_GPUBuffer *b))
+WG_API(SDL_GPUTransferBuffer *, CreateGPUTransferBuffer, (SDL_GPUDevice *d, const SDL_GPUTransferBufferCreateInfo *i))
+WG_API(void, ReleaseGPUTransferBuffer, (SDL_GPUDevice *d, SDL_GPUTransferBuffer *b))
+WG_API(void *, MapGPUTransferBuffer, (SDL_GPUDevice *d, SDL_GPUTransferBuffer *b, bool cycle))
+WG_API(void, UnmapGPUTransferBuffer, (SDL_GPUDevice *d, SDL_GPUTransferBuffer *b))
+WG_API(SDL_GPUSampler *, CreateGPUSampler, (SDL_GPUDevice *d, const SDL_GPUSamplerCreateInfo *i))
+WG_API(SDL_GPUShader *, CreateGPUShader, (SDL_GPUDevice *d, const SDL_GPUShaderCreateInfo *i))
