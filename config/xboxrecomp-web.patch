+        if(invalid==0)SDL_BindGPUVertexBuffers(pass,7,bindings,2);
+        if(invalid==1){bindings[0].offset=1;SDL_BindGPUVertexBuffers(pass,0,bindings,1);}
+        if(invalid==2){bindings[1].buffer=NULL;SDL_BindGPUVertexBuffers(pass,0,bindings,2);}
+        SDL_EndGPURenderPass(pass);
+        CHECK(!SDL_SubmitGPUCommandBuffer(bad),"invalid vertex binding %u rejects the recording before GPU replay",invalid);
+    }
+    for(unsigned indexed=0;indexed<2;indexed++) {
+        SDL_GPUCommandBuffer *cmd=SDL_AcquireGPUCommandBuffer(dev);
+        SDL_GPUColorTargetInfo ct={.texture=color,.load_op=SDL_GPU_LOADOP_CLEAR,.store_op=SDL_GPU_STOREOP_STORE,.clear_color={0,0,0,1}};
+        SDL_GPUDepthStencilTargetInfo dt={.texture=depth,.clear_depth=1,.load_op=SDL_GPU_LOADOP_CLEAR,.store_op=SDL_GPU_STOREOP_STORE,
+            .stencil_load_op=SDL_GPU_LOADOP_CLEAR,.stencil_store_op=SDL_GPU_STOREOP_STORE};
+        SDL_GPURenderPass *pass=SDL_BeginGPURenderPass(cmd,&ct,1,&dt);
+        SDL_GPUViewport viewport={0,0,W,H,0,1};SDL_SetGPUViewport(pass,&viewport);
+        SDL_Rect scissor={0,0,W,H};SDL_SetGPUScissor(pass,&scissor);
+        SDL_BindGPUGraphicsPipeline(pass,indexed?edge_pipe:pipe);
+        SDL_GPUBufferBinding first={.buffer=buffers[0]};SDL_BindGPUVertexBuffers(pass,0,&first,1);
+        SDL_GPUBufferBinding instances[2]={{.buffer=buffers[1],.offset=12},{.buffer=buffers[2],.offset=16}};
+        if(indexed){SDL_BindGPUVertexBuffers(pass,2,instances,1);SDL_BindGPUVertexBuffers(pass,7,instances+1,1);}
+        else SDL_BindGPUVertexBuffers(pass,2,instances,2);
+        float viewport_uniform[4]={W,H,0,0};Shade shade={.tex_size={1,1}};
+        SDL_PushGPUVertexUniformData(cmd,0,viewport_uniform,sizeof viewport_uniform);
+        SDL_PushGPUFragmentUniformData(cmd,0,&shade,sizeof shade);
+        SDL_GPUTextureSamplerBinding texture={.texture=white,.sampler=point_wrap};SDL_BindGPUFragmentSamplers(pass,0,&texture,1);
+        if(indexed) {
+            SDL_GPUBufferBinding index={.buffer=buffers[3]};SDL_BindGPUIndexBuffer(pass,&index,SDL_GPU_INDEXELEMENTSIZE_32BIT);
+            SDL_DrawGPUIndexedPrimitives(pass,6,2,3,2,1);
+        } else SDL_DrawGPUPrimitives(pass,6,2,2,1);
+        SDL_EndGPURenderPass(pass);
+        if(indexed) {
+            for(unsigned i=0;i<4;i++)SDL_ReleaseGPUBuffer(dev,buffers[i]);
+            SDL_ReleaseGPUGraphicsPipeline(dev,pipe);SDL_ReleaseGPUGraphicsPipeline(dev,edge_pipe);
+        }
+        CHECK(SDL_SubmitGPUCommandBuffer(cmd),"submit %s instances with nonzero first instance and vertex/index offsets",indexed?"indexed":"unindexed");
+        download(color,0,W,H,img);unsigned errors=0;
+        for(unsigned y=0;y<H;y++)for(unsigned x=0;x<W;x++) {
+            uint32_t expected=x>=40&&x<50&&y>=20&&y<30?0xffff0000u:
+                x>=80&&x<100&&y>=20&&y<40?0xff00ff00u:0xff000000u;
+            if(px(img,x,y)!=expected)errors++;
