--- a/src/apu/apu_vp.c
+++ b/src/apu/apu_vp.c
@@ -117,7 +117,19 @@
 static float attenuate(uint16_t vol)
 {
     vol &= 0xFFF;
-    return (vol == 0xFFF) ? 0.0f : powf(10.0f, vol / (64.0f * -20.0f));
+    if (vol == 0xFFF) return 0.0f;
+    /* Called by the serialized APU voice mixer. Retain the original powf
+     * result for each 12-bit attenuation rather than recomputing it for
+     * every mixbin of every 32-sample frame. All non-muted gains are positive,
+     * so zero denotes an uncomputed entry. Populate lazily to avoid a startup
+     * burst of 4095 exponentiations; this is an exact cache, not a curve fit. */
+    static float gains[0xFFF];
+    float gain = gains[vol];
+    if (gain == 0.0f) {
+        gain = powf(10.0f, vol / (64.0f * -20.0f));
+        gains[vol] = gain;
+    }
+    return gain;
 }

