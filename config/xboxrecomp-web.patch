+// Runtime-specialized NV2A vertex programs. tools/gen-wgsl.py embeds the
+// two halves; the C translator inserts straight-line instructions between them.
+struct VpUniforms {
+    c: array<vec4f, 192>,
+    info: vec4f,
+    clipr: vec4f,
+    fogp: vec4f,
+    lightp: vec4f,
+}
+@group(1) @binding(0) var<uniform> vc: VpUniforms;
+struct VpInputs {
+    @location(0) v0: vec4f, @location(1) v1: vec4f,
+    @location(2) v2: vec4f, @location(3) v3: vec4f,
+    @location(4) v4: vec4f, @location(5) v5: vec4f,
+    @location(6) v6: vec4f, @location(7) v7: vec4f,
+    @location(8) v8: vec4f, @location(9) v9: vec4f,
+    @location(10) v10: vec4f, @location(11) v11: vec4f,
+    @location(12) v12: vec4f, @location(13) v13: vec4f,
+    @location(14) v14: vec4f, @location(15) v15: vec4f,
+}
+struct VpOutputs {
+    @builtin(position) position: vec4f,
+    @location(0) color: vec4f, @location(1) specular: vec4f,
+    @location(2) t0: vec4f, @location(3) t1: vec4f,
+    @location(4) t2: vec4f, @location(5) t3: vec4f,
+    @location(6) fog: f32, @location(7) w: f32,
+}
+fn vnan(x: f32) -> bool { return (bitcast<u32>(x) & 0x7fffffffu) > 0x7f800000u; }
+fn vinf(x: f32) -> bool { return (bitcast<u32>(x) & 0x7fffffffu) == 0x7f800000u; }
+// WGSL rejects NaN/Inf in constant expressions. A function parameter keeps
+// the bitcast a runtime expression, as required for NV2A exceptional math.
+fn vexception(bits: u32) -> f32 { return bitcast<f32>(bits); }
+fn vrcp(x: f32) -> f32 {
+    if (x == 1.0) { return 1.0; }
+    if (x == 0.0) { return vexception(0x7f800000u); }
+    return 1.0 / x;
+}
+fn vrcc(x: f32) -> f32 {
+    var r = 1.8446743e19;
+    if (x != 0.0) { r = 1.0 / x; }
+    if (r > 0.0) { return clamp(r, 5.42101e-20, 1.8446743e19); }
+    return clamp(r, -1.8446743e19, -5.42101e-20);
+}
+fn vrsq(x: f32) -> f32 {
+    let a = abs(x);
+    if (a == 1.0) { return 1.0; }
+    if (a == 0.0) { return vexception(0x7f800000u); }
+    return inverseSqrt(a);
+}
+fn vexp(x: f32) -> vec4f { let f = floor(x); return vec4f(exp2(f), x - f, exp2(x), 1.0); }
+fn vlog(x: f32) -> vec4f {
+    let a = abs(x);
+    if (a == 0.0) { return vec4f(vexception(0xff800000u), 1.0, vexception(0xff800000u), 1.0); }
+    let e = floor(log2(a));
+    return vec4f(e, a / exp2(e), log2(a), 1.0);
+}
+fn vlit(s: vec4f) -> vec4f {
+    let sx = max(s.x, 0.0); let sy = max(s.y, 0.0);
+    let sw = clamp(s.w, -127.996, 127.996);
+    var z = 0.0;
+    if (sx > 0.0) { z = exp2(sw * log2(sy)); }
+    return vec4f(1.0, sx, z, 1.0);
+}
+fn vclampw(w: f32) -> f32 {
+    if ((bitcast<u32>(w) & 0x80000000u) == 0u) {
+        return clamp(w, bitcast<f32>(0x1f800000u), bitcast<f32>(0x5f800000u));
+    }
+    return clamp(w, bitcast<f32>(0xdf800000u), bitcast<f32>(0x9f800000u));
+}
+@vertex fn main(vin: VpInputs) -> VpOutputs {
+    let v = array<vec4f, 16>(vin.v0, vin.v1, vin.v2, vin.v3, vin.v4, vin.v5, vin.v6, vin.v7,
+                           vin.v8, vin.v9, vin.v10, vin.v11, vin.v12, vin.v13, vin.v14, vin.v15);
+    var R: array<vec4f, 13>;
+    var O: array<vec4f, 16>;
+    var a0 = 0;
+    for (var k = 0u; k < 16u; k++) { O[k] = vec4f(0.0, 0.0, 0.0, 1.0); }
+// INSERT_PROGRAM
+    let p = O[0];
+    let w = vclampw(p.w);
+    let nx = (p.x + vc.info.w) / vc.info.x * 2.0 - 1.0;
+    let ny = 1.0 - p.y / vc.info.y * 2.0;
+    var nz = p.z / vc.info.z;
+    // Guest depth clamp is independent of clipping against the eye plane.
+    if (vc.lightp.z != 0.0) { nz = clamp(nz, 0.0, 1.0); }
+    var position = vec4f(nx * w, ny * w, nz * w, w);
+    if (vnan(p.x) || vnan(p.y) || vnan(p.w)) { position = vec4f(vexception(0x7fc00000u)); }
+    var d0 = O[3]; var d1 = O[4];
+    for (var k = 0u; k < 4u; k++) {
+        if (vnan(d0[k])) { d0[k] = 1.0; }
+        if (vnan(d1[k])) { d1[k] = 1.0; }
+    }
+    d0 = clamp(d0, vec4f(0.0), vec4f(1.0));
+    d1 = clamp(d1, vec4f(0.0), vec4f(1.0));
+    if (vc.lightp.x == 0.0) { d1 = vec4f(0.0, 0.0, 0.0, 1.0); }
+    if (vc.lightp.y == 0.0) { d1.w = 1.0; }
+    let fd = O[5].x; var ff = 1.0; var exceptional = 0.0;
+    let fm = bitcast<u32>(vc.fogp.y);
+    if (vc.fogp.x != 0.0) {
+        if (fm == 0x2601u || fm == 0x804u) { ff = vc.fogp.z + fd * vc.fogp.w - 1.0; }
+        else if (fm == 0x800u || fm == 0x802u) { ff = vc.fogp.z + exp2(fd * vc.fogp.w * 16.0) - 1.5; }
+        else if (fm == 0x801u || fm == 0x803u) { ff = vc.fogp.z + exp2(-fd * fd * vc.fogp.w * vc.fogp.w * 32.0) - 1.5; }
+        if (fm == 0x2601u || fm == 0x804u || fm == 0x800u) { exceptional = 1.0; }
+        if (fm == 0x804u || fm == 0x802u || fm == 0x803u) { ff = abs(ff); }
+        if (vinf(fd) || vnan(ff)) { ff = exceptional; }
+        else { ff = clamp(ff, -bitcast<f32>(0x7f7fffffu), bitcast<f32>(0x7f7fffffu)); }
+    }
+    return VpOutputs(position, d0, d1, O[9], O[10], O[11], O[12], ff, w);
+}
