+    (void)arg;
+    s_init_ctx = ctx;
+    if (!EM_ASM_INT({ return !!(typeof navigator !== 'undefined' && navigator.gpu); })) {
+        fprintf(stderr, "  [WebGPU] not available in this browser\n");
+        emscripten_proxy_finish(ctx);
+        return;
+    }
+    s_inst = wgpuCreateInstance(NULL);
+    WGPURequestAdapterOptions opt = { .powerPreference = WGPUPowerPreference_HighPerformance };
+    WGPURequestAdapterCallbackInfo ci = { .mode = WGPUCallbackMode_AllowSpontaneous, .callback = on_adapter };
+    wgpuInstanceRequestAdapter(s_inst, &opt, ci);
+}
+
+int wg_server_start(const char *canvas_id)
+{
+    pthread_attr_t at;
+    if (atomic_load(&s_available))
+        return 1;
+    snprintf(s_canvas_selector, sizeof s_canvas_selector, "#%s", canvas_id);
+    pthread_attr_init(&at);
+    /* The bare id: how a thread keys a canvas it holds (GL.offscreenCanvases). */
+    emscripten_pthread_attr_settransferredcanvases(&at, canvas_id);
+    if (pthread_create(&s_server, &at, server_main, NULL) != 0) {
+        fprintf(stderr, "  [WebGPU] cannot start the GPU thread (is #%s on the page?)\n", canvas_id);
+        return 0;
+    }
+    run_sync_ctx(do_init, NULL);
+    if (atomic_load(&s_available))
+        fprintf(stderr, "  [WebGPU] device ready (depth32float-stencil8 %s, surface format %d)\n",
+                s_has_d32s8 ? "yes" : "no", (int)s_surface_format);
+    return atomic_load(&s_available);
+}
+
+int wg_available(void) { return atomic_load(&s_available); }
+
+/* ── Enum translation ─────────────────────────────────────────────────── */
+static WGPUTextureFormat tex_format(SDL_GPUTextureFormat f)
+{
+    switch (f) {
+    case SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM: return WGPUTextureFormat_BGRA8Unorm;
+    case SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM: return WGPUTextureFormat_RGBA8Unorm;
+    case SDL_GPU_TEXTUREFORMAT_D32_FLOAT_S8_UINT: return WGPUTextureFormat_Depth32FloatStencil8;
+    case SDL_GPU_TEXTUREFORMAT_D24_UNORM_S8_UINT: return WGPUTextureFormat_Depth24PlusStencil8;
+    case SDL_GPU_TEXTUREFORMAT_D32_FLOAT: return WGPUTextureFormat_Depth32Float;
+    case SDL_GPU_TEXTUREFORMAT_D16_UNORM: return WGPUTextureFormat_Depth16Unorm;
+    default: return WGPUTextureFormat_Undefined;
+    }
+}
+static int is_depth(WGPUTextureFormat f)
+{
+    return f == WGPUTextureFormat_Depth32FloatStencil8 || f == WGPUTextureFormat_Depth24PlusStencil8 ||
+           f == WGPUTextureFormat_Depth32Float || f == WGPUTextureFormat_Depth16Unorm;
+}
+static int has_stencil(WGPUTextureFormat f)
+{
+    return f == WGPUTextureFormat_Depth32FloatStencil8 || f == WGPUTextureFormat_Depth24PlusStencil8;
+}
+static WGPUBlendFactor blend_factor(SDL_GPUBlendFactor f)
+{
+    switch (f) {
+    case SDL_GPU_BLENDFACTOR_ZERO: return WGPUBlendFactor_Zero;
+    case SDL_GPU_BLENDFACTOR_ONE: return WGPUBlendFactor_One;
+    case SDL_GPU_BLENDFACTOR_SRC_COLOR: return WGPUBlendFactor_Src;
+    case SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_COLOR: return WGPUBlendFactor_OneMinusSrc;
+    case SDL_GPU_BLENDFACTOR_DST_COLOR: return WGPUBlendFactor_Dst;
+    case SDL_GPU_BLENDFACTOR_ONE_MINUS_DST_COLOR: return WGPUBlendFactor_OneMinusDst;
+    case SDL_GPU_BLENDFACTOR_SRC_ALPHA: return WGPUBlendFactor_SrcAlpha;
+    case SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA: return WGPUBlendFactor_OneMinusSrcAlpha;
+    case SDL_GPU_BLENDFACTOR_DST_ALPHA: return WGPUBlendFactor_DstAlpha;
+    case SDL_GPU_BLENDFACTOR_ONE_MINUS_DST_ALPHA: return WGPUBlendFactor_OneMinusDstAlpha;
+    case SDL_GPU_BLENDFACTOR_CONSTANT_COLOR: return WGPUBlendFactor_Constant;
+    case SDL_GPU_BLENDFACTOR_ONE_MINUS_CONSTANT_COLOR: return WGPUBlendFactor_OneMinusConstant;
+    case SDL_GPU_BLENDFACTOR_SRC_ALPHA_SATURATE: return WGPUBlendFactor_SrcAlphaSaturated;
+    default: return WGPUBlendFactor_One;
+    }
+}
+static WGPUBlendOperation blend_op(SDL_GPUBlendOp o)
+{
+    switch (o) {
+    case SDL_GPU_BLENDOP_SUBTRACT: return WGPUBlendOperation_Subtract;
+    case SDL_GPU_BLENDOP_REVERSE_SUBTRACT: return WGPUBlendOperation_ReverseSubtract;
+    case SDL_GPU_BLENDOP_MIN: return WGPUBlendOperation_Min;
+    case SDL_GPU_BLENDOP_MAX: return WGPUBlendOperation_Max;
+    default: return WGPUBlendOperation_Add;
+    }
+}
+static WGPUCompareFunction compare(SDL_GPUCompareOp c)
+{
+    switch (c) {
+    case SDL_GPU_COMPAREOP_NEVER: return WGPUCompareFunction_Never;
+    case SDL_GPU_COMPAREOP_LESS: return WGPUCompareFunction_Less;
+    case SDL_GPU_COMPAREOP_EQUAL: return WGPUCompareFunction_Equal;
+    case SDL_GPU_COMPAREOP_LESS_OR_EQUAL: return WGPUCompareFunction_LessEqual;
+    case SDL_GPU_COMPAREOP_GREATER: return WGPUCompareFunction_Greater;
+    case SDL_GPU_COMPAREOP_NOT_EQUAL: return WGPUCompareFunction_NotEqual;
+    case SDL_GPU_COMPAREOP_GREATER_OR_EQUAL: return WGPUCompareFunction_GreaterEqual;
+    default: return WGPUCompareFunction_Always;
+    }
+}
+static WGPUStencilOperation stencil_op(SDL_GPUStencilOp o)
+{
+    switch (o) {
+    case SDL_GPU_STENCILOP_ZERO: return WGPUStencilOperation_Zero;
+    case SDL_GPU_STENCILOP_REPLACE: return WGPUStencilOperation_Replace;
+    case SDL_GPU_STENCILOP_INCREMENT_AND_CLAMP: return WGPUStencilOperation_IncrementClamp;
+    case SDL_GPU_STENCILOP_DECREMENT_AND_CLAMP: return WGPUStencilOperation_DecrementClamp;
+    case SDL_GPU_STENCILOP_INVERT: return WGPUStencilOperation_Invert;
+    case SDL_GPU_STENCILOP_INCREMENT_AND_WRAP: return WGPUStencilOperation_IncrementWrap;
+    case SDL_GPU_STENCILOP_DECREMENT_AND_WRAP: return WGPUStencilOperation_DecrementWrap;
+    default: return WGPUStencilOperation_Keep;
+    }
+}
+static WGPUAddressMode address(SDL_GPUSamplerAddressMode m)
+{
+    switch (m) {
+    case SDL_GPU_SAMPLERADDRESSMODE_REPEAT: return WGPUAddressMode_Repeat;
+    case SDL_GPU_SAMPLERADDRESSMODE_MIRRORED_REPEAT: return WGPUAddressMode_MirrorRepeat;
+    default: return WGPUAddressMode_ClampToEdge;
+    }
+}
+static WGPUVertexFormat vertex_format(SDL_GPUVertexElementFormat f)
+{
+    switch (f) {
+    case SDL_GPU_VERTEXELEMENTFORMAT_FLOAT: return WGPUVertexFormat_Float32;
+    case SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2: return WGPUVertexFormat_Float32x2;
+    case SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3: return WGPUVertexFormat_Float32x3;
+    case SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4: return WGPUVertexFormat_Float32x4;
+    case SDL_GPU_VERTEXELEMENTFORMAT_UBYTE4_NORM: return WGPUVertexFormat_Unorm8x4;
+    default: return WGPUVertexFormat_Float32x4;
+    }
+}
+static WGPULoadOp load_op(SDL_GPULoadOp o) { return o == SDL_GPU_LOADOP_LOAD ? WGPULoadOp_Load : WGPULoadOp_Clear; }
+static WGPUStoreOp store_op(SDL_GPUStoreOp o) { return o == SDL_GPU_STOREOP_STORE ? WGPUStoreOp_Store : WGPUStoreOp_Discard; }
+
+/* ── Device ───────────────────────────────────────────────────────────── */
+SDL_GPUDevice *WG_CreateGPUDevice(SDL_GPUShaderFormat formats, bool debug, const char *name)
+{
+    (void)debug; (void)name;
+    if (!atomic_load(&s_available)) { SDL_SetError("WebGPU is not available"); return NULL; }
+    if (!(formats & SDL_GPU_SHADERFORMAT_WGSL)) { SDL_SetError("WebGPU takes WGSL shaders"); return NULL; }
+    return &s_device_obj;
+}
+void WG_DestroyGPUDevice(SDL_GPUDevice *d) { (void)d; }
+const char *WG_GetGPUDeviceDriver(SDL_GPUDevice *d) { (void)d; return "webgpu"; }
+bool WG_GPUTextureSupportsFormat(SDL_GPUDevice *d, SDL_GPUTextureFormat f, SDL_GPUTextureType t, SDL_GPUTextureUsageFlags u)
+{
+    (void)d; (void)t; (void)u;
+    WGPUTextureFormat w = tex_format(f);
+    if (w == WGPUTextureFormat_Depth32FloatStencil8) return s_has_d32s8;
+    return w != WGPUTextureFormat_Undefined;
+}
+
+/* ── Textures ─────────────────────────────────────────────────────────── */
+typedef struct { const SDL_GPUTextureCreateInfo *info; SDL_GPUTexture *out; } TexArgs;
+
+static void do_create_texture(void *p)
+{
+    TexArgs *a = (TexArgs *)p;
+    const SDL_GPUTextureCreateInfo *i = a->info;
+    SDL_GPUTexture *t = (SDL_GPUTexture *)calloc(1, sizeof *t);
+    if (!t) return;
+    WGPUTextureUsage usage = 0;
+    t->format = tex_format(i->format);
+    t->w = i->width; t->h = i->height; t->levels = i->num_levels ? i->num_levels : 1;
+    t->layers = i->type == SDL_GPU_TEXTURETYPE_CUBE ? 6u : 1u;
+    if (i->usage & SDL_GPU_TEXTUREUSAGE_SAMPLER) usage |= WGPUTextureUsage_TextureBinding;
+    if (i->usage & (SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET))
+        usage |= WGPUTextureUsage_RenderAttachment;
+    if (!is_depth(t->format))
+        usage |= WGPUTextureUsage_CopySrc | WGPUTextureUsage_CopyDst;  /* uploads, downloads, copies */
+    if (t->levels > 1)
+        usage |= WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding;  /* mip generation */
+    WGPUTextureDescriptor d = { .usage = usage, .dimension = WGPUTextureDimension_2D,
+        .size = { t->w, t->h, t->layers }, .format = t->format, .mipLevelCount = t->levels, .sampleCount = 1 };
+    t->tex = wgpuDeviceCreateTexture(s_dev, &d);
+    if (!t->tex || t->format == WGPUTextureFormat_Undefined) { free(t); return; }
+    if (usage & WGPUTextureUsage_TextureBinding) {
+        WGPUTextureViewDescriptor vd = { .format = t->format,
+            .dimension = t->layers == 6 ? WGPUTextureViewDimension_Cube : WGPUTextureViewDimension_2D,
+            .mipLevelCount = t->levels, .arrayLayerCount = t->layers, .aspect = WGPUTextureAspect_All };
+        t->view = wgpuTextureCreateView(t->tex, &vd);
+    }
+    t->level_views = (WGPUTextureView *)calloc(t->levels * t->layers, sizeof *t->level_views);
+    if (!t->level_views) {
+        if (t->view) wgpuTextureViewRelease(t->view);
+        wgpuTextureRelease(t->tex); free(t); return;
+    }
+    for (uint32_t face = 0; face < t->layers; face++)
+    for (uint32_t l = 0; l < t->levels; l++) {
+        WGPUTextureViewDescriptor vd = { .format = t->format, .dimension = WGPUTextureViewDimension_2D,
+            .baseMipLevel = l, .mipLevelCount = 1, .baseArrayLayer = face, .arrayLayerCount = 1,
+            .aspect = WGPUTextureAspect_All };
+        t->level_views[face * t->levels + l] = wgpuTextureCreateView(t->tex, &vd);
+    }
+    a->out = t;
+}
+
+SDL_GPUTexture *WG_CreateGPUTexture(SDL_GPUDevice *d, const SDL_GPUTextureCreateInfo *i)
+{
+    (void)d;
+    TexArgs a = { i, NULL };
+    if (tex_format(i->format) == WGPUTextureFormat_Undefined) { SDL_SetError("texture format not supported on WebGPU"); return NULL; }
+    run_sync(do_create_texture, &a);
+    if (!a.out) SDL_SetError("WebGPU texture creation failed");
+    return a.out;
+}
+
+static void do_release_texture(void *p)
+{
+    SDL_GPUTexture *t = (SDL_GPUTexture *)p;
+    for (uint32_t i = 0; i < WG_BIND_CACHE; i++) {
+        WgBindCache *entry = &s_bind_cache[i];
+        if (!entry->group) continue;
+        for (uint32_t j = 0; j < WG_MAX_SAMPLERS; j++) {
+            if (entry->textures[j] != t) continue;
+            wgpuBindGroupRelease(entry->group);
+            entry->group = NULL;
+            break;
+        }
+    }
+    for (uint32_t l = 0; l < t->levels * t->layers; l++) if (t->level_views[l]) wgpuTextureViewRelease(t->level_views[l]);
+    free(t->level_views);
+    if (t->view) wgpuTextureViewRelease(t->view);
+    if (t->tex) wgpuTextureRelease(t->tex);
+    free(t);
+}
+void WG_ReleaseGPUTexture(SDL_GPUDevice *d, SDL_GPUTexture *t)
+{
+    (void)d;
+    if (t && !t->swapchain) emscripten_proxy_async(q(), s_server, do_release_texture, t);
+}
+
+/* ── Buffers ──────────────────────────────────────────────────────────── */
+typedef struct { const SDL_GPUBufferCreateInfo *info; SDL_GPUBuffer *out; } BufArgs;
+static void do_create_buffer(void *p)
+{
+    BufArgs *a = (BufArgs *)p;
+    WGPUBufferUsage u = WGPUBufferUsage_CopyDst;
+    if (a->info->usage & SDL_GPU_BUFFERUSAGE_VERTEX) u |= WGPUBufferUsage_Vertex;
+    if (a->info->usage & SDL_GPU_BUFFERUSAGE_INDEX) u |= WGPUBufferUsage_Index;
+    SDL_GPUBuffer *b = (SDL_GPUBuffer *)calloc(1, sizeof *b);
+    if (!b) return;
+    b->size = (a->info->size + 3u) & ~3u;
+    WGPUBufferDescriptor d = { .usage = u, .size = b->size };
+    b->buf = wgpuDeviceCreateBuffer(s_dev, &d);
+    if (!b->buf) { free(b); return; }
+    a->out = b;
+}
+SDL_GPUBuffer *WG_CreateGPUBuffer(SDL_GPUDevice *d, const SDL_GPUBufferCreateInfo *i)
+{
+    (void)d;
+    BufArgs a = { i, NULL };
+    run_sync(do_create_buffer, &a);
+    return a.out;
+}
+static void do_release_buffer(void *p) { SDL_GPUBuffer *b = (SDL_GPUBuffer *)p; wgpuBufferRelease(b->buf); free(b); }
+void WG_ReleaseGPUBuffer(SDL_GPUDevice *d, SDL_GPUBuffer *b)
+{
+    (void)d;
+    if (b) emscripten_proxy_async(q(), s_server, do_release_buffer, b);
+}
+
+/* Transfer buffers are plain memory: the server copies out of (or into) them
+ * during the synchronous submit, so they need no WebGPU object. */
+SDL_GPUTransferBuffer *WG_CreateGPUTransferBuffer(SDL_GPUDevice *d, const SDL_GPUTransferBufferCreateInfo *i)
+{
+    (void)d;
+    SDL_GPUTransferBuffer *t = (SDL_GPUTransferBuffer *)calloc(1, sizeof *t);
+    if (!t) return NULL;
+    t->size = i->size;
+    t->mem = (uint8_t *)malloc(i->size ? i->size : 1);
+    if (!t->mem) { free(t); return NULL; }
+    return t;
+}
+void WG_ReleaseGPUTransferBuffer(SDL_GPUDevice *d, SDL_GPUTransferBuffer *t) { (void)d; if (t) { free(t->mem); free(t); } }
+void *WG_MapGPUTransferBuffer(SDL_GPUDevice *d, SDL_GPUTransferBuffer *t, bool cycle) { (void)d; (void)cycle; return t ? t->mem : NULL; }
+void WG_UnmapGPUTransferBuffer(SDL_GPUDevice *d, SDL_GPUTransferBuffer *t) { (void)d; (void)t; }
+
+/* ── Samplers and shaders ─────────────────────────────────────────────── */
+typedef struct { const SDL_GPUSamplerCreateInfo *info; SDL_GPUSampler *out; } SmpArgs;
+static void do_create_sampler(void *p)
+{
+    SmpArgs *a = (SmpArgs *)p;
+    const SDL_GPUSamplerCreateInfo *i = a->info;
+    int lin_min = i->min_filter == SDL_GPU_FILTER_LINEAR, lin_mag = i->mag_filter == SDL_GPU_FILTER_LINEAR;
+    int lin_mip = i->mipmap_mode == SDL_GPU_SAMPLERMIPMAPMODE_LINEAR;
+    WGPUSamplerDescriptor d = {
+        .addressModeU = address(i->address_mode_u), .addressModeV = address(i->address_mode_v),
+        .addressModeW = address(i->address_mode_w),
+        .magFilter = lin_mag ? WGPUFilterMode_Linear : WGPUFilterMode_Nearest,
+        .minFilter = lin_min ? WGPUFilterMode_Linear : WGPUFilterMode_Nearest,
+        .mipmapFilter = lin_mip ? WGPUMipmapFilterMode_Linear : WGPUMipmapFilterMode_Nearest,
+        .lodMinClamp = i->min_lod, .lodMaxClamp = i->max_lod > 32.0f ? 32.0f : i->max_lod,
+        /* WebGPU allows anisotropy only with every filter linear. */
+        .maxAnisotropy = (i->enable_anisotropy && lin_min && lin_mag && lin_mip)
+                         ? (uint16_t)(i->max_anisotropy < 1 ? 1 : i->max_anisotropy > 16 ? 16 : i->max_anisotropy) : 1,
+    };
+    SDL_GPUSampler *s = (SDL_GPUSampler *)calloc(1, sizeof *s);
+    if (!s) return;
+    s->s = wgpuDeviceCreateSampler(s_dev, &d);
+    if (!s->s) { free(s); return; }
+    a->out = s;
+}
+SDL_GPUSampler *WG_CreateGPUSampler(SDL_GPUDevice *d, const SDL_GPUSamplerCreateInfo *i)
+{
+    (void)d;
+    SmpArgs a = { i, NULL };
+    run_sync(do_create_sampler, &a);
+    return a.out;
+}
+
+typedef struct { const SDL_GPUShaderCreateInfo *info; SDL_GPUShader *out; } ShArgs;
+static void do_create_shader(void *p)
+{
+    ShArgs *a = (ShArgs *)p;
+    /* WGSL source, NUL-terminated or not: copy it to terminate it. */
+    char *code = (char *)malloc(a->info->code_size + 1);
+    if (!code) return;
+    memcpy(code, a->info->code, a->info->code_size);
+    code[a->info->code_size] = 0;
+    WGPUShaderSourceWGSL src = { .chain = { .sType = WGPUSType_ShaderSourceWGSL }, .code = sv(code) };
+    WGPUShaderModuleDescriptor md = { .nextInChain = &src.chain };
+    WGPUShaderModule m = wgpuDeviceCreateShaderModule(s_dev, &md);
+    free(code);
+    if (!m) return;
+    SDL_GPUShader *s = (SDL_GPUShader *)calloc(1, sizeof *s);
+    if (!s) { wgpuShaderModuleRelease(m); return; }
+    s->mod = m;
+    s->stage = a->info->stage;
+    a->out = s;
+}
+SDL_GPUShader *WG_CreateGPUShader(SDL_GPUDevice *d, const SDL_GPUShaderCreateInfo *i)
+{
+    (void)d;
+    if (i->format != SDL_GPU_SHADERFORMAT_WGSL) { SDL_SetError("WebGPU takes WGSL shaders"); return NULL; }
+    ShArgs a = { i, NULL };
+    run_sync(do_create_shader, &a);
+    return a.out;
+}
+
+/* ── Pipelines ────────────────────────────────────────────────────────── */
+typedef struct { const SDL_GPUGraphicsPipelineCreateInfo *info; SDL_GPUGraphicsPipeline *out; } PipeArgs;
+static void do_create_pipeline(void *p)
+{
+    PipeArgs *a = (PipeArgs *)p;
+    const SDL_GPUGraphicsPipelineCreateInfo *i = a->info;
+    WGPUVertexAttribute attrs[16];
+    WGPUVertexBufferLayout vbl[4];
+    uint32_t nb = i->vertex_input_state.num_vertex_buffers > 4 ? 4 : i->vertex_input_state.num_vertex_buffers;
+    uint32_t na = i->vertex_input_state.num_vertex_attributes > 16 ? 16 : i->vertex_input_state.num_vertex_attributes;
+    uint32_t b, k;
+
+    for (b = 0; b < nb; b++) {
+        const SDL_GPUVertexBufferDescription *d = &i->vertex_input_state.vertex_buffer_descriptions[b];
+        uint32_t first = 0, count = 0;
+        /* Attributes are grouped per buffer slot: gather this slot's. */
+        for (k = 0; k < na; k++) {
+            const SDL_GPUVertexAttribute *va = &i->vertex_input_state.vertex_attributes[k];
+            if (va->buffer_slot != d->slot) continue;
+            if (!count) first = k;
+            attrs[k] = (WGPUVertexAttribute){ .format = vertex_format(va->format), .offset = va->offset,
+                                              .shaderLocation = va->location };
+            count++;
+        }
+        vbl[b] = (WGPUVertexBufferLayout){ .stepMode = WGPUVertexStepMode_Vertex, .arrayStride = d->pitch,
+                                           .attributeCount = count, .attributes = &attrs[first] };
+    }
+
+    const SDL_GPUColorTargetDescription *ct = i->target_info.num_color_targets ? &i->target_info.color_target_descriptions[0] : NULL;
+    WGPUBlendState blend;
+    WGPUColorTargetState color = {0};
+    WGPUFragmentState frag = {0};
+    if (ct) {
+        const SDL_GPUColorTargetBlendState *bs = &ct->blend_state;
+        blend = (WGPUBlendState){
+            .color = { .operation = blend_op(bs->color_blend_op), .srcFactor = blend_factor(bs->src_color_blendfactor),
+                       .dstFactor = blend_factor(bs->dst_color_blendfactor) },
+            .alpha = { .operation = blend_op(bs->alpha_blend_op), .srcFactor = blend_factor(bs->src_alpha_blendfactor),
+                       .dstFactor = blend_factor(bs->dst_alpha_blendfactor) },
+        };
+        color.format = tex_format(ct->format);
+        color.blend = bs->enable_blend ? &blend : NULL;
+        color.writeMask = bs->enable_color_write_mask ? (WGPUColorWriteMask)(bs->color_write_mask & 15u)
+                                                      : WGPUColorWriteMask_All;
+        frag = (WGPUFragmentState){ .module = i->fragment_shader->mod, .entryPoint = sv("main"),
+                                    .targetCount = 1, .targets = &color };
+    }
+
+    const SDL_GPUDepthStencilState *ds = &i->depth_stencil_state;
+    WGPUDepthStencilState depth = {0};
+    if (i->target_info.has_depth_stencil_target) {
+        WGPUTextureFormat df = tex_format(i->target_info.depth_stencil_format);
+        WGPUStencilFaceState front = {
+            .compare = ds->enable_stencil_test ? compare(ds->front_stencil_state.compare_op) : WGPUCompareFunction_Always,
+            .failOp = stencil_op(ds->front_stencil_state.fail_op),
+            .depthFailOp = stencil_op(ds->front_stencil_state.depth_fail_op),
+            .passOp = stencil_op(ds->front_stencil_state.pass_op) };
+        WGPUStencilFaceState back = {
+            .compare = ds->enable_stencil_test ? compare(ds->back_stencil_state.compare_op) : WGPUCompareFunction_Always,
+            .failOp = stencil_op(ds->back_stencil_state.fail_op),
+            .depthFailOp = stencil_op(ds->back_stencil_state.depth_fail_op),
+            .passOp = stencil_op(ds->back_stencil_state.pass_op) };
+        if (!ds->enable_stencil_test) {
+            front.failOp = front.depthFailOp = front.passOp = WGPUStencilOperation_Keep;
+            back = front;
+        }
+        depth = (WGPUDepthStencilState){
+            .format = df,
+            .depthWriteEnabled = ds->enable_depth_write ? WGPUOptionalBool_True : WGPUOptionalBool_False,
+            .depthCompare = ds->enable_depth_test ? compare(ds->compare_op) : WGPUCompareFunction_Always,
+            .stencilFront = front, .stencilBack = back,
+            .stencilReadMask = ds->enable_stencil_test ? ds->compare_mask : 0xFF,
+            .stencilWriteMask = ds->enable_stencil_test ? ds->write_mask : 0,
+        };
+    }
+
+    const SDL_GPURasterizerState *rs = &i->rasterizer_state;
+    WGPURenderPipelineDescriptor d = {
+        .layout = s_layout,
+        .vertex = { .module = i->vertex_shader->mod, .entryPoint = sv("main"), .bufferCount = nb, .buffers = vbl },
+        .primitive = {
+            .topology = WGPUPrimitiveTopology_TriangleList,
+            .frontFace = rs->front_face == SDL_GPU_FRONTFACE_CLOCKWISE ? WGPUFrontFace_CW : WGPUFrontFace_CCW,
+            .cullMode = rs->cull_mode == SDL_GPU_CULLMODE_FRONT ? WGPUCullMode_Front
+                      : rs->cull_mode == SDL_GPU_CULLMODE_BACK ? WGPUCullMode_Back : WGPUCullMode_None,
+            .unclippedDepth = (!rs->enable_depth_clip && s_has_depth_clip) ? 1 : 0,
+        },
+        .depthStencil = i->target_info.has_depth_stencil_target ? &depth : NULL,
+        .multisample = { .count = 1, .mask = 0xFFFFFFFFu },
+        .fragment = ct ? &frag : NULL,
+    };
+    WGPURenderPipeline pipe = wgpuDeviceCreateRenderPipeline(s_dev, &d);
+    if (!pipe) return;
+    a->out = (SDL_GPUGraphicsPipeline *)calloc(1, sizeof *a->out);
+    if (!a->out) { wgpuRenderPipelineRelease(pipe); return; }
+    a->out->pipe = pipe;
+}
+SDL_GPUGraphicsPipeline *WG_CreateGPUGraphicsPipeline(SDL_GPUDevice *d, const SDL_GPUGraphicsPipelineCreateInfo *i)
+{
+    (void)d;
+    PipeArgs a = { i, NULL };
+    if (!i->vertex_shader || !i->fragment_shader) { SDL_SetError("pipeline without shaders"); return NULL; }
+    run_sync(do_create_pipeline, &a);
+    if (!a.out) SDL_SetError("WebGPU pipeline creation failed");
+    return a.out;
+}
+
+/* Internal: one fullscreen-triangle pipeline per target format, for blits
+ * and mipmaps (server thread). */
+static WGPURenderPipeline blit_pipeline(WGPUTextureFormat f)
+{
+    static struct { WGPUTextureFormat f; WGPURenderPipeline p; } cache[4];
+    static int n;
+    for (int i = 0; i < n; i++) if (cache[i].f == f) return cache[i].p;
+    WGPUBindGroupLayoutEntry e[3] = {
+        { .binding = 0, .visibility = WGPUShaderStage_Fragment,
+          .texture = { .sampleType = WGPUTextureSampleType_Float, .viewDimension = WGPUTextureViewDimension_2D } },
+        { .binding = 1, .visibility = WGPUShaderStage_Fragment, .sampler = { .type = WGPUSamplerBindingType_Filtering } },
+        { .binding = 2, .visibility = WGPUShaderStage_Fragment, .buffer = { .type = WGPUBufferBindingType_Uniform } },
+    };
+    static WGPUBindGroupLayout bgl;
+    static WGPUPipelineLayout pl;
+    if (!bgl) {
+        bgl = make_bgl(e, 3);
+        WGPUPipelineLayoutDescriptor pd = { .bindGroupLayoutCount = 1, .bindGroupLayouts = &bgl };
+        pl = wgpuDeviceCreatePipelineLayout(s_dev, &pd);
+    }
+    WGPUColorTargetState ct = { .format = f, .writeMask = WGPUColorWriteMask_All };
+    WGPUFragmentState fs = { .module = s_blit_module, .entryPoint = sv("fs"), .targetCount = 1, .targets = &ct };
+    WGPURenderPipelineDescriptor d = {
+        .layout = pl, .vertex = { .module = s_blit_module, .entryPoint = sv("vs") },
+        .primitive = { .topology = WGPUPrimitiveTopology_TriangleList, .cullMode = WGPUCullMode_None },
+        .multisample = { .count = 1, .mask = 0xFFFFFFFFu }, .fragment = &fs,
+    };
+    WGPURenderPipeline p = wgpuDeviceCreateRenderPipeline(s_dev, &d);
+    if (n < 4) { cache[n].f = f; cache[n].p = p; n++; }
+    return p;
+}
