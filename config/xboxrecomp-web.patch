+    @location(3) @interpolate(flat) at0: vec4f,
+    @location(4) @interpolate(flat) at1: vec4f,
+    @location(5) @interpolate(flat) at2: vec4f,
+    @location(6) @interpolate(flat) at3: vec4f,
+    @location(7) @interpolate(flat) bp: vec4f,
+    @location(8) @interpolate(flat) bc: vec4f,
+    @location(9) @interpolate(flat) bspec: vec4f,
+    @location(10) @interpolate(flat) bt0: vec4f,
+    @location(11) @interpolate(flat) bt1: vec4f,
+    @location(12) @interpolate(flat) bt2: vec4f,
+    @location(13) @interpolate(flat) bt3: vec4f,
+    @location(14) @interpolate(flat) fog: vec2f,
+}
+fn line_lerp(a: VpOutputs,b: VpOutputs,t:f32)->VpOutputs {
+    return VpOutputs(a.position+(b.position-a.position)*t,
+        a.color+(b.color-a.color)*t,a.specular+(b.specular-a.specular)*t,
+        a.t0+(b.t0-a.t0)*t,a.t1+(b.t1-a.t1)*t,a.t2+(b.t2-a.t2)*t,a.t3+(b.t3-a.t3)*t,
+        a.fog+(b.fog-a.fog)*t,a.w+(b.w-a.w)*t);
