index 0000000..efd7b84
--- /dev/null
+++ b/src/apu/apu_gp_ep.c
@@ -0,0 +1,409 @@
+/*
+ * QEMU MCPX Audio Processing Unit implementation
+ *
+ * Copyright (c) 2012 espes
+ * Copyright (c) 2018-2019 Jannik Vogel
+ * Copyright (c) 2019-2025 Matt Borgerson
+ *
