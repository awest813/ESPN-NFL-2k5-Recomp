+#ifndef SDL_GPU_WEBGPU_H
+#define SDL_GPU_WEBGPU_H
+/* The SDL GPU renderer on WebGPU (Emscripten builds).
+ *
+ * SDL 3 has no WebGPU backend for its GPU API, so the subset of that API the
+ * renderer in src/kernel/sdlgpu/ uses -- 46 functions, SDL's own types -- is
+ * implemented here on Dawn's webgpu.h (emdawnwebgpu), and this header
+ * redirects the renderer's SDL_*GPU* calls to it. The renderer itself is
+ * unchanged apart from loading WGSL shaders (webgpu/sg_wgsl.h, generated
+ * from its GLSL by tools/gen-wgsl.py).
+ *
+ * Threads. A WebGPU device and everything made from it belong to the
+ * JavaScript context that created them, and a device only makes progress
+ * (mapAsync, adapter requests, presenting) when that context returns to its
+ * event loop -- which the renderer's threads never do. So one thread, the
+ * GPU server, owns the device and sits in its event loop; every call below,
+ * from any thread, runs there through Emscripten's proxying queue. Command
+ * buffers are recorded on the caller's side and replayed into a
+ * GPUCommandEncoder on submit. Submits are synchronous (they copy upload data
+ * into WebGPU before returning) and wait for any downloads in them. The
+ * renderer calls from two threads -- the pushbuffer executor and the window
+ * presenter -- which this makes safe.
+ *
+ * Presenting. The server thread receives the page's <canvas id="gpucanvas">
+ * (an OffscreenCanvas, transferred to the program's main thread at startup by
+ * -sOFFSCREENCANVASES_TO_PTHREAD and on to the server when it is created), so
+ * wg_server_start() must run on the main thread. A frame is shown when the
+ * server returns to its event loop after the submit that drew it. Acquiring a
+ * swapchain texture waits for the next animation frame, which paces the
+ * presenter as vsync does natively. */
+#ifdef __EMSCRIPTEN__
+#include <SDL3/SDL.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Start the GPU server and create the WebGPU device; `canvas_id` is the id of
+ * the transferred presentation canvas (no '#'). Call once, on the main
+ * thread. Returns 0 when the browser has no usable WebGPU; the renderer then
+ * finds no device and draws in software. */
+int wg_server_start(const char *canvas_id);
+/* 1 once wg_server_start() succeeded. */
+int wg_available(void);
+
+/* SDL_GPU_SHADERFORMAT_PRIVATE carries WGSL source here: the shader format
+ * enum has no WGSL value in SDL 3.2. */
+#define SDL_GPU_SHADERFORMAT_WGSL SDL_GPU_SHADERFORMAT_PRIVATE
+
+#define WG_API(ret, name, args) ret WG_##name args;
+WG_API(SDL_GPUDevice *, CreateGPUDevice, (SDL_GPUShaderFormat formats, bool debug, const char *name))
+WG_API(void, DestroyGPUDevice, (SDL_GPUDevice *d))
+WG_API(const char *, GetGPUDeviceDriver, (SDL_GPUDevice *d))
+WG_API(bool, GPUTextureSupportsFormat, (SDL_GPUDevice *d, SDL_GPUTextureFormat f, SDL_GPUTextureType t, SDL_GPUTextureUsageFlags u))
+WG_API(SDL_GPUTexture *, CreateGPUTexture, (SDL_GPUDevice *d, const SDL_GPUTextureCreateInfo *i))
+WG_API(void, ReleaseGPUTexture, (SDL_GPUDevice *d, SDL_GPUTexture *t))
+WG_API(SDL_GPUBuffer *, CreateGPUBuffer, (SDL_GPUDevice *d, const SDL_GPUBufferCreateInfo *i))
+WG_API(void, ReleaseGPUBuffer, (SDL_GPUDevice *d, SDL_GPUBuffer *b))
+WG_API(SDL_GPUTransferBuffer *, CreateGPUTransferBuffer, (SDL_GPUDevice *d, const SDL_GPUTransferBufferCreateInfo *i))
+WG_API(void, ReleaseGPUTransferBuffer, (SDL_GPUDevice *d, SDL_GPUTransferBuffer *b))
+WG_API(void *, MapGPUTransferBuffer, (SDL_GPUDevice *d, SDL_GPUTransferBuffer *b, bool cycle))
+WG_API(void, UnmapGPUTransferBuffer, (SDL_GPUDevice *d, SDL_GPUTransferBuffer *b))
+WG_API(SDL_GPUSampler *, CreateGPUSampler, (SDL_GPUDevice *d, const SDL_GPUSamplerCreateInfo *i))
+WG_API(SDL_GPUShader *, CreateGPUShader, (SDL_GPUDevice *d, const SDL_GPUShaderCreateInfo *i))
+WG_API(SDL_GPUGraphicsPipeline *, CreateGPUGraphicsPipeline, (SDL_GPUDevice *d, const SDL_GPUGraphicsPipelineCreateInfo *i))
+WG_API(SDL_GPUCommandBuffer *, AcquireGPUCommandBuffer, (SDL_GPUDevice *d))
+WG_API(bool, SubmitGPUCommandBuffer, (SDL_GPUCommandBuffer *c))
+WG_API(SDL_GPUFence *, SubmitGPUCommandBufferAndAcquireFence, (SDL_GPUCommandBuffer *c))
+WG_API(bool, CancelGPUCommandBuffer, (SDL_GPUCommandBuffer *c))
+WG_API(bool, WaitForGPUFences, (SDL_GPUDevice *d, bool all, SDL_GPUFence *const *f, Uint32 n))
+WG_API(void, ReleaseGPUFence, (SDL_GPUDevice *d, SDL_GPUFence *f))
+WG_API(SDL_GPUCopyPass *, BeginGPUCopyPass, (SDL_GPUCommandBuffer *c))
+WG_API(void, EndGPUCopyPass, (SDL_GPUCopyPass *p))
+WG_API(void, UploadToGPUBuffer, (SDL_GPUCopyPass *p, const SDL_GPUTransferBufferLocation *s, const SDL_GPUBufferRegion *d, bool cycle))
+WG_API(void, UploadToGPUTexture, (SDL_GPUCopyPass *p, const SDL_GPUTextureTransferInfo *s, const SDL_GPUTextureRegion *d, bool cycle))
+WG_API(void, DownloadFromGPUTexture, (SDL_GPUCopyPass *p, const SDL_GPUTextureRegion *s, const SDL_GPUTextureTransferInfo *d))
+WG_API(void, CopyGPUTextureToTexture, (SDL_GPUCopyPass *p, const SDL_GPUTextureLocation *s, const SDL_GPUTextureLocation *d, Uint32 w, Uint32 h, Uint32 depth, bool cycle))
+WG_API(void, GenerateMipmapsForGPUTexture, (SDL_GPUCommandBuffer *c, SDL_GPUTexture *t))
+WG_API(void, BlitGPUTexture, (SDL_GPUCommandBuffer *c, const SDL_GPUBlitInfo *i))
+WG_API(SDL_GPURenderPass *, BeginGPURenderPass, (SDL_GPUCommandBuffer *c, const SDL_GPUColorTargetInfo *ct, Uint32 n, const SDL_GPUDepthStencilTargetInfo *ds))
+WG_API(void, EndGPURenderPass, (SDL_GPURenderPass *p))
+WG_API(void, SetGPUViewport, (SDL_GPURenderPass *p, const SDL_GPUViewport *v))
+WG_API(void, SetGPUScissor, (SDL_GPURenderPass *p, const SDL_Rect *r))
+WG_API(void, SetGPUBlendConstants, (SDL_GPURenderPass *p, SDL_FColor c))
+WG_API(void, SetGPUStencilReference, (SDL_GPURenderPass *p, Uint8 r))
+WG_API(void, BindGPUGraphicsPipeline, (SDL_GPURenderPass *p, SDL_GPUGraphicsPipeline *g))
+WG_API(void, BindGPUVertexBuffers, (SDL_GPURenderPass *p, Uint32 first, const SDL_GPUBufferBinding *b, Uint32 n))
+WG_API(void, BindGPUIndexBuffer, (SDL_GPURenderPass *p, const SDL_GPUBufferBinding *b, SDL_GPUIndexElementSize s))
+WG_API(void, BindGPUFragmentSamplers, (SDL_GPURenderPass *p, Uint32 first, const SDL_GPUTextureSamplerBinding *b, Uint32 n))
+WG_API(void, PushGPUVertexUniformData, (SDL_GPUCommandBuffer *c, Uint32 slot, const void *data, Uint32 len))
+WG_API(void, PushGPUFragmentUniformData, (SDL_GPUCommandBuffer *c, Uint32 slot, const void *data, Uint32 len))
+WG_API(void, DrawGPUPrimitives, (SDL_GPURenderPass *p, Uint32 n, Uint32 inst, Uint32 first_v, Uint32 first_i))
+WG_API(void, DrawGPUIndexedPrimitives, (SDL_GPURenderPass *p, Uint32 n, Uint32 inst, Uint32 first_idx, Sint32 voff, Uint32 first_i))
+WG_API(bool, ClaimWindowForGPUDevice, (SDL_GPUDevice *d, SDL_Window *w))
+WG_API(void, ReleaseWindowFromGPUDevice, (SDL_GPUDevice *d, SDL_Window *w))
+WG_API(bool, WaitAndAcquireGPUSwapchainTexture, (SDL_GPUCommandBuffer *c, SDL_Window *w, SDL_GPUTexture **t, Uint32 *tw, Uint32 *th))
+#undef WG_API
+
+#ifdef __cplusplus
+}
+#endif
+
+/* The renderer's calls, redirected. */
+#ifndef SDL_GPU_WEBGPU_IMPLEMENTATION
+#define SDL_CreateGPUDevice WG_CreateGPUDevice
+#define SDL_DestroyGPUDevice WG_DestroyGPUDevice
+#define SDL_GetGPUDeviceDriver WG_GetGPUDeviceDriver
+#define SDL_GPUTextureSupportsFormat WG_GPUTextureSupportsFormat
+#define SDL_CreateGPUTexture WG_CreateGPUTexture
+#define SDL_ReleaseGPUTexture WG_ReleaseGPUTexture
+#define SDL_CreateGPUBuffer WG_CreateGPUBuffer
+#define SDL_ReleaseGPUBuffer WG_ReleaseGPUBuffer
+#define SDL_CreateGPUTransferBuffer WG_CreateGPUTransferBuffer
+#define SDL_ReleaseGPUTransferBuffer WG_ReleaseGPUTransferBuffer
+#define SDL_MapGPUTransferBuffer WG_MapGPUTransferBuffer
+#define SDL_UnmapGPUTransferBuffer WG_UnmapGPUTransferBuffer
+#define SDL_CreateGPUSampler WG_CreateGPUSampler
+#define SDL_CreateGPUShader WG_CreateGPUShader
+#define SDL_CreateGPUGraphicsPipeline WG_CreateGPUGraphicsPipeline
+#define SDL_AcquireGPUCommandBuffer WG_AcquireGPUCommandBuffer
+#define SDL_SubmitGPUCommandBuffer WG_SubmitGPUCommandBuffer
+#define SDL_SubmitGPUCommandBufferAndAcquireFence WG_SubmitGPUCommandBufferAndAcquireFence
+#define SDL_CancelGPUCommandBuffer WG_CancelGPUCommandBuffer
+#define SDL_WaitForGPUFences WG_WaitForGPUFences
+#define SDL_ReleaseGPUFence WG_ReleaseGPUFence
+#define SDL_BeginGPUCopyPass WG_BeginGPUCopyPass
+#define SDL_EndGPUCopyPass WG_EndGPUCopyPass
+#define SDL_UploadToGPUBuffer WG_UploadToGPUBuffer
+#define SDL_UploadToGPUTexture WG_UploadToGPUTexture
+#define SDL_DownloadFromGPUTexture WG_DownloadFromGPUTexture
+#define SDL_CopyGPUTextureToTexture WG_CopyGPUTextureToTexture
+#define SDL_GenerateMipmapsForGPUTexture WG_GenerateMipmapsForGPUTexture
+#define SDL_BlitGPUTexture WG_BlitGPUTexture
+#define SDL_BeginGPURenderPass WG_BeginGPURenderPass
+#define SDL_EndGPURenderPass WG_EndGPURenderPass
+#define SDL_SetGPUViewport WG_SetGPUViewport
+#define SDL_SetGPUScissor WG_SetGPUScissor
+#define SDL_SetGPUBlendConstants WG_SetGPUBlendConstants
+#define SDL_SetGPUStencilReference WG_SetGPUStencilReference
+#define SDL_BindGPUGraphicsPipeline WG_BindGPUGraphicsPipeline
+#define SDL_BindGPUVertexBuffers WG_BindGPUVertexBuffers
+#define SDL_BindGPUIndexBuffer WG_BindGPUIndexBuffer
+#define SDL_BindGPUFragmentSamplers WG_BindGPUFragmentSamplers
+#define SDL_PushGPUVertexUniformData WG_PushGPUVertexUniformData
+#define SDL_PushGPUFragmentUniformData WG_PushGPUFragmentUniformData
+#define SDL_DrawGPUPrimitives WG_DrawGPUPrimitives
+#define SDL_DrawGPUIndexedPrimitives WG_DrawGPUIndexedPrimitives
+#define SDL_ClaimWindowForGPUDevice WG_ClaimWindowForGPUDevice
+#define SDL_ReleaseWindowFromGPUDevice WG_ReleaseWindowFromGPUDevice
+#define SDL_WaitAndAcquireGPUSwapchainTexture WG_WaitAndAcquireGPUSwapchainTexture
+#endif
+#endif /* __EMSCRIPTEN__ */
+#endif
