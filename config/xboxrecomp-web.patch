+        draw(&d);
+        download(color, 0, W, H, img);
+        CHECK(px(img, 1, 1) == 0xFF00FF00u, "XRGB surface samples force alpha to one");
+        SDL_GPUTexture *snapshot = make_tex(SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM,
