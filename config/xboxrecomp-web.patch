+    }
+    quad(v, 0, 0, 64, 64, 0, 0, 16, 16, 0xFFFFFFFFu, 1);   /* 4 px per texel, wraps twice */
+    d = (Draw){ .color = color, .depth = depth, .tex = checker, .pipe = opaque, .v = v, .n = 6,
+                .shade = { {8, 8}, {1, 1}, 0, 0, 0, 0 }, .clear_color = 1, .clear_argb = 0xFF000000u,
+                .clear_depth = 1, .depth_value = 1.0f };
+    draw(&d);
+    download(color, 0, W, H, img);
+    CHECK(px(img, 1, 1) == 0xFF1080F0u && px(img, 5, 1) == 0xFFE03010u && px(img, 33, 1) == 0xFF1080F0u,
