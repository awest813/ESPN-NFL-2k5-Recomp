+/* Pace completed game frames, not just repeated scanout of the last texture.
+ * Keep an absolute fractional deadline and never catch up in a burst after
+ * a slow frame. Release the guest lock while waiting so audio/input run. */
+static void sg_frame_pace(void)
+{
+#ifdef __EMSCRIPTEN__
+    static uint64_t deadline;
+    static int previous_limit;
+    int limit = xbox_VideoFpsLimit();
+    uint64_t now = SDL_GetTicksNS();
+    if (limit != 30) { deadline = 0; previous_limit = limit; return; }
+    const uint64_t period = 1000000000ull / 30u;
+    if (previous_limit != limit || !deadline) deadline = now;
+    previous_limit = limit;
+    if (now < deadline) {
+        int depth = xbox_ggl_release_all();
+        SDL_DelayNS(deadline - now);
+        xbox_ggl_reacquire(depth);
+        now = SDL_GetTicksNS();
+    }
+    if (now > deadline + period) deadline = now;
+    deadline += period;
+#endif
+}

